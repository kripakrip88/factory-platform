[mysqld]
# Как на старом сервере: utf8mb3, московское время; sql_mode пустой — Битрикс (и after_connect.php) так хочет
character-set-server = utf8mb3
collation-server = utf8mb3_unicode_ci
default-time-zone = '+03:00'
sql_mode = ''
innodb_buffer_pool_size = 512M
innodb_log_file_size = 128M
max_connections = 100
disable_log_bin
skip-name-resolve
