# Скопировать в .env (он в .gitignore) и заполнить НА СЕРВЕРЕ.
# Антон заполняет сам. Claude Code значения не хардкодит и не логирует.

# IMAP-доступ к ящику (только чтение)
IMAP_HOST=imap.mail.ru
IMAP_PORT=993
IMAP_USER=pmkpark@mail.ru
# Пароль ПРИЛОЖЕНИЯ mail.ru (НЕ основной пароль от почты).
# Как получить: mail.ru → Настройки → Безопасность → Пароли для внешних
# приложений → создать → выбрать «Почта». Вставить сюда.
IMAP_PASSWORD=

# Окно анализа — сколько последних писем во Входящих брать
WINDOW=400

# Anthropic API — для классификации (Блок 2) и проверки извлечения (Блок 4).
# ВНИМАНИЕ: содержимое писем при этом уходит в API Anthropic. Это осознанный
# выбор из ТЗ (анализ силами Claude). Тела в отчёт/файлы НЕ пишутся.
ANTHROPIC_API_KEY=
# Модель для классификации (дешёвая, быстрая); можно переопределить
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
