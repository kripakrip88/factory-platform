# Carbon — конфигурация self-host стека. Заполняется install.sh (@@...@@ → значения).
# Секретов здесь НЕТ: они лежат в Docker Swarm secrets (11 штук, создаёт deploy.sh init).
#
# Файл кладётся в <src>/contrib/deploying/simple-docker-caddy/.env — их deploy.sh
# читает его именно оттуда.

CARBON_REPO=@@CARBON_REPO@@
STACK_NAME=carbon
DOMAIN=erppark.ru

# ─── Хосты для Caddy ────────────────────────────────────────────────────────
# ПРЕФИКС http:// ОБЯЗАТЕЛЕН и это не опечатка: так Caddy не включает свой ACME
# и не пытается занять :443. TLS у нас терминирует infra-nginx, который держит
# 80/443 для erppark.ru и остальных. Caddy получает HTTP на 8083 и разводит
# запросы по заголовку Host.
ERP_HOST=http://carbon.erppark.ru
MES_HOST=http://mes.erppark.ru
SUPABASE_HOST=http://api.erppark.ru
# Studio (админка БД) не публикуется: у неё нет своей аутентификации.
# База доступна через ssh + docker exec psql.
STUDIO_HOST=

# ─── URL, которые видит браузер ─────────────────────────────────────────────
# Здесь именно https:// — это адреса для клиента и редиректов, их отдаёт nginx.
ERP_URL=https://carbon.erppark.ru
MES_URL=https://mes.erppark.ru
SUPABASE_URL=https://api.erppark.ru

# Не используется: ACME у Caddy выключен (см. префиксы http:// выше).
# Сертификаты выпускает наш certbot из infra-стека.
ACME_EMAIL=admin@erppark.ru

CARBON_EDITION=community
RESEND_DOMAIN=erppark.ru

# ─── Образы: собираются в GitHub Actions, сюда приходят готовыми ────────────
# CARBON_REGISTRY непустой → их deploy.sh пропускает локальную сборку и
# деплоит с --resolve-image always. Сборка на этом VPS запрещена: их Dockerfile
# просит 8 ГБ heap, рядом боевой ERPNext.
CARBON_REGISTRY=ghcr.io
CARBON_IMAGE_ERP=@@IMG_ERP@@
CARBON_IMAGE_MES=@@IMG_MES@@
# Наша добавка (у них такой переменной нет): образ стадии `ops` для миграций и
# seed. Стадия runner вырезает supabase CLI, поэтому их migrate из carbon-erp
# работать не может.
CARBON_IMAGE_OPS=@@IMG_OPS@@

# Наша добавка: порт, на котором Caddy слушает HTTP (см. patch-compose.py).
CADDY_HTTP_PORT=@@CADDY_HTTP_PORT@@

# ─── Почта (GoTrue: инвайты, magic links) ───────────────────────────────────
# Пока пусто — стенд оценочный, почта не нужна. Пароль SMTP всё равно был бы
# секретом Swarm, а не здесь. Первого пользователя заводим напрямую в БД.
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=
GOTRUE_SMTP_ADMIN_EMAIL=admin@erppark.ru
GOTRUE_SMTP_SENDER_NAME=Carbon
# Регистрация закрыта: стенд смотрит наружу, самозапись не нужна.
GOTRUE_DISABLE_SIGNUP=true

# Только email: google/azure требуют OAuth-креды, для оценки это лишнее.
AUTH_PROVIDERS=email
GOOGLE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_REDIRECT_URI=
AZURE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_REDIRECT_URI=

# ─── Postgres ───────────────────────────────────────────────────────────────
# Урезано против их дефолтов (2048M / 512MB / 1536MB): на машине 11 ГБ и рядом
# боевой ERPNext со своей MariaDB. Это оценочный стенд, не нагруженный прод.
STUDIO_REPLICAS=1
PG_MEMORY_LIMIT=1536M
PG_MAX_CONNECTIONS=60
PG_SHARED_BUFFERS=384MB
PG_EFFECTIVE_CACHE_SIZE=1152MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=96MB

REALTIME_SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
EDGE_VERIFY_JWT=false
SAML_ENABLED=false
SAML_PRIVATE_KEY=
