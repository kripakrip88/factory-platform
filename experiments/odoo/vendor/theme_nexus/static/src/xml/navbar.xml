<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Replace the default "Apps" dropdown button with a sidebar toggle -->
    <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//t[@t-else='']/div" position="replace">
            <div t-if="!isScopedApp" class="o_navbar_apps_menu">
                <button class="o_navbar_sidebar_toggle border-0"
                        data-hotkey="h"
                        title="Toggle applications sidebar"
                        t-on-click.prevent="toggleSidebar">
                    <i class="oi oi-apps fs-5"/>
                </button>
            </div>
        </xpath>
    </t>

    <!-- Inject the NEXUS application sidebar after the main navbar -->
    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//nav" position="after">
            <t t-portal="'body'">
                <div t-if="sidebarState.isOpen &amp;&amp; !isWideScreen()"
                     class="o_nexus_sidebar_overlay"
                     t-on-click="closeSidebar"/>

                <div class="o_apps_sidebar"
                     t-att-class="{ 'o_sidebar_open': sidebarState.isOpen }"
                     t-on-click.stop="">

                    <div class="o_nexus_sidebar_header">
                        <div class="o_nexus_brand">
                            <div class="o_nexus_mark"/>
                            <span>NEXUS</span>
                        </div>
                        <i class="oi oi-close o_sidebar_close" t-on-click="closeSidebar"/>
                    </div>

                    <div class="o_nexus_sidebar_content">
                        <div t-foreach="menuService.getApps()" t-as="app" t-key="app.id"
                             class="o_nexus_sidebar_item"
                             t-att-class="{ 'o_nexus_active': menuService.getCurrentApp() &amp;&amp; menuService.getCurrentApp().id === app.id }"
                             t-on-click="() => this.onNavBarAppClick(app)">
                            <div class="o_nexus_icon_wrap">
                                <img t-if="app.webIconData" t-att-src="app.webIconData" class="o_nexus_icon"/>
                                <i t-else="" class="fa fa-th-large"/>
                            </div>
                            <span class="o_nexus_app_name" t-esc="app.name"/>
                        </div>
                    </div>

                    <div class="o_nexus_sidebar_footer">
                        <div class="o_nexus_dark_toggle" t-on-click="toggleNexusDarkMode">
                            <span class="o_nexus_dark_label">Dark Mode</span>
                            <div class="o_nexus_switch" t-att-class="{ 'o_nexus_switch_on': nexusDarkState.isDark }"/>
                        </div>
                        <span>NEXUS Backend Theme</span>
                    </div>
                </div>
            </t>
        </xpath>
    </t>

</templates>
