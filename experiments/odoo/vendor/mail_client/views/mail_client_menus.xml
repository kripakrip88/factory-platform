<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_client_inbox_action" model="ir.actions.client">
        <field name="name">Inbox</field>
        <field name="tag">mail_client.inbox</field>
    </record>

    <!-- web_icon is what the app drawer renders. Without it the module shows a
         blank tile: static/description/icon.png alone only feeds the Apps list,
         which is a separate mechanism. ir.ui.menu recomputes web_icon_data from
         this path on write, so the icon appears on the next module upgrade. -->
    <menuitem id="menu_mail_client_root"
              name="Mail"
              web_icon="mail_client,static/description/icon.png"
              sequence="35"
              groups="group_mail_client_user"/>

    <menuitem id="menu_mail_client_inbox"
              name="Inbox"
              parent="menu_mail_client_root"
              action="mail_client_inbox_action"
              sequence="10"/>

    <menuitem id="menu_mail_client_configuration"
              name="Configuration"
              parent="menu_mail_client_root"
              sequence="90"
              groups="group_mail_client_admin"/>

    <menuitem id="menu_mail_client_servers"
              name="Mail Servers"
              parent="menu_mail_client_configuration"
              action="mail_client_server_action"
              sequence="10"
              groups="base.group_system"/>

    <menuitem id="menu_mail_client_accounts"
              name="Mail Accounts"
              parent="menu_mail_client_configuration"
              action="mail_client_account_action"
              sequence="20"/>

    <menuitem id="menu_mail_client_sync_ops"
              name="Pending Operations"
              parent="menu_mail_client_configuration"
              action="mail_client_sync_op_action"
              sequence="25"/>

    <menuitem id="menu_mail_client_audit"
              name="Access Log"
              parent="menu_mail_client_configuration"
              action="mail_client_audit_action"
              sequence="30"/>

</odoo>
