<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_client_audit_view_list" model="ir.ui.view">
        <field name="name">mail.client.audit.list</field>
        <field name="model">mail.client.audit</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date" string="When"/>
                <field name="user_id"/>
                <field name="account_email" string="Mailbox"/>
                <field name="action"/>
                <field name="auth_mode"/>
                <field name="server_id" optional="hide"/>
                <field name="detail" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="mail_client_audit_view_search" model="ir.ui.view">
        <field name="name">mail.client.audit.search</field>
        <field name="model">mail.client.audit</field>
        <field name="arch" type="xml">
            <search>
                <field name="account_email"/>
                <field name="user_id"/>
                <filter name="filter_master" string="Master User Access"
                        domain="[('auth_mode', '=', 'master')]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_mailbox" string="Mailbox" context="{'group_by': 'account_email'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mail_client_audit_action" model="ir.actions.act_window">
        <field name="name">Access Log</field>
        <field name="res_model">mail.client.audit</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="mail_client_audit_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No mailbox access recorded yet</p>
            <p>
                Every connection made with the Dovecot master user is logged here.
                Entries cannot be edited or deleted from the interface.
            </p>
        </field>
    </record>

</odoo>
