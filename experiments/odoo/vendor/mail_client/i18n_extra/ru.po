#. module: mail_client
#. odoo-python
#: code:addons/mail_client/models/mail_client_access.py:0
msgid "%s already owns this mailbox and does not need an access entry."
msgstr "%s уже владеет этим почтовым ящиком, отдельная запись доступа не нужна."

#. module: mail_client
#. odoo-javascript
#: code:addons/mail_client/static/src/mail_client_action.js:0
