<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_mail_client_sync" model="ir.cron">
        <field name="name">Mail Client: Synchronise Mailboxes</field>
        <field name="model_id" ref="model_mail_client_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_all()</field>
        <!-- ПРАВКА ПМК (29.09.2026): было 2. Первая загрузка ящика
             pmkpark@mail.ru 27.09 (2 тыс. писем) шла 153 с и налезала на
             другой запуск синхронизации: «could not serialize access due to
             concurrent update», ящик вставал в error. Крон сам с собой не
             пересекается (поток один), но кнопка «Синхронизировать» запускает
             тот же проход в веб-процессе. Обычный проход — 2-3 с (замер 29.09),
             так что частить можно, но только вместе с защитой от наложения —
             это шаг 22 плана. До него держим 10. noupdate здесь нет, поэтому
             значение закреплено и в pmk_mail_ui/data/ir_cron.xml. -->
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Catch-up pass for mail stored before its MIME structure was read.
         Runs on its own schedule so it never delays the sync above; it settles
         a bounded number of messages per folder and stops once none are left. -->
    <record id="ir_cron_mail_client_structure_backfill" model="ir.cron">
        <field name="name">Mail Client: Describe Older Messages</field>
        <field name="model_id" ref="model_mail_client_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_backfill_structures()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_mail_client_sync_op_gc" model="ir.cron">
        <field name="name">Mail Client: Trim Completed Operations</field>
        <field name="model_id" ref="model_mail_client_sync_op"/>
        <field name="state">code</field>
        <field name="code">model._cron_gc_done()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_mail_client_draft_gc" model="ir.cron">
        <field name="name">Mail Client: Remove Empty Drafts</field>
        <field name="model_id" ref="model_mail_client_compose"/>
        <field name="state">code</field>
        <field name="code">model._cron_gc_empty_drafts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_mail_client_audit_gc" model="ir.cron">
        <field name="name">Mail Client: Trim Access Log</field>
        <field name="model_id" ref="model_mail_client_audit"/>
        <field name="state">code</field>
        <field name="code">model._cron_gc_audit()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
