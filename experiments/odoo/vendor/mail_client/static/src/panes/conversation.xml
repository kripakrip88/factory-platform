<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mail_client.Conversation">
        <div class="o_mail_client_conv" t-ref="conversation">
            <article t-foreach="items" t-as="item" t-key="item.id"
                     class="o_mail_client_conv_card"
                     t-att-class="{'is-ours': item.is_outgoing}"
                     t-att-data-message-id="item.id">
                <t t-set="card" t-value="cardDetail(item)"/>
                <MessageCard t-if="card"
                             detail="card"
                             getScroller="props.getScroller"
                             inConversation="true"
                             ours="!!item.is_outgoing"
                             canReply="!item.is_outgoing"
                             onReply="item.id === props.detail.id ? undefined : ((mode) => props.onReply(mode, item.id))"
                             onAllowImages="() => this.allowImages(item)"
                             onDownloadAttachment="props.onDownloadAttachment"/>
                <t t-else="">
                    <div class="o_mail_client_reading_header px-4 py-2">
                        <div class="o_mail_client_from d-flex align-items-baseline gap-2 small">
                            <strong class="o_mail_client_from_text text-truncate"
                                    t-esc="senderName(item.email_from)"/>
                            <span class="o_mail_client_ours badge rounded-pill flex-shrink-0"
                                  t-if="item.is_outgoing" t-att-title="oursTitle">we</span>
                            <span class="text-muted ms-auto flex-shrink-0" t-esc="formatDate(item.date)"/>
                        </div>
                    </div>
                    <div class="o_mail_client_conv_state px-4 pb-3 small text-muted">
                        <p t-if="item.preview" class="mb-1" t-esc="item.preview"/>
                        <span t-if="item.body_unavailable">The message body was not saved in this copy.</span>
                        <t t-elif="state.failed[item.id]">
                            <span>This message could not be opened.</span>
                            <button type="button" class="btn btn-link btn-sm p-0 ms-2 align-baseline"
                                    t-on-click="() => this.retry(item.id)">Retry</button>
                        </t>
                        <t t-else="">
                            <i t-if="state.loading[item.id]" class="fa fa-circle-o-notch fa-spin me-1" aria-hidden="true"/>
                            <span>Fetching message…</span>
                        </t>
                    </div>
                </t>
            </article>
        </div>
    </t>

</templates>
