<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ПРАВКА ПМК (шаг 18 плана, «Почта как в Mail.ru», 30.09.2026): список
         как в Mail.ru. Два вида (удобный — две строки, компактный — одна);
         непрочитанное — жирным и синей точкой; галочка — на месте точки, видна
         при наведении или когда что-то уже выбрано; у нашего письма «Кому: …»;
         число писем переписки серым; плашки «ждёт ответа / ждём клиента»;
         группы «Сегодня / Вчера / Раньше»; рассылки одной строкой (крючок
         сервера _list_digests). Меню «Переместить» — штатное меню Odoo:
         самодельное не закрывалось ни щелчком мимо, ни клавишей Esc. -->
    <t t-name="mail_client.MessageList">
        <t t-set="listItems" t-value="items"/>
        <div class="o_mail_client_list d-flex flex-column flex-shrink-0"
             t-att-class="{ o_compact: isCompact, o_has_selection: props.selectedIds.length }">
            <div class="o_mail_client_list_header d-flex align-items-center gap-2 px-3 py-2">
                <input type="checkbox" class="form-check-input mt-0 o_mail_client_tick"
                       t-att-checked="allTicked"
                       t-att-indeterminate="someTicked"
                       t-on-change="() => props.onToggleAll()"
                       title="Select all"/>
                <span class="fw-bold text-truncate flex-grow-1" t-if="!props.selectedIds.length">
                    <t t-esc="props.folderName"/>
                </span>
                <span class="fw-bold flex-grow-1" t-else="">
                    <t t-esc="props.selectedIds.length"/> selected
                </span>
                <!-- Ниже xl компактный вид не помещается и сам становится
                     удобным (mail_client.scss), поэтому и переключателя нет. -->
                <div class="o_mail_client_view_switch btn-group btn-group-sm flex-shrink-0 d-none d-xl-inline-flex"
                     role="group">
                    <button class="btn btn-light" title="Comfortable view" aria-label="Comfortable view"
                            t-att-class="{ active: !isCompact }"
                            t-att-aria-pressed="isCompact ? 'false' : 'true'"
                            t-on-click="() => this.setView('comfortable')">
                        <i class="fa fa-th-list" aria-hidden="true"/>
                    </button>
                    <button class="btn btn-light" title="Compact view" aria-label="Compact view"
                            t-att-class="{ active: isCompact }"
                            t-att-aria-pressed="isCompact ? 'true' : 'false'"
                            t-on-click="() => this.setView('compact')">
                        <i class="fa fa-bars" aria-hidden="true"/>
                    </button>
                </div>
            </div>

            <div class="o_mail_client_bulkbar d-flex align-items-center gap-1 px-2 py-1"
                 t-if="props.selectedIds.length">
                <button class="btn btn-sm btn-light" t-att-disabled="props.busy"
                        t-att-title="bulkSeenTitle"
                        t-on-click="() => props.onBulkSeen(anyUnread)">
                    <i class="fa" t-att-class="anyUnread ? 'fa-envelope-open-o' : 'fa-envelope'"/>
                </button>
                <button class="btn btn-sm btn-light" title="Star" t-att-disabled="props.busy"
                        t-on-click="() => props.onBulkFlagged(true)">
                    <i class="fa fa-star-o"/>
                </button>
                <button class="btn btn-sm btn-light" title="Remove star" t-att-disabled="props.busy"
                        t-on-click="() => props.onBulkFlagged(false)">
                    <i class="fa fa-star-half-o"/>
                </button>
                <!-- Hidden on a read-only mailbox: the server refuses both, so
                     offering them would only produce an error dialog. -->
                <Dropdown t-if="props.canAct" menuClass="'o_mail_client_move_menu'"
                          disabled="!!props.busy">
                    <button class="btn btn-sm btn-light" title="Move to folder"
                            t-att-disabled="props.busy">
                        <i class="fa fa-folder-open-o"/>
                    </button>
                    <t t-set-slot="content">
                        <DropdownItem t-foreach="props.moveTargets or []" t-as="folder"
                                      t-key="folder.id"
                                      onSelected="() => this.onMoveTo(folder.id)">
                            <t t-esc="folder.name"/>
                        </DropdownItem>
                    </t>
                </Dropdown>
                <button class="btn btn-sm btn-light text-danger" title="Delete"
                        t-if="props.canAct"
                        t-att-disabled="props.busy"
                        t-on-click="() => props.onBulkDelete()">
                    <i class="fa fa-trash-o"/>
                </button>
                <i class="fa fa-circle-o-notch fa-spin text-muted ms-1" t-if="props.busy"/>
            </div>

            <div class="flex-grow-1 overflow-auto">
                <t t-if="props.loading and !listItems.length">
                    <div class="text-center text-muted p-4">
                        <i class="fa fa-circle-o-notch fa-spin fa-2x"/>
                    </div>
                </t>
                <t t-elif="!listItems.length">
                    <div class="text-center text-muted p-4 small">
                        <t t-if="props.filterLabel">
                            <!-- Saying "nothing here" under an active filter
                                 reads as an empty folder, and the filter is the
                                 one thing that can be undone from here. -->
                            <t t-esc="noMatchLabel"/>
                            <div class="mt-2">
                                <button class="btn btn-link btn-sm p-0"
                                        t-on-click="() => props.onClearFilter()">
                                    Show all messages
                                </button>
                            </div>
                        </t>
                        <t t-else="">Nothing here.</t>
                    </div>
                </t>

                <t t-foreach="listItems" t-as="item" t-key="item.key">
                    <div t-if="item.type === 'group'" class="o_mail_client_group text-muted"
                         t-esc="groupLabel(item.bucket)"/>

                    <div t-elif="item.type === 'digest'"
                         class="o_mail_client_row o_mail_client_digest d-flex"
                         t-att-class="{ o_unread: item.digest.unread }"
                         role="button" tabindex="0"
                         t-on-click="() => this.onOpenDigest(item.digest)"
                         t-on-keydown="(ev) => ev.key === 'Enter' and this.onOpenDigest(item.digest)">
                        <span class="o_mail_client_lead">
                            <i class="fa fa-folder-o text-muted" aria-hidden="true"/>
                        </span>
                        <div class="o_mail_client_row_main">
                            <div class="o_mail_client_line1">
                                <span class="o_mail_client_who text-truncate" t-esc="item.digest.name"/>
                                <span class="o_mail_client_row_count text-muted" t-if="item.digest.unread"
                                      t-esc="digestUnreadLabel(item.digest.unread)"/>
                                <small class="o_mail_client_date text-muted" t-esc="formatDate(item.digest.date)"/>
                            </div>
                            <div class="o_mail_client_line2 text-truncate text-muted">
                                <t t-esc="item.digest.senders.join(', ')"/>
                            </div>
                        </div>
                    </div>

                    <div t-else="" class="o_mail_client_row d-flex"
                         t-att-class="{
                             'o_unread': !item.message.flag_seen,
                             'active': isSelected(item.message.id),
                             'o_ticked': isTicked(item.message.id),
                         }"
                         t-on-click="(ev) => this.onRowClick(ev, item.message.id)">
                        <t t-set="message" t-value="item.message"/>
                        <label class="o_mail_client_lead">
                            <span class="o_mail_client_dot" t-if="!message.flag_seen" aria-hidden="true"/>
                            <input type="checkbox" class="form-check-input o_mail_client_tick"
                                   t-att-aria-label="message.subject"
                                   t-att-checked="isTicked(message.id)"
                                   t-on-change="() => props.onToggleSelected(message.id)"/>
                        </label>
                        <div class="o_mail_client_row_main">
                            <div class="o_mail_client_line1">
                                <span class="o_mail_client_who text-truncate" t-if="message.is_outgoing"
                                      t-att-title="message.email_to">
                                    <!-- Пробел — на той же строке: Owl выбрасывает
                                         пробелы с переводом строки между тегами. -->
                                    <span class="o_mail_client_to_label text-muted">To:</span> <t t-esc="recipient(message)"/>
                                </span>
                                <span class="o_mail_client_who text-truncate" t-else=""
                                      t-att-title="message.email_from" t-esc="sender(message)"/>
                                <span t-if="message.thread_count > 1"
                                      class="o_mail_client_row_count text-muted"
                                      t-att-title="threadTitle(message.thread_count)"
                                      t-esc="message.thread_count"/>
                                <span t-if="message.awaiting" class="o_mail_client_await"
                                      t-att-class="message.awaiting === 'us' ? 'o_await_us' : 'o_await_client'"
                                      t-att-title="awaitTitle(message.awaiting)"
                                      t-esc="awaitLabel(message.awaiting)"/>
                                <span class="o_mail_client_marks" t-if="message.flag_flagged or message.has_attachment">
                                    <i t-if="message.flag_flagged" class="fa fa-star text-warning small"/>
                                    <i t-if="message.has_attachment" class="fa fa-paperclip text-muted small"/>
                                </span>
                                <small class="o_mail_client_date text-muted" t-esc="formatDate(message.date)"/>
                            </div>
                            <div class="o_mail_client_line2 text-truncate">
                                <i t-if="message.flag_answered" class="fa fa-reply text-muted me-1 small"/>
                                <span class="o_mail_client_row_subject" t-esc="message.subject"/>
                                <span class="o_mail_client_preview text-muted" t-if="message.preview">
                                    — <t t-esc="message.preview"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </t>

                <div class="p-2 text-center" t-if="props.hasMore">
                    <button class="btn btn-link btn-sm"
                            t-att-disabled="props.loading"
                            t-on-click="() => props.onLoadMore()">
                        Load more
                    </button>
                </div>
            </div>
        </div>
    </t>

</templates>
