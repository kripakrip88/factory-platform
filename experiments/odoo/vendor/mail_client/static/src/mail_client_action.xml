<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ПРАВКА ПМК (шаг 41 разбора удобства, 05.10.2026): корень почты.
         - класс раскладки (layoutClass): o_mc_rail — колонка папок полосой
           значков; o_mc_full — письмо вместо списка («на весь экран»,
           на телефоне всегда); o_mc_reader_open — сейчас на экране письмо;
           o_mc_small — телефон; o_mc_drawer — шторка папок на телефоне;
           o_mc_resizing — тянут границу колонки;
         - ширины колонок — CSS-переменными в style (paneStyle);
         - поиск по мере ввода (onSearchInput, Enter — сразу, Esc —
           очистить), «/» ставит в него курсор;
         - две границы колонок (o_mail_client_resizer): перетаскивание,
           стрелки ← →, Home и двойной щелчок — ширина по умолчанию;
         - подписи кнопок верхней строки — в o_mail_client_label: на телефоне
           остаются значки (mail_client.scss). -->
    <t t-name="mail_client.Inbox">
        <div class="o_mail_client d-flex flex-column h-100" t-ref="root"
             t-att-class="layoutClass" t-att-style="paneStyle">
            <!-- ПРАВКА ПМК (почта проще, 25.10.2026; Антон: «очень много кнопок,
                 в которых путаешься»): в строке — «Написать», поиск с меню
                 «Фильтр ▾», кружки «Непрочитанные» и «Ждут ответа», меню вида ⚙
                 (переписками, письмо рядом / на весь экран, свернуть папки,
                 проверить почту, адрес ящика). Чип «Все», «Ещё ▾», значки
                 переписок и синхронизации, адрес ящика — убраны в меню; кнопка
                 папок — только на телефоне (шторка), на компьютере — в ⚙. -->
            <div class="o_mail_client_topbar d-flex align-items-center gap-2 px-3 py-2">
                <button t-if="isPhone" class="btn btn-light btn-sm o_mail_client_folders_toggle"
                        t-att-title="sidebarTitle"
                        t-att-aria-label="sidebarTitle"
                        t-on-click="() => this.toggleFolders()">
                    <i class="fa" t-att-class="sidebarIcon" aria-hidden="true"/>
                </button>
                <button class="btn btn-primary btn-sm"
                        t-att-disabled="!activeAccount"
                        t-on-click="() => this.compose('new')">
                    <i class="fa fa-pencil" aria-hidden="true"/><span class="o_mail_client_label ms-1">Compose</span>
                </button>
                <!-- ПРАВКА ПМК (редизайн почты, шаг 3, 14.10.2026): одна строка
                     управления — поиск на всю ширину, сразу за ним фильтры
                     кружками («Все» и быстрые; редкие — в «Ещё ▾»), значками —
                     группировка в переписки и «Синхронизировать». Ряд «Входящие»
                     и кнопки-фильтры над списком убраны (message_list.xml). -->
                <div class="o_mail_client_search flex-grow-1 d-flex gap-1">
                    <!-- ПРАВКА ПМК (шаг 18, Г11): ищем и по получателю.
                         ПРАВКА ПМК (шаг 41, А7): по мере ввода, во всех
                         папках, кроме Спама и Корзины; «/» — сюда. -->
                    <!-- ПРАВКА ПМК (15.10.2026): × внутри поля — стереть поиск
                         одним щелчком (то же, что Esc). -->
                    <div class="o_mail_client_search_box flex-grow-1 position-relative">
                        <input type="text" class="form-control form-control-sm"
                               t-ref="search"
                               placeholder="Search subject, sender, recipient or preview…"
                               aria-keyshortcuts="/"
                               t-att-value="state.searchInput"
                               t-on-input="(ev) => this.onSearchInput(ev.target.value)"
                               t-on-keydown="(ev) => this.onSearchKeydown(ev)"/>
                        <button t-if="state.searchInput or state.search" type="button"
                                class="o_mail_client_search_clear btn btn-link"
                                title="Clear search" aria-label="Clear search"
                                t-on-click="() => this.clearSearch()">
                            <i class="fa fa-times" aria-hidden="true"/>
                        </button>
                    </div>
                    <Dropdown menuClass="'o_mail_client_filter_menu'">
                        <button class="btn btn-sm o_mail_client_chip o_mail_client_filter_toggle flex-shrink-0"
                                t-att-class="{ active: menuFilterActive }"
                                title="Фильтр писем" aria-label="Фильтр писем">
                            <i class="fa fa-filter me-1" aria-hidden="true"/><t t-esc="menuFilterLabel"/><i class="fa fa-caret-down ms-1" aria-hidden="true"/>
                        </button>
                        <t t-set-slot="content">
                            <DropdownItem class="{ 'd-flex align-items-center gap-2': true, active: state.filter === 'all' }"
                                          onSelected="() => this.setFilter('all')">
                                <i class="fa fa-fw fa-inbox"/>Все письма
                            </DropdownItem>
                            <DropdownItem t-foreach="menuFilters" t-as="item" t-key="item.id"
                                          class="{ 'd-flex align-items-center gap-2': true, active: item.id === state.filter }"
                                          onSelected="() => this.setFilter(item.id)">
                                <i class="fa fa-fw" t-att-class="item.icon"/>
                                <t t-esc="item.label"/>
                            </DropdownItem>
                        </t>
                    </Dropdown>
                    <button class="btn btn-light btn-sm flex-shrink-0"
                            t-if="state.search and state.activeFolderId"
                            t-att-disabled="state.searchingServer"
                            title="Search on the mail server, including messages not stored here"
                            t-on-click="() => this.searchOnServer()">
                        <i class="fa" t-att-class="state.searchingServer ? 'fa-circle-o-notch fa-spin' : 'fa-server'" aria-hidden="true"/><span class="o_mail_client_label ms-1">Server</span>
                    </button>
                </div>
                <div class="o_mail_client_chips d-flex align-items-center gap-1 flex-shrink-0"
                     role="group" t-att-aria-label="quickFiltersLabel">
                    <button type="button" t-foreach="chipFilters" t-as="quick" t-key="quick.id"
                            class="btn btn-sm o_mail_client_chip"
                            t-att-class="{ active: state.filter === quick.id }"
                            t-att-aria-pressed="state.filter === quick.id ? 'true' : 'false'"
                            t-on-click="() => this.setQuickFilter(quick.id)">
                        <t t-esc="quick.label"/>
                    </button>
                </div>
                <Dropdown position="'bottom-end'" menuClass="'o_mail_client_view_menu'">
                    <button class="btn btn-light btn-sm o_mail_client_view_toggle"
                            title="Вид и проверка почты" aria-label="Вид и проверка почты">
                        <i class="fa" t-att-class="state.syncing ? 'fa-refresh fa-spin' : 'fa-sliders'" aria-hidden="true"/>
                    </button>
                    <t t-set-slot="content">
                        <DropdownItem class="{ 'd-flex align-items-center gap-2': true, active: state.threaded }"
                                      onSelected="() => this.toggleThreaded()">
                            <i class="fa fa-fw fa-comments-o"/>Переписками
                            <i t-if="state.threaded" class="fa fa-check ms-auto" aria-hidden="true"/>
                        </DropdownItem>
                        <t t-if="!isPhone">
                            <DropdownItem class="'d-flex align-items-center gap-2'"
                                          onSelected="() => this.toggleReaderLayout()">
                                <i class="fa fa-fw" t-att-class="state.readerFull ? 'fa-columns' : 'fa-expand'"/>
                                <t t-esc="readerLayoutMenuLabel"/>
                            </DropdownItem>
                            <DropdownItem class="'d-flex align-items-center gap-2'"
                                          onSelected="() => this.toggleFolders()">
                                <i class="fa fa-fw" t-att-class="sidebarIcon"/>
                                <t t-esc="sidebarTitle"/>
                            </DropdownItem>
                        </t>
                        <t t-if="activeAccount">
                            <div class="dropdown-divider"/>
                            <DropdownItem class="'d-flex align-items-center gap-2'"
                                          onSelected="() => this.syncNow()">
                                <i class="fa fa-fw fa-refresh"/>Проверить почту сейчас
                            </DropdownItem>
                            <div class="dropdown-header text-truncate" t-esc="activeAccount.email"/>
                        </t>
                    </t>
                </Dropdown>
            </div>

            <div class="o_mail_client_body d-flex flex-grow-1 overflow-hidden">
                <FolderTree t-if="showFolderPane"
                            accounts="state.accounts"
                            activeFolderId="state.activeFolderId"
                            unified="state.unified"
                            drafts="state.drafts"
                            rail="folderRail"
                            drawer="isPhone"
                            onSelectFolder.bind="selectFolder"
                            onSelectUnified.bind="selectUnified"
                            onResumeDraft.bind="resumeDraft"/>
                <!-- Телефон: шторка папок поверх списка, щелчок мимо — закрыть. -->
                <div t-if="isPhone and state.folderDrawer" class="o_mail_client_backdrop"
                     t-on-click="() => this.closeDrawer()"/>
                <div t-if="showFolderResizer" class="o_mail_client_resizer"
                     role="separator" aria-orientation="vertical" tabindex="0"
                     t-att-title="resizeTitle" t-att-aria-label="resizeTitle"
                     t-att-aria-valuenow="resizerValue('folders')"
                     t-att-aria-valuemin="resizerLimits('folders')[0]"
                     t-att-aria-valuemax="resizerLimits('folders')[1]"
                     t-on-pointerdown="(ev) => this.startResize(ev, 'folders')"
                     t-on-keydown="(ev) => this.onResizerKeydown(ev, 'folders')"
                     t-on-dblclick="() => this.resetPaneWidth('folders')"/>

                <t t-if="fullDraft">
                    <!-- Writing gets the full width: the message list is of no
                         use while composing, and a cramped editor is the single
                         most common complaint about in-app mail clients. -->
                    <Composer draft="fullDraft" t-key="fullDraft.id"
                              onClose.bind="closeComposer"
                              onSent.bind="onSent"/>
                </t>
                <t t-else="">
                    <!-- ПРАВКА ПМК (шаг 22): список обновляется без сброса —
                         плашка новых писем, подсветка открытой переписки,
                         прокрутка для корня (refreshList).
                         ПРАВКА ПМК (шаг 41): кнопки-фильтры, где искали,
                         значки строки при наведении; щелчок по строке —
                         selectRow (от неё считают ↑/↓). -->
                    <MessageList messages="state.messages"
                                 selectedMessageId="state.selectedMessageId"
                                 selectedIds="state.selectedIds"
                                 moveTargets="state.bulkMoveTargets"
                                 hasMore="state.hasMore"
                                 loading="state.loadingList"
                                 busy="state.bulkBusy"
                                 canAct="canAct"
                                 folderName="activeFolder ? activeFolder.name : ''"
                                 filterLabel="filterLabel"
                                 digests="state.digests"
                                 pendingNew="state.pendingNew"
                                 selectedThreadKey="selectedThreadKey"
                                 quickFilters="quickFilters"
                                 activeFilter="state.filter"
                                 searchScope="searchScope"
                                 folderNames="folderNames"
                                 activeFolderId="state.activeFolderId"
                                 onQuickFilter.bind="setQuickFilter"
                                 onRowSeen.bind="rowSeen"
                                 onRowFlag.bind="rowFlagged"
                                 onShowNew.bind="showNewMessages"
                                 onReachTop.bind="onListTop"
                                 onListApi.bind="setListApi"
                                 onOpenFolder.bind="selectFolder"
                                 onClearFilter="() => this.setFilter('all')"
                                 onSelectMessage.bind="selectRow"
                                 onLoadMore.bind="loadMore"
                                 onToggleSelected.bind="toggleSelected"
                                 onToggleAll.bind="toggleAll"
                                 onBulkSeen.bind="bulkSeen"
                                 onBulkFlagged.bind="bulkFlagged"
                                 onBulkMove.bind="bulkMove"
                                 onBulkDelete.bind="bulkDelete"/>
                    <div t-if="showListResizer" class="o_mail_client_resizer"
                         role="separator" aria-orientation="vertical" tabindex="0"
                         t-att-title="resizeTitle" t-att-aria-label="resizeTitle"
                         t-att-aria-valuenow="resizerValue('list')"
                         t-att-aria-valuemin="resizerLimits('list')[0]"
                         t-att-aria-valuemax="resizerLimits('list')[1]"
                         t-on-pointerdown="(ev) => this.startResize(ev, 'list')"
                         t-on-keydown="(ev) => this.onResizerKeydown(ev, 'list')"
                         t-on-dblclick="() => this.resetPaneWidth('list')"/>
                    <ReadingPane detail="state.detail"
                                 loading="state.loadingDetail"
                                 moveTargets="state.moveTargets"
                                 canAct="canAct"
                                 thread="state.thread"
                                 contact="state.contact"
                                 layout="readerLayout"
                                 hasPrev="neighbours.prev"
                                 hasNext="neighbours.next"
                                 onBack.bind="backToList"
                                 onNeighbour.bind="moveSelection"
                                 onToggleLayout.bind="toggleReaderLayout"
                                 onSelectMessage.bind="selectMessage"
                                 onDownloadEml.bind="downloadEml"
                                 onAllowImages.bind="allowImages"
                                 onToggleSeen.bind="toggleSeen"
                                 onToggleFlagged.bind="toggleFlagged"
                                 onMove.bind="moveMessage"
                                 onDelete.bind="deleteMessage"
                                 onReply.bind="compose"
                                 draft="inlineDraft"
                                 onCloseDraft.bind="closeComposer"
                                 onDraftSent.bind="onSent"
                                 onExpandDraft.bind="expandDraft"
                                 onDraftFlushed.bind="loadDrafts"
                                 onDownloadAttachment.bind="downloadAttachment"
                                 onConversationShown.bind="conversationShown"/>
                </t>
            </div>
        </div>
    </t>

</templates>
