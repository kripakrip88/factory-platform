<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mail_client.Composer">
        <div class="o_mail_client_composer d-flex flex-column h-100">
            <div class="o_mail_client_composer_header d-flex align-items-center px-4 py-2">
                <h5 class="mb-0 flex-grow-1"><t t-esc="title"/></h5>
                <small class="text-muted me-2" t-if="state.savedAt">
                    <i class="fa fa-check me-1"/>Draft saved
                </small>
                <button class="btn btn-link btn-sm text-muted"
                        t-on-click="() => this.onSaveAndClose()"
                        title="Close (keeps a draft if anything was typed)">
                    <i class="fa fa-times"/>
                </button>
            </div>

            <div class="flex-grow-1 overflow-auto p-3 d-flex">
                <div class="o_mail_client_compose_card d-flex flex-column flex-grow-1">
                    <div class="o_mail_client_field d-flex align-items-center">
                        <label class="o_mail_client_composer_label">To</label>
                        <RecipientInput label="''" value="state.email_to"
                                        placeholder.translate="Start typing a name, or paste an address"
                                        onUpdate="(value) => this.updateField('email_to', value)"/>
                        <button class="btn btn-sm btn-link text-muted flex-shrink-0 px-2"
                                t-on-click="() => state.showCc = !state.showCc">
                            Cc/Bcc
                        </button>
                    </div>

                    <div class="o_mail_client_field d-flex align-items-center" t-if="state.showCc">
                        <label class="o_mail_client_composer_label">Cc</label>
                        <RecipientInput label="''" value="state.email_cc"
                                        onUpdate="(value) => this.updateField('email_cc', value)"/>
                    </div>

                    <div class="o_mail_client_field d-flex align-items-center" t-if="state.showCc">
                        <label class="o_mail_client_composer_label">Bcc</label>
                        <RecipientInput label="''" value="state.email_bcc"
                                        onUpdate="(value) => this.updateField('email_bcc', value)"/>
                    </div>

                    <div class="o_mail_client_field d-flex align-items-center">
                        <label class="o_mail_client_composer_label">Subject</label>
                        <input type="text" class="o_mail_client_plain_input flex-grow-1"
                               placeholder="Subject" t-model="state.subject"/>
                    </div>

                    <div class="d-flex align-items-center o_mail_client_editor_bar">
                        <t t-if="!state.showCode">
                            <EditorToolbar getEditor.bind="getEditor"/>
                        </t>
                        <t t-else="">
                            <span class="small text-muted px-2">
                                <i class="fa fa-code me-1"/>
                                Editing the HTML source
                            </span>
                        </t>
                        <div class="flex-grow-1"/>
                        <button type="button" class="btn btn-sm me-1"
                                t-att-class="state.showCode ? 'btn-primary' : 'btn-light'"
                                title="Toggle HTML source"
                                t-on-click="() => this.toggleCodeView()">
                            <i class="fa fa-code"/>
                        </button>
                    </div>

                    <div class="o_mail_client_editor_wrap flex-grow-1 d-flex flex-column">
                        <textarea t-if="state.showCode"
                                  class="o_mail_client_codeview flex-grow-1"
                                  spellcheck="false"
                                  t-att-value="body"
                                  t-on-change="(ev) => this.onCodeChange(ev)"/>
                        <Wysiwyg config="editorConfig" onLoad.bind="onEditorLoad"
                                 class="'o_mail_client_editor flex-grow-1'"
                                 contentClass="state.showCode ? 'd-none' : ''"/>
                    </div>

                    <div class="o_mail_client_attachments" t-if="state.attachments.length">
                        <div class="o_mail_client_attachments_title text-muted small">
                            <i class="fa fa-paperclip me-1"/>
                            <t t-esc="state.attachments.length"/> attachment(s)
                        </div>
                        <div class="d-flex flex-wrap gap-2 p-2">
                            <span t-foreach="state.attachments" t-as="attachment"
                                  t-key="attachment.id"
                                  class="o_mail_client_chip d-inline-flex align-items-center gap-2">
                                <i class="fa fa-file-o text-muted"/>
                                <span t-esc="attachment.name"/>
                                <small class="text-muted" t-esc="formatSize(attachment.size)"/>
                                <button class="btn btn-sm btn-link p-0 ms-1 text-danger"
                                        t-on-click="() => this.onRemoveAttachment(attachment.id)">
                                    <i class="fa fa-times"/>
                                </button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="o_mail_client_composer_footer d-flex align-items-center gap-2 px-4 py-3">
                <button class="btn btn-primary"
                        t-att-disabled="state.sending"
                        t-on-click="() => this.onSend()">
                    <i class="fa fa-paper-plane me-1"/>
                    <t t-if="state.sending">Sending…</t>
                    <t t-else="">Send</t>
                </button>
                <button class="btn btn-light" t-att-disabled="state.uploading"
                        t-on-click="() => this.onAttachClick()">
                    <i class="fa fa-paperclip me-1"/>
                    <t t-if="state.uploading">Uploading…</t>
                    <t t-else="">Attach</t>
                </button>
                <input type="file" multiple="multiple" class="d-none" t-ref="fileInput"
                       t-on-change="(ev) => this.onFilesSelected(ev)"/>
                <button class="btn btn-light" t-att-disabled="state.saving"
                        t-on-click="() => this.onSaveDraft()">
                    <i class="fa fa-floppy-o me-1"/>
                    <t t-if="state.saving">Saving…</t>
                    <t t-else="">Save draft</t>
                </button>
                <div class="flex-grow-1"/>
                <button class="btn btn-link text-danger"
                        t-on-click="() => this.onDiscard()">
                    Discard
                </button>
            </div>
        </div>
    </t>

</templates>
