<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!--
    Пункт встаёт в раздел «Производство» НАШЕЙ навигации (pmk_theme), а не в
    штатное меню Odoo: корневое mrp.menu_mrp_root тема выключает, и пункт,
    повешенный туда, просто никому не показался бы.

    Сразу после «Рабочие центры» (sequence 40), потому что это про них же —
    только не справочник, а «чем они заняты на этой неделе».

    В разделе «Отчёты» уже есть одноимённый пункт темы, но он ведёт на штатный
    график Odoo (mrp.action_mrp_workcenter_load_report_graph) — там та же
    величина в разрезе заданий и месяцев. Наш экран отвечает на другой вопрос:
    «что с участками прямо сейчас». Названия поэтому разные.
  -->
  <menuitem id="menu_pmk_prod_workcenter_load"
            name="Загрузка на эту неделю"
            parent="pmk_theme.menu_pmk_production"
            action="action_mrp_workcenter_load"
            sequence="45"/>

</odoo>
