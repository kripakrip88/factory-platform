<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Раз в минуту: забрать готовый раскрой листа, запустить следующий из общей
       очереди (лист + вентзонты). Кнопка сама дёргает задание (_trigger). -->
  <record id="cron_sheet_nest" model="ir.cron">
    <field name="name">Раскрой листа: забрать результат</field>
    <field name="model_id" ref="model_pmk_sheet_nest_run"/>
    <field name="state">code</field>
    <field name="code">model._cron_collect()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">minutes</field>
    <field name="active" eval="True"/>
  </record>
</odoo>
