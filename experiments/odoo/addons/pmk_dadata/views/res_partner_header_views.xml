<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!--
    ШАПКА КАРТОЧКИ КОНТРАГЕНТА ПО ОБРАЗЦУ КАРТОЧКИ ТОВАРА.

    Решение Антона 23.09.2026: «как у товара — тип и название, аватар сделай
    так же как у товара, уменьши и поставь справа».

    ЧТО БЫЛО. В шапке жили девять полей: аватар 130×130 слева, переключатель
    «Гость / Компания», название, почта, телефон, а ниже отдельной группой —
    адрес из четырёх полей, веб-сайт и теги. У товара в шапке только название
    и два флажка, всё остальное во вкладках; пока шапки так расходятся,
    одинаковыми карточки не станут никакими стилями.

    ЧТО ДЕЛАЕМ. Почту, телефон и группу с адресом переносим на первую вкладку
    «Реквизиты» — туда, где им место по смыслу. В шапке остаются тип, название
    и аватар.

    ⚠️ ФАЙЛ ЖИВЁТ В pmk_dadata, А НЕ В pmk_partner, И ЭТО ОБЯЗАТЕЛЬНО.
    Страницу «Реквизиты» создаёт pmk_dadata, а он зависит от pmk_partner —
    обратной связи нет. Во время загрузки Odoo собирает представление ТОЛЬКО
    из уже загруженных модулей: положи этот вид в pmk_partner — страницы ещё
    не существует, xpath падает с «cannot be located in parent view», и база
    не поднимается целиком. Этим уже дважды уронили боевую систему.

    ⚠️ ПЕРЕНОС ТОЛЬКО ЧЕРЕЗ position="move" ВНУТРИ replace/before. Odoo
    обрабатывает move лишь в этих ветках (tools/template_inheritance.py):
    в position="inside" перенос молча не выполняется, узлы остаются на месте,
    а приёмник выходит пустым. На этом уже обжигались при плоской карточке.
  -->
  <record id="view_partner_form_header" model="ir.ui.view">
    <field name="name">res.partner.form.pmk.header</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <!-- Приоритет выше, чем у вида реквизитов (100): страница «Реквизиты»
         к этому моменту уже создана, и есть куда переносить. -->
    <field name="priority">110</field>
    <field name="active">True</field>
    <field name="arch" type="xml">

      <!-- Приёмник для полей связи: пустая группа первой на вкладке. -->
      <xpath expr="//page[@name='pmk_requisites']/group[@name='pmk_g_requisites']" position="before">
        <group string="Связь" name="pmk_g_contact_info"/>
      </xpath>

      <!-- Почта и телефон из шапки. Переносим сами обёртки со значками:
           внутри них иконка и поле, и разрывать пару незачем. -->
      <xpath expr="//group[@name='pmk_g_contact_info']" position="replace" mode="inner">
        <xpath expr="//field[@name='email']/.." position="move"/>
        <xpath expr="//field[@name='phone']/.." position="move"/>
      </xpath>

    </field>
  </record>

</odoo>
