<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="view_partner_form_requisites" model="ir.ui.view">
    <field name="name">res.partner.form.pmk.requisites</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">

      <!--
        Отдельная вкладка «Реквизиты» по образцу МойСклада, которым завод
        пользуется сегодня: всё, что переписывают из выписки, в одном месте и
        в привычном порядке. Раньше ИНН и КПП лежали в одной вкладке, ОГРН и
        ОКПО в другой, а юридический адрес приходилось собирать из девяти полей.

        Вкладка первая в блокноте: заводя поставщика, начинают именно с неё.
      -->
      <xpath expr="//notebook/page[1]" position="before">
        <page string="Реквизиты" name="pmk_requisites">
          <!-- Имена нужны, чтобы плоская раскладка могла сослаться на группы:
               выбирать узел по заголовку Odoo не разрешает. -->
          <group name="pmk_g_requisites">
            <group>
              <field name="company_type" widget="radio" options="{'horizontal': true}"/>
              <label for="inn"/>
              <!--
                o_row, а не свой d-flex. Тема оформляет ровно три формы
                разметки ячейки: поле напрямую, поле внутри o_row и блок
                адреса. Своя обёртка не попадала ни под одну — поле
                оставалось без фона и рамки. Плюс ядро схлопывает oe_inline
                по содержимому (`width: auto !important`), и пустое поле
                становилось шириной в ноль. На экране это выглядело как
                «поля ИНН нет вообще».
              -->
              <div class="o_row">
                <field name="inn" nolabel="1"
                       placeholder="10 цифр у организации, 12 у ИП"/>
                <!-- Кнопку показываем всегда, даже на пустом ИНН: спрятанная
                     кнопка не объясняет, почему её нет. Пустое поле ловится
                     в обработчике понятным сообщением. -->
                <button name="action_pmk_fill_by_inn" type="object"
                        string="Заполнить по ИНН" class="btn-secondary"/>
              </div>
              <field name="pmk_legal_name" placeholder="Как в ЕГРЮЛ, с формой собственности"/>
              <field name="pmk_legal_address" placeholder="Одной строкой, как в выписке"/>
              <field name="pmk_address_note" placeholder="Ориентир, офис, как проехать"/>
              <field name="fias_id" string="Код ФИАС"/>
            </group>
            <group>
              <field name="kpp"/>
              <field name="ogrn"/>
              <field name="okpo"/>
              <field name="pmk_dadata_status"/>
            </group>
          </group>

          <group string="Банковские счета" name="pmk_g_bank">
            <field name="bank_ids" nolabel="1" colspan="2">
              <list editable="bottom">
                <field name="acc_number" string="Расчётный счёт"/>
                <field name="bank_id" string="Банк"/>
                <field name="allow_out_payment" optional="hide"/>
              </list>
            </field>
          </group>
        </page>
      </xpath>

      <!--
        Дубли. КПП, ОГРН и ОКПО показываются дважды: российская локализация
        кладёт их в ШАПКУ листа (выше блокнота), и мы добавили их сюда.
        Прячем копии в шапке — здесь они лежат в осмысленном соседстве
        с ИНН и кнопкой заполнения.

        ИНН в шапке локализация прячет сама (invisible="True"), поэтому
        единственный видимый ввод ИНН — наш.
      -->
      <xpath expr="//sheet//field[@name='kpp'][1]" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//sheet//field[@name='ogrn'][1]" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//sheet//field[@name='okpo'][1]" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

      <!--
        Код ФИАС прятали в pmk_partner как лишний, но в МойСкладе он есть и
        Антон на него указал. Возвращаем — но только на вкладке реквизитов,
        в блоке адреса ему по-прежнему не место.
      -->
      <field name="fias_id" position="attributes">
        <attribute name="invisible">0</attribute>
      </field>

    </field>
  </record>

</odoo>
