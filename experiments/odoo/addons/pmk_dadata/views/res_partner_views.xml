<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="view_partner_form_requisites" model="ir.ui.view">
    <field name="name">res.partner.form.pmk.requisites</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">

      <!--
        Отдельная вкладка «Реквизиты» по образцу МойСклада, которым завод
        пользуется сегодня: всё, что переписывают из выписки, в одном месте и
        в привычном порядке. Раньше ИНН и КПП лежали в одной вкладке, ОГРН и
        ОКПО в другой, а юридический адрес приходилось собирать из девяти полей.

        Вкладка стоит первой в блокноте, но карточка открывается НЕ на ней:
        у стандартных «Контактов» в базовом представлении проставлен
        autofocus="autofocus", и Odoo отдаёт фокус ему, а не первой вкладке.
        Проверено на карточке поставщика — открывается «Контакты».
        Если понадобится приземляться на «Реквизиты» — снять autofocus там
        и поставить сюда; пока поведение оставлено родным.
      -->
      <xpath expr="//notebook/page[1]" position="before">
        <page string="Реквизиты" name="pmk_requisites">
          <!-- Имена нужны, чтобы плоская раскладка могла сослаться на группы:
               выбирать узел по заголовку Odoo не разрешает. -->
          <group name="pmk_g_requisites">
            <group>
              <!-- Тип контрагента не повторяем: он уже стоит в шапке листа
                   переключателем «Гость / Компания». Два одинаковых
                   переключателя на одной форме сбивают. -->
              <label for="vat" string="ИНН"/>
              <!--
                o_row, а не свой d-flex. Тема оформляет ровно три формы
                разметки ячейки: поле напрямую, поле внутри o_row и блок
                адреса. Своя обёртка не попадала ни под одну — поле
                оставалось без фона и рамки. Плюс ядро схлопывает oe_inline
                по содержимому (`width: auto !important`), и пустое поле
                становилось шириной в ноль. На экране это выглядело как
                «поля ИНН нет вообще».
              -->
              <div class="o_row">
                <!--
                  Пишем в `vat`, а не в `inn`. В российской локализации `inn` —
                  ЗЕРКАЛО поля `vat`: связанное, нехранимое, только для чтения.
                  Показывать его как поле ввода бессмысленно: оно не примет
                  ничего. Настоящее хранилище — `vat`, подпись ставим «ИНН».
                  Проверено: res.partner.inn readonly=True, related='vat'.
                -->
                <field name="vat" nolabel="1" string="ИНН"
                       placeholder="10 цифр у организации, 12 у ИП"/>
                <!-- Кнопку показываем всегда, даже на пустом ИНН: спрятанная
                     кнопка не объясняет, почему её нет. Пустое поле ловится
                     в обработчике понятным сообщением. -->
                <button name="action_pmk_fill_by_inn" type="object"
                        string="Заполнить по ИНН" class="btn-secondary"/>
              </div>
              <field name="pmk_legal_name" placeholder="Как в ЕГРЮЛ, с формой собственности"/>
              <field name="pmk_legal_address" placeholder="Одной строкой, как в выписке"/>
              <field name="pmk_address_note" placeholder="Ориентир, офис, как проехать"/>
              <field name="fias_id" string="Код ФИАС"/>
            </group>
            <group>
              <field name="kpp"/>
              <field name="ogrn"/>
              <field name="okpo"/>
              <field name="pmk_dadata_status"/>
            </group>
          </group>

          <!-- Без string: эту группу целиком переносят в секцию «Банковские
               счета», у которой заголовок уже есть. Со своим заголовком
               получалось два одинаковых подряд (замер на карточке
               поставщика 23.09.2026). -->
          <group name="pmk_g_bank">
            <field name="bank_ids" nolabel="1" colspan="2">
              <list editable="bottom">
                <field name="acc_number" string="Расчётный счёт"/>
                <field name="bank_id" string="Банк"/>
                <field name="allow_out_payment" optional="hide"/>
              </list>
            </field>
          </group>
        </page>
      </xpath>

      <!--
        Дубли. КПП, ОГРН и ОКПО показываются дважды: российская локализация
        кладёт их в ШАПКУ листа (выше блокнота), и мы добавили их сюда.
        Прячем копии в шапке — здесь они лежат в осмысленном соседстве
        с ИНН и кнопкой заполнения.

        ИНН в шапке локализация прячет сама (invisible="True"), поэтому
        единственный видимый ввод ИНН — наш.
      -->
      <xpath expr="//sheet//field[@name='kpp'][1]" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//sheet//field[@name='ogrn'][1]" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//sheet//field[@name='okpo'][1]" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>


      <!--
        Банковские счета показывались ДВАЖДЫ: у нас в «Реквизитах» и в
        стандартной вкладке «Выставление счетов». Гасим копию в бухгалтерской
        вкладке — счёт переписывают из той же выписки, что ИНН и КПП, и место
        ему рядом с ними.

        Именно гасим, а не удаляем узел: на него ссылаются xpath'ы других
        модулей (локализации, электронный документооборот), и удаление
        уронило бы их установку.
      -->
      <xpath expr="//page[@name='accounting']//field[@name='bank_ids']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

      <!--
        После этого во «Выставлении счетов» у наших пользователей не остаётся
        НИ ОДНОГО видимого поля — только три заголовка пустых групп:

          Общая информация      — счета учёта, нужны роль «Бухгалтерия» (group_account_user)
          Счета-фактуры клиентов — поля под режимом разработчика (base.group_no_one)
          Кредитные лимиты       — скрыты, пока не включена настройка лимитов

        Пустая вкладка с тремя подписями хуже отсутствующей, поэтому поднимаем
        порог видимости с «Выставление счетов» (group_account_invoice, есть у
        всех) до полной бухгалтерии. Бухгалтеру вкладка вернётся сама вместе
        с ролью, и в ней будут счета учёта — то, ради чего она существует.
        Что именно там лежит и как вернуть — docs/disabled-features.md.
      -->
      <xpath expr="//page[@name='accounting']" position="attributes">
        <attribute name="groups">account.group_account_user</attribute>
      </xpath>

    </field>
  </record>

  <!--
    Наполнение плоских секций «Реквизиты» и «Банковские счета».

    Почему здесь, а не в pmk_partner рядом с остальными секциями: страницу
    «Реквизиты» создаёт ЭТОТ модуль, а зависимость идёт в одну сторону —
    pmk_dadata зависит от pmk_partner. Во время загрузки Odoo собирает
    представление только из уже загруженных модулей, поэтому из pmk_partner
    страницы ещё не существует и перенос падает с «cannot be located in parent
    view». Именно из-за этого плоское представление стояло выключенным, а
    карточка контрагента — без секций (2026-09-20).

    Приоритет 100 — на единицу выше плоской раскладки (99): к этому моменту
    пустые секции уже созданы, и переносить есть куда.

    Перенос, а не объявление полей заново: у полей свои groups и invisible,
    переписывание рано или поздно откроет лишнее не тому человеку. Приёмник
    объявлен как replace mode="inner" — position="inside" перенос не выполняет
    вовсе (odoo/tools/template_inheritance.py), это уже стоило сломанной формы.
  -->
  <record id="view_partner_form_flat_requisites" model="ir.ui.view">
    <field name="name">res.partner.form.pmk.flat.requisites</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="priority">100</field>
    <!--
      ВЫКЛЮЧЕНО 23.09.2026 вместе с плоским видом pmk_partner: этот вид
      переносит реквизиты и банковские счета в его секции, а на вкладках
      они остаются на своей странице «Реквизиты» и переносить их некуда.
      Включать только в паре — см. комментарий там.
    -->
    <field name="active">False</field>
    <field name="arch" type="xml">

      <xpath expr="//group[@name='pmk_s_requisites']" position="replace" mode="inner">
        <xpath expr="//page[@name='pmk_requisites']/group[@name='pmk_g_requisites']"
               position="move"/>
      </xpath>

      <xpath expr="//group[@name='pmk_s_bank']" position="replace" mode="inner">
        <xpath expr="//page[@name='pmk_requisites']/group[@name='pmk_g_bank']"
               position="move"/>
      </xpath>

    </field>
  </record>

</odoo>
