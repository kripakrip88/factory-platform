<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data noupdate="1">
    <!--
      noupdate: при обновлении модуля счётчик не сбрасывается на единицу.
      Без этой записи models/job.py::create молча оставил бы каждому заданию
      имя «Черновик» — next_by_code на несуществующем коде возвращает None,
      исключения не будет. Десяток одинаковых «Черновиков» в списке заданий
      обнаружится не сразу, а когда оператору надо будет сказать, на каком
      из них он режет.
    -->
    <record id="seq_laser_job" model="ir.sequence">
      <field name="name">Задание на лазерную резку</field>
      <field name="code">pmk.laser.job</field>
      <field name="prefix">ЛР-</field>
      <field name="padding">5</field>
      <field name="company_id" eval="False"/>
    </record>
    <!-- Переделка 15.10.2026: задание на резку по заказу — ЗР-. -->
    <record id="seq_laser_task" model="ir.sequence">
      <field name="name">Задание на резку (по заказу)</field>
      <field name="code">pmk.laser.task</field>
      <field name="prefix">ЗР-</field>
      <field name="padding">5</field>
      <field name="company_id" eval="False"/>
    </record>
    <!-- Раскрой — документ с программами по толщинам (15.10.2026) — РС-. -->
    <record id="seq_laser_nest" model="ir.sequence">
      <field name="name">Раскрой (лазер)</field>
      <field name="code">pmk.laser.nest</field>
      <field name="prefix">РС-</field>
      <field name="padding">5</field>
      <field name="company_id" eval="False"/>
    </record>
  </data>
  <!-- Программа раскроя (бывшее «задание лазеру») вне документа раскроя — ПР-. Счётчик noupdate, поэтому префикс
       меняется вызовом при каждом обновлении, номер не сбрасывается. -->
  <function model="ir.sequence" name="write">
    <value eval="[ref('pmk_laser.seq_laser_job')]"/>
    <value eval="{'prefix': 'ПР-', 'name': 'Программа раскроя'}"/>
  </function>
</odoo>
