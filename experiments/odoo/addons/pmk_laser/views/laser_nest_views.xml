<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Раскрой (РС) — документ с программами по толщинам (models/nest.py, 15.10.2026).
       Блоки программ со сводкой и кнопками — pmk_sheet_nest (как раскрой зонтов). -->
  <record id="view_laser_nest_list" model="ir.ui.view">
    <field name="name">pmk.laser.nest.list</field>
    <field name="model">pmk.laser.nest</field>
    <field name="arch" type="xml">
      <list string="Раскрои">
        <field name="name" width="105px"/>
        <field name="date" width="80px"/>
        <field name="task_text" string="Заказы"/>
        <field name="thickness_text" string="Толщины"/>
        <field name="program_count" string="Программ"/>
        <field name="sheet_count" sum="Листов"/>
        <field name="sheets_cut" sum="Порезано листов" optional="show"/>
        <field name="useful_mass_kg" sum="Полезный вес, кг"/>
        <field name="premium_rub" sum="Премия, ₽" optional="show"/>
        <field name="state" widget="badge" decoration-muted="state == 'draft'"
               decoration-info="state in ('queue', 'work')" decoration-success="state == 'done'"/>
      </list>
    </field>
  </record>

  <record id="view_laser_nest_form" model="ir.ui.view">
    <field name="name">pmk.laser.nest.form</field>
    <field name="model">pmk.laser.nest</field>
    <field name="arch" type="xml">
      <form string="Раскрой" class="pmk-doc-form o_pmk_header_up pmk-labels-top-groups">
        <header>
          <button name="action_add_parts" type="object" string="Добавить детали" icon="fa-plus"
                  invisible="state != 'draft'"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_open_programs" type="object" class="oe_stat_button" icon="fa-file-code-o"
                    invisible="not program_count">
              <field name="program_count" widget="statinfo" string="Программ"/>
            </button>
          </div>
          <div class="pmk-doc-top" name="pmk_doc_top">
            <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
            <div class="text-muted" invisible="not task_text">Заказы: <field name="task_text" nolabel="1" class="d-inline"/></div>
            <div invisible="not program_count"><field name="state_text" nolabel="1"/></div>
            <group>
              <group>
                <field name="date"/>
                <field name="machine_id" options="{'no_create': True}"/>
              </group>
              <group>
                <field name="thickness_text" string="Толщины" invisible="not thickness_text"/>
                <field name="note" placeholder="Примечание…"/>
              </group>
            </group>
          </div>
          <notebook>
            <page string="Программы по толщинам" name="programs">
              <field name="program_ids" nolabel="1" readonly="1">
                <list create="0">
                  <field name="name"/>
                  <field name="sheet_id" string="Лист"/>
                  <field name="machine_id" context="{'pmk_machine_short': True}"/>
                  <field name="task_text" string="Заказы" optional="show"/>
                  <field name="sheet_count" sum="Листов"/>
                  <field name="useful_mass_kg" sum="Полезный вес, кг"/>
                  <field name="premium_rub" digits="[10,0]" sum="Премия, ₽"/>
                  <field name="nest_state_text" string="Состояние"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_laser_nest_search" model="ir.ui.view">
    <field name="name">pmk.laser.nest.search</field>
    <field name="model">pmk.laser.nest</field>
    <field name="arch" type="xml">
      <search string="Раскрои">
        <field name="name"/>
        <filter name="open" string="Не порезаны" domain="[('state', '!=', 'done')]"/>
        <separator/>
        <filter name="archived" string="Архив" domain="[('active', '=', False)]"/>
        <group>
          <filter name="group_state" string="Состояние" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_laser_nest" model="ir.actions.act_window">
    <field name="name">Раскрои</field>
    <field name="res_model">pmk.laser.nest</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_laser_nest_search"/>
    <field name="context">{'search_default_open': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Первый раскрой</p>
      <p>Раскрой собирают из деталей заданий на резку: «Детали к раскрою» → отметить детали (хоть
         разных толщин и заказов) → «В раскрой». Внутри — программа CypCut на каждую толщину.</p>
    </field>
  </record>
</odoo>
