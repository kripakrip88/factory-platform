<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="view_metal_spec_form" model="ir.ui.view">
    <field name="name">pmk.metal.spec.form</field>
    <field name="model">pmk.metal.spec</field>
    <field name="arch" type="xml">
      <form string="Спецификация">
        <!--
          Кнопка раскладки в шапке листа. Считает ЧЕРНОВУЮ укладку: сколько
          заготовок влезает в лист и сколько листов покупать. Нажатие —
          осознанный шаг: увидел число листов и решаешь, нести технологу или
          закладывать как есть.
        -->
        <!--
          Предварительный расчёт металла: сколько листов покупать под заказ.
          Его проверяет технолог, подтверждает и отдаёт в закупку — в
          себестоимость КП это число не идёт, там чистый вес справочника.
        -->
        <header>
          <button name="action_draft_layout" type="object"
                  string="Предварительный расчёт металла" class="btn-secondary"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <!--
            Шапка: ввод слева, итоги справа карточками. Итог документа — его
            главное число, а раньше он был набран тем же кеглем, что
            примечание. Сетка 2/1 вместо штатных 50/50: полям ввода нужна
            ширина, числам нет. Оформление приёмом темы (.pmk-kpi), чтобы
            доборка и будущие документы выглядели так же.
          -->
          <!--
            Раскладка ШТАТНОЙ структурой Odoo — вложенные группы дают две
            колонки сами. Раньше она держалась на нашем CSS, и стоило
            таблице стилей отстать от разметки (Odoo — одностраничное
            приложение, вью оно перечитывает, а стили нет), как поля
            разъезжались. Теперь без стилей это просто обычная форма Odoo.
          -->
          <div class="pmk-doc-head">
            <div class="pmk-doc-head__fields">
              <div class="pmk-field">
                <label for="partner_id"/>
                <field name="partner_id" nolabel="1"/>
              </div>
              <div class="pmk-field">
                <label for="date"/>
                <field name="date" nolabel="1"/>
              </div>
              <div class="pmk-field pmk-field--wide">
                <label for="note"/>
                <field name="note" nolabel="1" placeholder="Примечание…"/>
              </div>

            </div>

            <!--
              Две равные плашки, под ними счётчики строкой: в группе полей
              они добавляли лишние ряды и тянули шапку вниз.
            -->
            <div class="pmk-kpi">
              <div class="pmk-kpi__card">
                <div class="pmk-kpi__label">Общий вес, кг</div>
                <div class="pmk-kpi__value">
                  <field name="total_weight" digits="[12,2]"/>
                </div>
              </div>
              <div class="pmk-kpi__card">
                <div class="pmk-kpi__label">Общий вес, т</div>
                <div class="pmk-kpi__value">
                  <field name="total_weight_t" digits="[12,3]"/>
                </div>
              </div>
              <div class="pmk-kpi__note">
                <span>Изделий:</span><field name="total_products"/>
                <span class="pmk-kpi__dot">·</span>
                <span>Деталей:</span><field name="total_details"/>
              </div>
            </div>
          </div>

          <!--
            Изделия раскрываются в форму: внутри у каждого две таблицы деталей,
            в строку списка они не помещаются.
          -->
          <!--
            Свой виджет списка: под каждым изделием раскрывается его состав,
            и прямо там же состав правится.

            У вложенных наборов СВОЯ разметка и пометка optional="hide", хотя
            колонками они не работают. Так пришлось сделать из-за поведения
            Odoo: содержимое набора НЕ запрашивается у сервера, если колонка
            помечена постоянно невидимой (getFieldsSpec пропускает такие поля).
            Именно поэтому состав раньше приходил пустыми заглушками —
            calc_mode: false, qty: 0 — счётчик верен, а состав пуст.

            optional="hide" прячет колонку не модификатором, а пользовательской
            настройкой, под это ограничение не попадает и ничего не ломает:
            колонка скрыта, поля читаются. Плата — четыре строки в меню выбора
            колонок списка — им дали говорящие названия, чтобы включивший
            понимал, что это состав, а не отдельное свойство изделия.
            Разметка внутри задаёт, что читать и что править.
          -->
          <field name="product_ids" widget="pmk_product_lines" class="pmk-rows">
            <list>
              <field name="line_linear_ids" optional="hide" string="Состав: прокат">
                <list>
                  <field name="sequence"/>
                  <field name="calc_mode"/>
                  <field name="detail_name"/>
                  <field name="type_id"/>
                  <field name="profile_id"/>
                  <field name="length_mm"/>
                  <field name="qty"/>
                  <field name="weight_one" readonly="1"/>
                  <field name="weight_total" readonly="1"/>
                </list>
              </field>
              <field name="line_sheet_ids" optional="hide" string="Состав: лист">
                <list>
                  <!-- Раскладка: объявлены, чтобы данные читались; показываются
                       по выбору пользователя через настройку колонок. -->
                  <field name="layout_sheet_size" optional="show"/>
                  <field name="layout_state" optional="hide"/>
                  <field name="layout_per_sheet" optional="hide"/>
                  <field name="layout_sheets" optional="hide" sum="Листов"/>
                  <field name="layout_scheme" optional="hide"/>
                  <field name="layout_utilization_pct" optional="hide"/>
                  <field name="sequence"/>
                  <field name="calc_mode"/>
                  <field name="detail_name"/>
                  <field name="sheet_id"/>
                  <field name="a_mm"/>
                  <field name="b_mm"/>
                  <field name="qty"/>
                  <field name="weight_one" readonly="1"/>
                  <field name="weight_total" readonly="1"/>
                </list>
              </field>
              <field name="line_fastener_ids" optional="hide" string="Состав: метизы">
                <list>
                  <field name="sequence"/>
                  <field name="calc_mode"/>
                  <field name="detail_name"/>
                  <field name="fastener_id"/>
                  <field name="qty"/>
                  <field name="weight_one" readonly="1"/>
                  <field name="weight_total" readonly="1"/>
                </list>
              </field>
              <field name="line_paint_ids" optional="hide" string="Состав: покрытие">
                <list>
                  <field name="sequence"/>
                  <field name="calc_mode"/>
                  <field name="detail_name"/>
                  <field name="paint_id"/>
                  <field name="area_m2"/>
                  <field name="paint_thickness_um"/>
                  <field name="qty"/>
                  <field name="weight_one" readonly="1"/>
                  <field name="weight_total" readonly="1"/>
                </list>
              </field>
              <field name="sequence" widget="handle"/>
              <field name="name"/>
              <field name="qty"/>
              <field name="weight_one" readonly="1"/>
              <field name="weight_total" readonly="1" sum="Итого, кг"/>
              <field name="note" optional="hide"/>
              <!-- Своя подпись вместо штатного «Добавить строку»: строка
                   документа здесь — изделие, так и называем. -->
              <control>
                <create string="Добавить изделие"/>
              </control>
            </list>
            <form string="Изделие">
              <group>
                <group>
                  <field name="name" placeholder="Например: Ферма ФС-1"/>
                  <field name="qty"/>
                </group>
                <group>
                  <field name="weight_one" readonly="1"/>
                  <field name="weight_total" readonly="1"/>
                  <field name="note"/>
                </group>
              </group>

              <notebook>
                <page string="Прокат" name="linear">
                  <field name="line_linear_ids" context="{'default_calc_mode': 'linear'}">
                    <list editable="bottom">
                      <field name="sequence" widget="handle"/>
                      <field name="calc_mode" column_invisible="1"/>
                      <field name="detail_name"/>
                      <field name="type_id" options="{'no_create': True}"/>
                      <!-- Типоразмеры показываем только выбранного вида -->
                      <field name="profile_id" options="{'no_create': True}"
                             domain="[('type_id', '=', type_id)]"/>
                      <field name="length_mm"/>
                      <field name="qty"/>
                      <field name="grade_id" options="{'no_create': True}" optional="hide"/>
                      <field name="weight_one" readonly="1"/>
                      <field name="weight_total" readonly="1" sum="Итого, кг"/>
                    </list>
                  </field>
                </page>

                <page string="Метизы" name="fastener">
                  <field name="line_fastener_ids" context="{'default_calc_mode': 'fastener'}">
                    <list editable="bottom">
                      <field name="sequence" widget="handle"/>
                      <field name="calc_mode" column_invisible="1"/>
                      <field name="detail_name"/>
                      <field name="fastener_id" options="{'no_create': True}"/>
                      <field name="qty"/>
                      <field name="weight_one" readonly="1"/>
                      <field name="weight_total" readonly="1" sum="Итого, кг"/>
                    </list>
                  </field>
                </page>

                <page string="Покрытие" name="paint">
                  <!--
                    Площадь подставляется из состава изделия по площади
                    погонного метра сортамента. Пока эта характеристика не
                    заполнена, площадь можно ввести руками — поле открыто.
                  -->
                  <field name="line_paint_ids" context="{'default_calc_mode': 'paint'}">
                    <list editable="bottom">
                      <field name="sequence" widget="handle"/>
                      <field name="calc_mode" column_invisible="1"/>
                      <field name="detail_name" string="Участок"/>
                      <field name="paint_id" options="{'no_create': True}"/>
                      <field name="area_m2"/>
                      <!-- Базовая подставляется из справочника; правят, когда
                           заказчик требует другую толщину плёнки. -->
                      <field name="paint_thickness_um"/>
                      <field name="qty" column_invisible="1"/>
                      <field name="weight_one" string="Расход, кг" readonly="1"/>
                      <field name="weight_total" readonly="1" sum="Итого, кг"/>
                    </list>
                  </field>
                </page>

                <page string="Лист" name="sheet">
                  <field name="line_sheet_ids" context="{'default_calc_mode': 'sheet'}">
                    <list editable="bottom">
                      <field name="sequence" widget="handle"/>
                      <field name="calc_mode" column_invisible="1"/>
                      <field name="detail_name"/>
                      <field name="sheet_id" options="{'no_create': True}"/>
                      <field name="a_mm"/>
                      <field name="b_mm"/>
                      <field name="qty"/>
                      <field name="grade_id" options="{'no_create': True}" optional="hide"/>
                      <field name="weight_one" readonly="1"/>
                      <field name="weight_total" readonly="1" sum="Итого, кг"/>
                    </list>
                  </field>
                </page>
              </notebook>
            </form>
          </field>

          <!--
            Состав всех изделий сразу, с раскрытием. Список изделий выше
            остаётся местом ввода, а этот блок — местом чтения: посмотреть,
            из чего собрано, не заходя в каждое изделие.
          -->
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_metal_spec_list" model="ir.ui.view">
    <field name="name">pmk.metal.spec.list</field>
    <field name="model">pmk.metal.spec</field>
    <field name="arch" type="xml">
      <list string="Спецификации">
        <field name="name"/>
        <field name="date"/>
        <field name="partner_id"/>
        <field name="total_products"/>
        <field name="total_weight" sum="Итого, кг"/>
        <field name="total_weight_t" sum="Итого, т"/>
      </list>
    </field>
  </record>

  <record id="view_metal_spec_search" model="ir.ui.view">
    <field name="name">pmk.metal.spec.search</field>
    <field name="model">pmk.metal.spec</field>
    <field name="arch" type="xml">
      <search>
        <!-- Номер, клиент и содержимое: спецификацию ищут по всем трём —
             по номеру из переписки, по клиенту и «где мы считали уголок». -->
        <field name="name" string="Номер"/>
        <field name="partner_id" string="Клиент"/>
        <field name="note"/>
        <field name="product_ids" string="Изделие"
               filter_domain="[('product_ids.name', 'ilike', self)]"/>

        <filter name="this_month" string="Этот месяц"
                domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
        <filter name="this_year" string="Этот год"
                domain="[('date', '&gt;=', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
        <separator/>
        <!-- Порог в тонну отделяет рабочие расчёты от прикидок на пару деталей. -->
        <filter name="heavy" string="От 1 тонны" domain="[('total_weight', '&gt;=', 1000)]"/>
        <filter name="no_partner" string="Без клиента" domain="[('partner_id', '=', False)]"/>

        <group>
          <filter name="by_partner" string="Клиент" context="{'group_by': 'partner_id'}"/>
          <filter name="by_date" string="Дата" context="{'group_by': 'date'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_metal_spec" model="ir.actions.act_window">
    <field name="name">Расчёт металлопроката</field>
    <field name="res_model">pmk.metal.spec</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Создайте первый расчёт</p>
      <p>Спецификация состоит из изделий, у каждого своё количество.
         Вес детали умножается и на количество в изделии, и на количество изделий.</p>
    </field>
  </record>

</odoo>
