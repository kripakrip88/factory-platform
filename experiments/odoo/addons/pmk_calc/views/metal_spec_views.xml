<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="view_metal_spec_form" model="ir.ui.view">
    <field name="name">pmk.metal.spec.form</field>
    <field name="model">pmk.metal.spec</field>
    <field name="arch" type="xml">
      <form string="Спецификация" class="pmk-spec-form pmk-doc-form" js_class="pmk_spec_form">
        <!--
          class="pmk-spec-form" — крючок для стилей формы расчёта (разбор UX,
          шаг 32: одна залитая кнопка на экран, см. scss/dobor_builder.scss).
          Ядро кладёт класс на корень вида (div.o_form_view), а не на лист:
          под ним и панель над документом, и лента документа.

          pmk-doc-form — общий класс наших документов (расчёт, доборка,
          раскрой, задание лазеру; разбор UX, шаг 27): подписи слева, одна
          колонка подписей, поля-ссылки одной ширины с соседями, дробные
          поля в рамке (pmk_theme, forms_nexus.scss, раздел 9).

          js_class="pmk_spec_form" — форма без кнопки «Новое» (приёмка
          01.10.2026, R6: новый расчёт заводят из списка «Калькулятор
          металлопроката»). Не create="0": он унёс бы и «Дублировать» в ⚙
          (см. static/src/js/spec_form_view.js).
        -->
        <!--
          ШАПКА ПУСТАЯ, НО ОСТАЁТСЯ. Кнопки в неё кладёт мост (pmk_bridge):
          «КП (PDF)» — главное действие расчёта, «Перечитать цены». Его xpath
          идёт на //header: снеси узел — и вид моста упадёт при загрузке.

          Кнопка раскладки («Предварительный расчёт металла») переехала на
          вкладку «Раскладка», к своему результату, и называется «Разложить
          листы (черновик)» (разбор UX, шаг 32): в шапке она спорила с
          печатью КП за первое место и не говорила, что делает.
        -->
        <header/>
        <sheet>
          <!--
            Заголовок «СМ-00024 от 27 сентября 2026 г.» (приёмка 01.10.2026,
            R3): дата рядом с номером, месяц словом, год полностью. Дата
            правится тут же — по клику поле ввода и календарь (виджет
            pmk_long_date, static/src/js/long_date_field.js). Отдельного
            поля «Дата» в шапке больше нет; в модели оно прежнее, КП печатает
            «от dd.MM.yyyy» из него же. Новый, ещё не записанный расчёт —
            «Новый расчёт от …»: номер СМ- выдаётся при сохранении.
            Узел oe_title остаётся: перед ним мост ставит плашки цен.
          -->
          <div class="oe_title pmk-spec-title">
            <h1>
              <span class="pmk-spec-title__new" invisible="id">Новый расчёт</span>
              <field name="name" readonly="1" invisible="not id"/>
              <span class="pmk-spec-title__from">от</span>
              <field name="date" widget="pmk_long_date" class="pmk-spec-title__date"/>
            </h1>
          </div>
          <!--
            Шапка: ввод слева, итоги справа карточками. Итог документа — его
            главное число, а раньше он был набран тем же кеглем, что
            примечание. Сетка 2/1 вместо штатных 50/50: полям ввода нужна
            ширина, числам нет. Оформление приёмом темы (.pmk-kpi), чтобы
            доборка и будущие документы выглядели так же.
          -->
          <!--
            Раскладка ШТАТНОЙ структурой Odoo — вложенные группы дают две
            колонки сами. Раньше она держалась на нашем CSS, и стоило
            таблице стилей отстать от разметки (Odoo — одностраничное
            приложение, вью оно перечитывает, а стили нет), как поля
            разъезжались. Теперь без стилей это просто обычная форма Odoo.
          -->
          <div class="pmk-doc-head">
            <!--
              Порядок шапки (приёмка 01.10.2026, R2/R3): Сделка (во всю
              ширину) → Клиент | Контактное лицо → Предмет КП (во всю
              ширину) → Цены на дату | Организация. Сделку ставит pmk_deal,
              цены и организацию — pmk_bridge: они встают по ИМЕНАМ блоков
              (name="pmk_f_…"), а не в конец контейнера. Иначе порядок решала
              очерёдность загрузки модулей, и «Сделка» оказывалась последней.
              Дата документа — в заголовке, после номера (R3); блока
              pmk_f_date больше нет — pmk_bridge встаёт после pmk_f_note.
              ⚠️ Имена блоков — опора для xpath других модулей. Не менять.
            -->
            <div class="pmk-doc-head__fields">
              <!-- Клиент и контактное лицо — в одну строку, по половине
                   (R2): в контакте теперь только имя человека, и обе строки
                   помещаются. -->
              <div class="pmk-field" name="pmk_f_partner">
                <label for="partner_id"/>
                <field name="partner_id" nolabel="1"/>
              </div>
              <!-- Контактное лицо — человек у клиента; клиент — компания
                   (разбор UX, шаг 11). Печатается в КП (имя, должность,
                   телефон — поля человека, не display_name).
                   partner_display_name_hide_company — штатный ключ ядра
                   (res.partner._get_complete_name; CRM ставит его так же на
                   «Контакт» сделки): в поле «Цыганов Михаил Анатольевич», а
                   не «ООО «Арестак-Строй», Цыганов…» (R2). Только для этого
                   поля: ключ живёт в контексте поля, display_name в других
                   местах прежний. -->
              <div class="pmk-field" name="pmk_f_contact">
                <label for="contact_id"/>
                <field name="contact_id" nolabel="1"
                       context="{'default_parent_id': partner_id, 'partner_display_name_hide_company': True}"/>
              </div>
              <!-- Подпись короче названия поля (разбор UX, шаг 27): подписи
                   теперь слева и в одну строку, «Предмет КП (видит клиент)»
                   раздула бы колонку подписей всей шапки. «Видит клиент» —
                   в подсказке «?» (описание поля: печатается в КП строкой
                   «Предмет»). Название поля в списке, поиске и выгрузке
                   прежнее; печать КП берёт свою подпись «Предмет:». -->
              <div class="pmk-field pmk-field--wide" name="pmk_f_note">
                <label for="note" string="Предмет КП"/>
                <field name="note" nolabel="1"
                       placeholder="Например: металлоконструкции для ОФ «Солнечная», п. Горный"/>
              </div>

            </div>

            <!--
              Две равные плашки, под ними счётчики строкой: в группе полей
              они добавляли лишние ряды и тянули шапку вниз.
            -->
            <div class="pmk-kpi">
              <!-- Вес — одной карточкой: тонны крупно, килограммы мелко
                   под ними. Было две карточки с одним и тем же числом
                   (Антон, 28.09.2026: «два окна общий вес кг и тн, как
                   будто можно грамотно объединить»). -->
              <div class="pmk-kpi__card">
                <div class="pmk-kpi__label">Общий вес, т</div>
                <div class="pmk-kpi__value">
                  <field name="total_weight_t" digits="[12,3]"/>
                </div>
                <div class="pmk-kpi__sub">
                  <field name="total_weight" digits="[12,1]"/> кг
                </div>
              </div>
              <div class="pmk-kpi__note">
                <span>Изделий:</span><field name="total_products"/>
                <span class="pmk-kpi__dot">·</span>
                <span>Деталей:</span><field name="total_details"/>
              </div>
            </div>
          </div>

          <!--
            Изделия раскрываются в форму: внутри у каждого две таблицы деталей,
            в строку списка они не помещаются.
          -->
          <!--
            Свой виджет списка: под каждым изделием раскрывается его состав,
            и прямо там же состав правится.

            У вложенных наборов СВОЯ разметка и пометка optional="hide", хотя
            колонками они не работают. Так пришлось сделать из-за поведения
            Odoo: содержимое набора НЕ запрашивается у сервера, если колонка
            помечена постоянно невидимой (getFieldsSpec пропускает такие поля).
            Именно поэтому состав раньше приходил пустыми заглушками —
            calc_mode: false, qty: 0 — счётчик верен, а состав пуст.

            optional="hide" прячет колонку не модификатором, а пользовательской
            настройкой, под это ограничение не попадает и ничего не ломает:
            колонка скрыта, поля читаются. Плата — четыре строки в меню выбора
            колонок списка — им дали говорящие названия, чтобы включивший
            понимал, что это состав, а не отдельное свойство изделия.
            Разметка внутри задаёт, что читать и что править.
          -->
          <notebook>
            <page string="Состав" name="composition">
              <field name="product_ids" widget="pmk_product_lines" class="pmk-rows">
                <list>
                  <field name="line_linear_ids" optional="hide" string="Состав: прокат">
                    <list>
                      <field name="sequence"/>
                      <field name="calc_mode"/>
                      <field name="detail_name"/>
                      <field name="type_id"/>
                      <field name="profile_id"/>
                      <field name="length_mm"/>
                      <field name="qty"/>
                      <field name="weight_one" readonly="1"/>
                      <field name="weight_total" readonly="1"/>
                    </list>
                  </field>
                  <field name="line_sheet_ids" optional="hide" string="Состав: лист">
                    <list>
                      <!-- Раскладка: объявлены, чтобы данные читались; показываются
                           по выбору пользователя через настройку колонок. -->
                      <field name="layout_sheet_size" optional="show"/>
                      <field name="layout_state" optional="hide"/>
                      <field name="layout_per_sheet" optional="hide"/>
                      <field name="layout_sheets" optional="hide" sum="Листов"/>
                      <field name="layout_scheme" optional="hide"/>
                      <field name="layout_utilization_pct" optional="hide"/>
                      <field name="sequence"/>
                      <field name="calc_mode"/>
                      <field name="detail_name"/>
                      <field name="sheet_id"/>
                      <field name="a_mm"/>
                      <field name="b_mm"/>
                      <field name="qty"/>
                      <field name="weight_one" readonly="1"/>
                      <field name="weight_total" readonly="1"/>
                    </list>
                  </field>
                  <field name="line_fastener_ids" optional="hide" string="Состав: метизы">
                    <list>
                      <field name="sequence"/>
                      <field name="calc_mode"/>
                      <field name="detail_name"/>
                      <field name="fastener_id"/>
                      <field name="qty"/>
                      <field name="weight_one" readonly="1"/>
                      <field name="weight_total" readonly="1"/>
                    </list>
                  </field>
                  <field name="line_paint_ids" optional="hide" string="Состав: покрытие">
                    <list>
                      <field name="sequence"/>
                      <field name="calc_mode"/>
                      <field name="detail_name"/>
                      <field name="paint_id"/>
                      <field name="area_m2"/>
                      <field name="paint_thickness_um"/>
                      <field name="qty"/>
                      <field name="weight_one" readonly="1"/>
                      <field name="weight_total" readonly="1"/>
                    </list>
                  </field>
                  <field name="sequence" widget="handle"/>
                  <field name="name"/>
                  <field name="qty"/>
                  <!-- Вес с одним знаком (разбор UX, шаг 24), как карточка
                       веса над таблицей: «15 210,2», а не «15 210,184». Итог
                       внизу берёт те же знаки (pmk_theme, list_table_rules.js). -->
                  <field name="weight_one" readonly="1" digits="[12,1]"/>
                  <field name="weight_total" readonly="1" digits="[12,1]" sum="Итого, кг"/>
                  <field name="note" optional="hide"/>
                  <!-- Своя подпись вместо штатного «Добавить строку»: строка
                       документа здесь — изделие, так и называем. -->
                  <control>
                    <create string="Добавить изделие"/>
                  </control>
                </list>
                <form string="Изделие">
                  <group>
                    <group>
                      <field name="name" placeholder="Например: Ферма ФС-1"/>
                      <field name="qty"/>
                    </group>
                    <group>
                      <field name="weight_one" readonly="1" digits="[12,1]"/>
                      <field name="weight_total" readonly="1" digits="[12,1]"/>
                      <field name="note"/>
                    </group>
                  </group>

                  <notebook>
                    <page string="Прокат" name="linear">
                      <field name="line_linear_ids" context="{'default_calc_mode': 'linear'}">
                        <list editable="bottom">
                          <field name="sequence" widget="handle"/>
                          <field name="calc_mode" column_invisible="1"/>
                          <field name="detail_name"/>
                          <field name="type_id" options="{'no_create': True}"/>
                          <!-- Типоразмеры показываем только выбранного вида -->
                          <field name="profile_id" options="{'no_create': True}"
                                 domain="[('type_id', '=', type_id)]"/>
                          <!-- Миллиметры без хвоста «,0» (шаг 24): «2 500», а
                               дробная длина остаётся дробной — «2 500,5». -->
                          <field name="length_mm" options="{'hide_trailing_zeros': True}"/>
                          <field name="qty"/>
                          <field name="grade_id" options="{'no_create': True}" optional="hide"/>
                          <!-- Вес с одним знаком, как в списке изделий (шаг 24). -->
                          <field name="weight_one" readonly="1" digits="[12,1]"/>
                          <field name="weight_total" readonly="1" digits="[12,1]" sum="Итого, кг"/>
                        </list>
                      </field>
                    </page>

                    <page string="Метизы" name="fastener">
                      <field name="line_fastener_ids" context="{'default_calc_mode': 'fastener'}">
                        <list editable="bottom">
                          <field name="sequence" widget="handle"/>
                          <field name="calc_mode" column_invisible="1"/>
                          <field name="detail_name"/>
                          <field name="fastener_id" options="{'no_create': True}"/>
                          <field name="qty"/>
                          <!-- Вес ШТУКИ метиза — с граммами, исключение из
                               «вес с одним знаком» (шаг 24): болт и гайка весят
                               0,010–0,099 кг, с одним знаком было бы «0,0» и
                               «0,1» — читалось бы как «вес не задан». Вес
                               всего — с одним знаком, как на других вкладках. -->
                          <field name="weight_one" readonly="1" digits="[12,3]"/>
                          <field name="weight_total" readonly="1" digits="[12,1]" sum="Итого, кг"/>
                        </list>
                      </field>
                    </page>

                    <page string="Покрытие" name="paint">
                      <!--
                        Площадь подставляется из состава изделия по площади
                        погонного метра сортамента. Пока эта характеристика не
                        заполнена, площадь можно ввести руками — поле открыто.
                      -->
                      <field name="line_paint_ids" context="{'default_calc_mode': 'paint'}">
                        <list editable="bottom">
                          <field name="sequence" widget="handle"/>
                          <field name="calc_mode" column_invisible="1"/>
                          <field name="detail_name" string="Участок"/>
                          <field name="paint_id" options="{'no_create': True}"/>
                          <field name="area_m2"/>
                          <!-- Базовая подставляется из справочника; правят, когда
                               заказчик требует другую толщину плёнки. -->
                          <field name="paint_thickness_um"/>
                          <field name="qty" column_invisible="1"/>
                          <field name="weight_one" string="Расход, кг" readonly="1" digits="[12,1]"/>
                          <field name="weight_total" readonly="1" digits="[12,1]" sum="Итого, кг"/>
                        </list>
                      </field>
                    </page>

                    <page string="Лист" name="sheet">
                      <field name="line_sheet_ids" context="{'default_calc_mode': 'sheet'}">
                        <list editable="bottom">
                          <field name="sequence" widget="handle"/>
                          <field name="calc_mode" column_invisible="1"/>
                          <field name="detail_name"/>
                          <field name="sheet_id" options="{'no_create': True}"/>
                          <field name="a_mm" options="{'hide_trailing_zeros': True}"/>
                          <field name="b_mm" options="{'hide_trailing_zeros': True}"/>
                          <field name="qty"/>
                          <field name="grade_id" options="{'no_create': True}" optional="hide"/>
                          <field name="weight_one" readonly="1" digits="[12,1]"/>
                          <field name="weight_total" readonly="1" digits="[12,1]" sum="Итого, кг"/>
                        </list>
                      </field>
                    </page>
                  </notebook>
                </form>
              </field>
            </page>

            <!--
              РАСКЛАДКА ОТДЕЛЬНОЙ ВКЛАДКОЙ, А НЕ КОЛОНКАМИ В СОСТАВЕ.
              Раньше предварительный расчёт писал результат в колонки списка,
              скрытые по умолчанию: кнопка отрабатывала, а на экране не
              менялось ничего — и выглядела неработающей. Решение владельца
              25.09.2026: дополнительные сведения о документе живут вкладками.

              Здесь только листовые детали: у проката своя задача — раскрой
              хлыстов, он считается другим калькулятором.
            -->
            <!--
              Кнопка раскладки — здесь, над своим результатом (разбор UX,
              шаг 32). Контурная: залитая на экране одна — «КП (PDF)».
              Нажатие — осознанный шаг: увидел число листов и решаешь, нести
              технологу или закладывать как есть. В себестоимость КП это
              число не идёт, там чистый вес справочника.

              Колонки (шаг 32): 11 → 8. «Изделие», «Схема» и «Состояние» —
              в меню колонок; A и B — одной колонкой «Размер, мм» (П-25);
              процент — подписью со словом, мало — жёлтым, очень мало —
              красным (sheeting.sheet_use_label). Уровень для цвета —
              служебной колонкой: простое поле, column_invisible его не режет.
            -->
            <page string="Раскладка" name="layout">
              <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                <button name="action_draft_layout" type="object"
                        string="Разложить листы (черновик)" class="btn btn-secondary"
                        invisible="not sheet_line_ids"
                        title="Сколько заготовок влезает в лист и сколько листов купить. Результат — в таблице ниже и в истории документа"/>
                <span class="text-muted" invisible="not sheet_line_ids">
                  Сколько листов купить под заказ. Верхняя оценка: технолог
                  уложит плотнее и объединит детали на одном листе.
                </span>
                <span class="text-muted" invisible="sheet_line_ids">
                  Листовых деталей нет — раскладывать нечего. Лист
                  добавляется в составе изделия; новые детали появятся здесь
                  после сохранения.
                </span>
              </div>
              <field name="sheet_line_ids" readonly="0">
                <list editable="bottom" create="0" delete="0">
                  <field name="product_id" readonly="1" optional="hide"/>
                  <field name="detail_name" readonly="1" string="Деталь"/>
                  <field name="sheet_id" readonly="1"/>
                  <field name="detail_size_label" readonly="1" string="Размер, мм"/>
                  <field name="qty" readonly="1"/>
                  <!-- Габарит правится как прежде. ⚠️ Мина 1500×6000:
                       цены заведены на этот габарит, второй вариант листа
                       обнулит вес карточки — не трогаем (память
                       project_sheet_size_trap). -->
                  <field name="layout_sheet_size" string="Габарит"/>
                  <field name="layout_per_sheet" readonly="1" string="В листе"/>
                  <field name="layout_sheets" readonly="1" sum="Листов" string="Листов"/>
                  <field name="layout_scheme" readonly="1" string="Схема" optional="hide"/>
                  <field name="layout_use_label" readonly="1" string="Использование"
                         widget="badge" class="pmk-sheet-use"
                         decoration-warning="layout_use_level == 'low'"
                         decoration-danger="layout_use_level == 'bad'"/>
                  <field name="layout_use_level" column_invisible="1"/>
                  <field name="layout_state" readonly="1" optional="hide"/>
                </list>
              </field>
            </page>
          </notebook>

          <!--
            Состав всех изделий сразу, с раскрытием. Список изделий выше
            остаётся местом ввода, а этот блок — местом чтения: посмотреть,
            из чего собрано, не заходя в каждое изделие.
          -->
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_metal_spec_list" model="ir.ui.view">
    <field name="name">pmk.metal.spec.list</field>
    <field name="model">pmk.metal.spec</field>
    <field name="arch" type="xml">
      <list string="Спецификации">
        <!-- Номер расчёта не обрезается никогда (разбор UX, шаг 2): без
             ширины Odoo отдавал место клиенту и сделке, и «СМ-00024»
             превращался в «СМ-00…» (29.09.2026). -->
        <field name="name" width="105px"/>
        <field name="date"/>
        <field name="partner_id"/>
        <!-- Разбор UX, шаг 25: «Предмет КП» — единственное, по чему расчёт
             узнаётся глазами («Ангар 24×60», «Опоры КС»); «Контактное лицо»
             — в меню колонок (⚙). «Изделий» — туда же: число без названий
             ничего не говорит. Сделка (pmk_deal) встаёт сразу за клиентом. -->
        <field name="note" string="Предмет КП" optional="show"/>
        <field name="contact_id" optional="hide"/>
        <field name="total_products" optional="hide"/>
        <!-- Вес — в тоннах, до килограмма (разбор UX, шаг 24): «50,939 т»
             вместо «50 938,926 кг» с граммами. Килограммы повторяли то же
             число и забирали ширину у денег — ушли в меню колонок (⚙), без
             граммов. Под pmk_bridge (view_metal_spec_list_cost) после «т»
             встают деньги: колонка «т» видна всегда, скрытие там снято. -->
        <field name="total_weight" string="Вес, кг" digits="[12,0]" sum="Итого, кг" optional="hide"/>
        <field name="total_weight_t" string="Вес, т" digits="[12,3]" sum="Итого, т"/>
      </list>
    </field>
  </record>

  <record id="view_metal_spec_search" model="ir.ui.view">
    <field name="name">pmk.metal.spec.search</field>
    <field name="model">pmk.metal.spec</field>
    <field name="arch" type="xml">
      <search>
        <!-- Номер, клиент и содержимое: спецификацию ищут по всем трём —
             по номеру из переписки, по клиенту и «где мы считали уголок». -->
        <field name="name" string="Номер"/>
        <field name="partner_id" string="Клиент"/>
        <field name="note"/>
        <field name="product_ids" string="Изделие"
               filter_domain="[('product_ids.name', 'ilike', self)]"/>

        <filter name="this_month" string="Этот месяц"
                domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
        <filter name="this_year" string="Этот год"
                domain="[('date', '&gt;=', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
        <separator/>
        <!-- Порог в тонну отделяет рабочие расчёты от прикидок на пару деталей. -->
        <filter name="heavy" string="От 1 тонны" domain="[('total_weight', '&gt;=', 1000)]"/>
        <filter name="no_partner" string="Без клиента" domain="[('partner_id', '=', False)]"/>

        <group>
          <filter name="by_partner" string="Клиент" context="{'group_by': 'partner_id'}"/>
          <filter name="by_date" string="Дата" context="{'group_by': 'date'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_metal_spec" model="ir.actions.act_window">
    <field name="name">Расчёт металлопроката</field>
    <field name="res_model">pmk.metal.spec</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Создайте первый расчёт</p>
      <p>Спецификация состоит из изделий, у каждого своё количество.
         Вес детали умножается и на количество в изделии, и на количество изделий.</p>
    </field>
  </record>

</odoo>
