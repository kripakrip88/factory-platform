<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="view_metal_spec_form" model="ir.ui.view">
    <field name="name">pmk.metal.spec.form</field>
    <field name="model">pmk.metal.spec</field>
    <field name="arch" type="xml">
      <form string="Спецификация">
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group>
              <field name="partner_id"/>
              <field name="date"/>
            </group>
            <group>
              <field name="total_positions"/>
              <field name="total_weight" widget="float" digits="[12,3]"/>
            </group>
          </group>
          <field name="note" placeholder="Примечание к спецификации…"/>

          <!--
            Поля разных видов проката лежат в одной строке и показываются по
            выбранному виду. Так таблица остаётся одной: у линейного проката
            спрашиваем длину, у листа две стороны — разводить это на три
            отдельные таблицы значило бы заставлять считать в трёх местах.
          -->
          <field name="line_ids">
            <list editable="bottom">
              <field name="sequence" widget="handle"/>
              <field name="detail_name"/>
              <field name="calc_mode"/>
              <field name="profile_id" column_invisible="0"
                     invisible="calc_mode != 'linear'"
                     options="{'no_create': True}"/>
              <field name="sheet_id"
                     invisible="calc_mode != 'sheet'"
                     options="{'no_create': True}"/>
              <field name="vgp_id"
                     invisible="calc_mode != 'vgp'"
                     options="{'no_create': True}"/>
              <field name="length_mm" invisible="calc_mode == 'sheet'"/>
              <field name="a_mm" invisible="calc_mode != 'sheet'"/>
              <field name="b_mm" invisible="calc_mode != 'sheet'"/>
              <field name="qty"/>
              <field name="grade_id" options="{'no_create': True}" optional="show"/>
              <field name="weight_one" readonly="1"/>
              <field name="weight_total" readonly="1" sum="Итого, кг"/>
              <field name="size_label" column_invisible="1"/>
            </list>
          </field>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_metal_spec_list" model="ir.ui.view">
    <field name="name">pmk.metal.spec.list</field>
    <field name="model">pmk.metal.spec</field>
    <field name="arch" type="xml">
      <list string="Спецификации">
        <field name="name"/>
        <field name="date"/>
        <field name="partner_id"/>
        <field name="total_positions"/>
        <field name="total_weight" sum="Итого, кг"/>
      </list>
    </field>
  </record>

  <record id="view_metal_spec_search" model="ir.ui.view">
    <field name="name">pmk.metal.spec.search</field>
    <field name="model">pmk.metal.spec</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="partner_id"/>
        <group>
          <filter name="by_partner" string="Клиент" context="{'group_by': 'partner_id'}"/>
          <filter name="by_date" string="Дата" context="{'group_by': 'date'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_metal_spec" model="ir.actions.act_window">
    <field name="name">Расчёт металлопроката</field>
    <field name="res_model">pmk.metal.spec</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Создайте первый расчёт</p>
      <p>Вес считается по табличным значениям ГОСТ: выберите профиль,
         укажите длину в миллиметрах и количество.</p>
    </field>
  </record>

</odoo>
