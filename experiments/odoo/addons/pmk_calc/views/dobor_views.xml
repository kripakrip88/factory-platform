<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="view_dobor_order_form" model="ir.ui.view">
    <field name="name">pmk.dobor.order.form</field>
    <field name="model">pmk.dobor.order</field>
    <field name="arch" type="xml">
      <!-- pmk-doc-form — подписи шапки слева, как в штатных формах (разбор
           UX, шаг 27; pmk_theme, forms_nexus.scss, раздел 9). Окно позиции
           ниже — своя форма в своём диалоге, класс до неё не доходит. -->
      <form string="Заказ доборки" class="pmk-doc-form">
        <header>
          <button name="action_print_sheet" type="object" string="Печать листа"
                  class="btn-primary" icon="fa-print"/>
          <!-- statusbar_visible — путь стадий для кнопки-выпадашки темы
               (деления и галочки пройденных, разбор UX, шаг 4). -->
          <field name="state" widget="statusbar" options="{'clickable': 1}"
                 statusbar_visible="draft,confirmed,done"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <!--
            Шапка тем же приёмом, что и в спецификации: ввод слева, итоги
            справа карточками. Ведущее число здесь — планки: это то, что
            цех делает. Материал (площадь и вес) собран во второй карточке.
          -->
          <!--
            Шапка тем же приёмом, что в спецификации: поля слева, две равные
            плашки справа. Ведущие числа — планки (это делает цех) и вес.
            Позиции и площадь стоят слева: во второй ряд плашек они вытянули
            бы шапку вниз.
          -->
          <div class="pmk-doc-head">
            <!--
              Разбор UX, шаг 35 (02.10.2026): «Клиент» — полем-контрагентом,
              текст — «Изделие / объект» во всю ширину. Порядок: Клиент | Дата
              → Изделие / объект. «Сделку» ставит pmk_deal перед клиентом —
              по имени блока pmk_f_partner, как у расчёта (views/dobor_views.xml
              в pmk_deal). ⚠️ Имена блоков pmk_f_* — опора для xpath, не менять.
            -->
            <div class="pmk-doc-head__fields">
              <div class="pmk-field" name="pmk_f_partner">
                <label for="partner_id"/>
                <field name="partner_id" nolabel="1"/>
              </div>
              <div class="pmk-field" name="pmk_f_date">
                <label for="order_date"/>
                <field name="order_date" nolabel="1"/>
              </div>
              <div class="pmk-field pmk-field--wide" name="pmk_f_customer">
                <label for="customer"/>
                <field name="customer" nolabel="1" placeholder="На какое изделие или объект"/>
              </div>
            </div>

            <div class="pmk-kpi">
              <div class="pmk-kpi__card">
                <div class="pmk-kpi__label">Планок, шт</div>
                <div class="pmk-kpi__value">
                  <field name="total_qty"/>
                </div>
              </div>
              <div class="pmk-kpi__card">
                <div class="pmk-kpi__label">Общий вес, кг</div>
                <!-- Один знак, как у веса в строках и в итоге таблицы ниже
                     (разбор UX, шаг 24): одно число на экране дважды —
                     с одной точностью. -->
                <div class="pmk-kpi__value">
                  <field name="total_weight" digits="[12,1]"/>
                </div>
              </div>
              <div class="pmk-kpi__note">
                <span>Позиций:</span><field name="total_positions"/>
                <span class="pmk-kpi__dot">·</span>
                <span>Площадь, м²:</span><field name="total_area" digits="[12,2]"/>
              </div>
            </div>
          </div>
          <!--
            Список НЕ редактируемый в строке намеренно: у доборки каждая
            позиция требует нарисовать профиль, а построитель живёт в форме.
            В editable-режиме Odoo правит ячейки и форму не открывает — тогда
            до построителя просто не добраться.
          -->
          <field name="line_ids" class="pmk-rows">
            <list>
              <field name="sequence" widget="handle"/>
              <!-- Эскиз первым: профиль узнают по силуэту быстрее, чем по названию. -->
              <field name="sketch" widget="pmk_svg" string="Профиль" optional="show"/>
              <field name="title"/>
              <field name="coating_id"/>
              <field name="sheet_id" options="{'no_create': True}" required="1"/>
              <!-- Миллиметры без хвоста «,0» / «,00» (разбор UX, шаг 24):
                   «2 500», «312,5» — дробное остаётся дробным. -->
              <field name="plank_length" options="{'hide_trailing_zeros': True}"/>
              <field name="qty"/>
              <field name="developed_width" readonly="1" options="{'hide_trailing_zeros': True}"/>
              <field name="bends" readonly="1" optional="show"/>
              <field name="strips" readonly="1" optional="hide"/>
              <field name="strip_waste" readonly="1" optional="hide" options="{'hide_trailing_zeros': True}"/>
              <!-- Вес с одним знаком (шаг 24): «66,7», не «66,725». Итог
                   берёт те же знаки (pmk_theme/static/src/js/list_table_rules.js)
                   и совпадает с карточкой «Общий вес, кг» над таблицей. -->
              <field name="weight_total" readonly="1" digits="[12,1]" sum="Итого, кг"/>
              <!-- «Копировать» (приёмка 01.10.2026, R9b): копия позиции встаёт
                   сразу под исходной — тот же профиль, покрытие, металл и
                   количество; дальше меняют размеры. Работает и у ещё не
                   сохранённого заказа (копия делается в браузере, см.
                   static/src/js/dobor_copy_line.js). -->
              <widget name="pmk_dobor_copy_line"/>
              <!-- Снимок профиля правится построителем, руками в него не лезут. -->
              <field name="profile_snapshot_json" column_invisible="1"/>
              <!-- Ширина рулона — служебная колонка: её берёт «Копировать»
                   (в списке её не видно, но копия должна унести её вместе с
                   позицией).
                   Толщину (thickness) сюда добавлять не нужно: с 01.10.2026
                   она считается на сервере от металла (dobor.py,
                   _compute_thickness), и копия получает её от того же металла. -->
              <field name="coil_width" column_invisible="1"/>
              <control>
                <create string="Добавить позицию"/>
              </control>
            </list>
            <!--
              Раскладка в две колонки: слева холст, справа параметры. Именно
              так было в исходном прототипе («слева холст+кнопки, справа Полки
              и гибы → Параметры доборки» — CHANGELOG модуля), и при рисовании
              это удобнее: рука с мышью на чертеже, глаз сверяет числа сбоку.
            -->
            <!--
              pmk-dialog-fullscreen — метка для static/src/js/dobor_dialog_fullscreen.js:
              окно позиции открывается во весь экран штатным размером диалога
              Odoo (size="fullscreen" → класс modal-fullscreen). В обычном окне
              холсту оставалось ~270 px и чертёж мельчал до нечитаемого. Задать
              размер прямо в разметке нельзя: диалог строки one2many
              (X2ManyFieldDialog) размер из вьюхи и контекста не читает.
              Та же метка снимает значок ядра «развернуть» (доводка шага 34):
              своей формы у позиции нет, и он открывал автоформу ядра.
            -->
            <form string="Доборка" class="pmk-dobor-form pmk-dialog-fullscreen">
              <div class="pmk-dobor-grid">
                <div class="pmk-dobor-grid__main">
                  <field name="profile_snapshot_json" widget="pmk_dobor_builder" nolabel="1"/>
                </div>

                <div class="pmk-dobor-grid__side">
                  <group string="Позиция">
                    <field name="title" placeholder="Если пусто — назовём «Доборка N»"/>
                    <!-- Покрытие можно завести прямо отсюда: цвета добавляются
                         по ходу работы, гонять человека в справочник незачем. -->
                    <field name="coating_id"/>
                    <!--
                      Цвет покрытия построитель берёт отсюда и красит им слой
                      краски на холсте. Поле невидимое, но читается: статически
                      невидимое СКАЛЯРНОЕ поле формы всё равно попадает в
                      спецификацию чтения (web, relational_model/utils.js,
                      getFieldsSpec — там invisible гасит только вложенные поля
                      x2many, как column_invisible в списках).

                      Отдельной выпадашки «Цвет / покрытие» в панели
                      построителя, как было в ERPNext, не заводим: там страница
                      была сама себе формой и выбирать цвет было больше негде,
                      а здесь покрытие стоит в соседней колонке, в паре
                      сантиметров от холста. Второе поле для одного значения —
                      ровно тот разнобой, из-за которого завальцовку и замок
                      оставили только в панели (см. ниже).
                    -->
                    <field name="coating_hex" invisible="1"/>
                    <field name="sheet_id" options="{'no_create': True}" required="1"/>
                    <field name="plank_length"/>
                    <field name="qty"/>
                    <field name="coil_width"/>
                  </group>
                  <group string="Результат">
                    <field name="developed_width" readonly="1"/>
                    <field name="bends" readonly="1"/>
                    <field name="weight_one" readonly="1" digits="[12,1]"/>
                    <field name="weight_total" readonly="1" digits="[12,1]"/>
                    <field name="strips" readonly="1"/>
                    <field name="strip_waste" readonly="1"/>
                  </group>
                </div>
              </div>

              <!-- Завальцовка и замок задаются на панели построителя, здесь
                   держим поля скрытыми: два места ввода одного и того же
                   расходятся между собой. -->
              <field name="hem_left" invisible="1"/>
              <field name="hem_right" invisible="1"/>
              <field name="hem_len" invisible="1"/>
              <field name="lock" invisible="1"/>
            </form>
          </field>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_dobor_order_list" model="ir.ui.view">
    <field name="name">pmk.dobor.order.list</field>
    <field name="model">pmk.dobor.order</field>
    <field name="arch" type="xml">
      <!-- Разбор UX, шаг 35: пустой заказ (0 позиций) — серой строкой
           целиком: черновик, который так и не заполнили. Цвет повторён
           словом — «Черновик» в статусе и «0» в «Позиций». Ничего не
           прячется и не запрещается. -->
      <list string="Заказы доборки" decoration-muted="total_positions == 0">
        <!-- Разбор UX, шаг 24: номер «ДОБ-00012» целиком и без лишней
             ширины (было 270–290 px на номер — половина таблицы пустая);
             площадь до сотых вместо «1,0950», вес без граммов. -->
        <field name="name" width="105px"/>
        <field name="order_date"/>
        <!-- Шаг 35: «Клиент» — контрагент; «Изделие / объект» — прежний
             текст. Оба в меню колонок (⚙). Ширина клиента задана: без неё
             свободное место уходит самой длинной колонке, а клиент сжимается
             до «ООО «Ар…» (как в списке сделок, шаг 25). -->
        <field name="partner_id" optional="show" width="160px"/>
        <field name="customer" optional="show"/>
        <field name="total_positions"/>
        <field name="total_qty"/>
        <field name="total_area" digits="[12,2]" sum="Площадь, м²" optional="show"/>
        <field name="total_weight" digits="[12,1]" sum="Итого, кг"/>
        <!-- «Оживить таблицы» (29.09.2026): цвет плашки — как тон кнопки стадий
             в документе (начало пути серое, в работе голубое, готово
             зелёное, тупик розовый); бледный вид плашки — тема. -->
        <!-- Ширина плашки задана (шаг 24): у виджета badge ядро не знает
             предела ширины (column_width_hook.js — минимум 80 px, максимума
             нет), и свободное место, освободившееся от номера, делилось
             между статусом и клиентом — плашка «Черновик» в колонке на
             350 px. 110 px вмещают «Изготовлен»; остальное уходит клиенту. -->
        <field name="state" widget="badge" width="110px"
               decoration-muted="state == 'draft'"
               decoration-info="state == 'confirmed'"
               decoration-success="state == 'done'"/>
      </list>
    </field>
  </record>

  <record id="view_dobor_order_search" model="ir.ui.view">
    <field name="name">pmk.dobor.order.search</field>
    <field name="model">pmk.dobor.order</field>
    <field name="arch" type="xml">
      <search>
        <!-- Поиск по номеру, клиенту и изделию: по ним заказ и ищут, когда
             звонит клиент (шаг 35: клиент — полем, текст — изделие / объект). -->
        <field name="name" string="Номер заказа"/>
        <field name="partner_id" string="Клиент"/>
        <field name="customer" string="Изделие / объект"/>
        <field name="line_ids" string="Позиция"
               filter_domain="[('line_ids.title', 'ilike', self)]"/>

        <filter name="draft" string="Черновики" domain="[('state', '=', 'draft')]"/>
        <filter name="confirmed" string="В работе" domain="[('state', '=', 'confirmed')]"/>
        <filter name="done" string="Изготовлены" domain="[('state', '=', 'done')]"/>
        <separator/>
        <!-- «Не закрытые» — то, что реально нужно цеху каждый день. -->
        <filter name="open" string="Не изготовлены" domain="[('state', '!=', 'done')]"/>
        <separator/>
        <filter name="this_month" string="Этот месяц"
                domain="[('order_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
        <filter name="this_year" string="Этот год"
                domain="[('order_date', '&gt;=', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d'))]"/>

        <group>
          <filter name="by_partner" string="Клиент" context="{'group_by': 'partner_id'}"/>
          <filter name="by_customer" string="Изделие / объект" context="{'group_by': 'customer'}"/>
          <filter name="by_state" string="Статус" context="{'group_by': 'state'}"/>
          <filter name="by_date" string="Дата" context="{'group_by': 'order_date'}"/>
        </group>
      </search>
    </field>
  </record>

  <!--
    Шаг 35: по умолчанию — «Не изготовлены»: цеху каждый день нужно то, что
    ещё не сделано (фильтр в поиске был и раньше). Изготовленные — снять
    фильтр. Пустой экран подсказывает, куда идти (правило шага 26).
  -->
  <record id="action_dobor_order" model="ir.actions.act_window">
    <field name="name">Доборные элементы</field>
    <field name="res_model">pmk.dobor.order</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_open': 1}</field>
    <field name="help" type="html">
      <p>По выбранным фильтрам заказов доборки нет.</p>
      <p>Изготовленные — снимите фильтр «Не изготовлены». Новый заказ — кнопка «Новое».</p>
    </field>
  </record>

  <!-- Шаг 35: «Цвета доборки (RAL)», а не «Покрытия»: рядом в справочниках
       «Краски (ЛКП)» расчёта, и два «покрытия» путались. Справочник — цвета,
       из которых гнут доборку (RAL и цинк). -->
  <record id="view_dobor_coating_list" model="ir.ui.view">
    <field name="name">pmk.dobor.coating.list</field>
    <field name="model">pmk.dobor.coating</field>
    <field name="arch" type="xml">
      <list string="Цвета доборки (RAL)" editable="bottom">
        <field name="name"/>
        <field name="ral_code"/>
        <field name="hex_color" widget="color"/>
      </list>
    </field>
  </record>

  <record id="view_dobor_coating_search" model="ir.ui.view">
    <field name="name">pmk.dobor.coating.search</field>
    <field name="model">pmk.dobor.coating</field>
    <field name="arch" type="xml">
      <search>
        <!-- Ищут и по названию («шоколад»), и по коду («8017») — в заявках
             клиенты пишут то одно, то другое. -->
        <field name="name"/>
        <field name="ral_code" string="Код RAL"/>
      </search>
    </field>
  </record>

  <record id="action_dobor_coating" model="ir.actions.act_window">
    <field name="name">Цвета доборки (RAL)</field>
    <field name="res_model">pmk.dobor.coating</field>
    <field name="view_mode">list</field>
  </record>

</odoo>
