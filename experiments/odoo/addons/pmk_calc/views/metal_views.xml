<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!--
    Справочники сортамента. Сотруднику даны только на чтение: это таблицы
    ГОСТ, их не правят из интерфейса — ошибка здесь тихо испортит все расчёты
    и отгрузочные документы. Права на запись есть у администратора.

    Шаг З-10: сотруднику дано право создавать — но только позицию «на разнос»
    и только из детали расчёта (строка выпадашки «Нет в справочнике — завести
    новую…»). Право создавать включило бы в этих списках «Новый» (у метизов —
    ещё и строку-добавление), поэтому у прокат / лист / метизы create="0", а
    администратору «Новый» возвращает наследование с группой
    (get_view в models/metal_pending.py). docs/disabled-features.md, З-10.
  -->

  <record id="view_metal_profile_list" model="ir.ui.view">
    <field name="name">pmk.metal.profile.list</field>
    <field name="model">pmk.metal.profile</field>
    <field name="arch" type="xml">
      <list string="Линейный прокат" create="0">
        <field name="type_id"/>
        <field name="size_label"/>
        <!-- Без итога (разбор UX, шаг 24): сумма масс погонного метра разных
             профилей ничего не значит, а внизу и в строках групп читалась как
             масса подборки. В строках групп пусто — aggregator=None в модели
             (models/metal_reference.py). -->
        <field name="mass_per_meter"/>
        <field name="gost" optional="show"/>
        <!-- Шаг З-10: позиция, заведённая из расчёта, — жёлтой меткой
             «на разнос». Пусто у обычных позиций. -->
        <field name="pmk_pending_label" string="Разнос" widget="badge"
               decoration-warning="pmk_pending_label" optional="show"/>
      </list>
    </field>
  </record>

  <record id="view_metal_profile_search" model="ir.ui.view">
    <field name="name">pmk.metal.profile.search</field>
    <field name="model">pmk.metal.profile</field>
    <field name="arch" type="xml">
      <search>
        <field name="size_label"/>
        <field name="type_id"/>
        <field name="gost"/>
        <!-- Ходовые виды вынесены кнопками: до них чаще всего и добираются. -->
        <filter name="pipe" string="Трубы" domain="[('profile_type', 'ilike', 'Труба')]"/>
        <filter name="angle" string="Уголок" domain="[('profile_type', 'ilike', 'Уголок')]"/>
        <filter name="channel" string="Швеллер" domain="[('profile_type', 'ilike', 'Швеллер')]"/>
        <filter name="beam" string="Двутавр" domain="[('profile_type', 'ilike', 'Двутавр')]"/>
        <filter name="rebar" string="Арматура" domain="[('profile_type', 'ilike', 'Арматура')]"/>
        <separator/>
        <!-- Шаг З-10: «на разнос» и привязанные (в архиве). -->
        <filter name="pmk_pending" string="На разнос" domain="[('pmk_pending', '=', True)]"/>
        <filter name="pmk_archived" string="Архив" domain="[('active', '=', False)]"/>
        <group>
          <filter name="by_type" string="Вид проката" context="{'group_by': 'type_id'}"/>
          <filter name="by_gost" string="Стандарт" context="{'group_by': 'gost'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_metal_profile" model="ir.actions.act_window">
    <field name="name">Линейный прокат</field>
    <field name="res_model">pmk.metal.profile</field>
    <field name="view_mode">list</field>
    <field name="context">{'search_default_by_type': 1}</field>
  </record>

  <record id="view_metal_sheet_list" model="ir.ui.view">
    <field name="name">pmk.metal.sheet.list</field>
    <field name="model">pmk.metal.sheet</field>
    <field name="arch" type="xml">
      <list string="Лист" create="0">
        <field name="sheet_type"/>
        <!-- Шаг 24: толщина без хвоста нулей — «0,35», «4», «60», а не
             «4,00». Итога «кг/м²» больше нет: сумма масс квадратного метра
             листов разной толщины ничего не значит. -->
        <field name="thickness_mm" options="{'hide_trailing_zeros': True}"/>
        <field name="mass_per_sqm"/>
        <field name="gost" optional="show"/>
        <field name="pmk_pending_label" string="Разнос" widget="badge"
               decoration-warning="pmk_pending_label" optional="show"/>
      </list>
    </field>
  </record>

  <record id="view_metal_sheet_search" model="ir.ui.view">
    <field name="name">pmk.metal.sheet.search</field>
    <field name="model">pmk.metal.sheet</field>
    <field name="arch" type="xml">
      <search>
        <field name="sheet_type"/>
        <field name="thickness_mm"/>
        <field name="gost"/>
        <!-- Тонкий прокат ищут отдельно: из него гнут доборку, и в общем
             списке он теряется среди конструкционного листа. -->
        <filter name="thin" string="Тонколистовой (до 2 мм)" domain="[('thickness_mm', '&lt;=', 2)]"/>
        <filter name="thick" string="Конструкционный (от 2 мм)" domain="[('thickness_mm', '&gt;', 2)]"/>
        <separator/>
        <filter name="smooth" string="Гладкий" domain="[('sheet_type', '=', 'Гладкий')]"/>
        <filter name="galv" string="Оцинкованный" domain="[('sheet_type', 'like', 'Оцинкованный')]"/>
        <separator/>
        <filter name="pmk_pending" string="На разнос" domain="[('pmk_pending', '=', True)]"/>
        <filter name="pmk_archived" string="Архив" domain="[('active', '=', False)]"/>
        <group>
          <filter name="by_type" string="Вид листа" context="{'group_by': 'sheet_type'}"/>
          <filter name="by_gost" string="Стандарт" context="{'group_by': 'gost'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_metal_grade_search" model="ir.ui.view">
    <field name="name">pmk.metal.grade.search</field>
    <field name="model">pmk.metal.grade</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="standard"/>
        <filter name="is_default" string="По умолчанию" domain="[('is_default', '=', True)]"/>
        <group>
          <filter name="by_standard" string="Стандарт" context="{'group_by': 'standard'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_metal_sheet" model="ir.actions.act_window">
    <field name="name">Лист</field>
    <field name="res_model">pmk.metal.sheet</field>
    <field name="view_mode">list</field>
    <field name="context">{'search_default_by_type': 1}</field>
  </record>

<!--
    <field name="name">pmk.metal.vgp.list</field>
    <field name="model">pmk.metal.vgp</field>
    <field name="arch" type="xml">
      <list string="Трубы ВГП">
        <field name="du"/>
        <field name="outer_mm"/>
        <field name="wall_mm"/>
        <field name="mass_per_meter" sum="Итого кг/м"/>
      </list>
    </field>
  </record>

  <record id="action_metal_vgp" model="ir.actions.act_window">
    <field name="name">Трубы ВГП</field>
    <field name="res_model">pmk.metal.vgp</field>
    <field name="view_mode">list</field>
  </record>

-->

  <record id="view_metal_grade_list" model="ir.ui.view">
    <field name="name">pmk.metal.grade.list</field>
    <field name="model">pmk.metal.grade</field>
    <field name="arch" type="xml">
      <list string="Марки стали">
        <field name="name"/>
        <field name="standard"/>
        <field name="is_default"/>
      </list>
    </field>
  </record>

  <record id="action_metal_grade" model="ir.actions.act_window">
    <field name="name">Марки стали</field>
    <field name="res_model">pmk.metal.grade</field>
    <field name="view_mode">list</field>
  </record>


  <record id="view_metal_fastener_list" model="ir.ui.view">
    <field name="name">pmk.metal.fastener.list</field>
    <field name="model">pmk.metal.fastener</field>
    <field name="arch" type="xml">
      <list string="Метизы" editable="bottom" create="0">
        <field name="fastener_type"/>
        <field name="name"/>
        <field name="size_label"/>
        <field name="gost" optional="show"/>
        <field name="weight_kg"/>
        <field name="pmk_pending_label" string="Разнос" widget="badge"
               decoration-warning="pmk_pending_label" optional="show" readonly="1"/>
      </list>
    </field>
  </record>

  <record id="view_metal_fastener_search" model="ir.ui.view">
    <field name="name">pmk.metal.fastener.search</field>
    <field name="model">pmk.metal.fastener</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="size_label"/>
        <filter name="pmk_pending" string="На разнос" domain="[('pmk_pending', '=', True)]"/>
        <filter name="pmk_archived" string="Архив" domain="[('active', '=', False)]"/>
        <group>
          <filter name="by_type" string="Вид" context="{'group_by': 'fastener_type'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_metal_fastener" model="ir.actions.act_window">
    <field name="name">Метизы</field>
    <field name="res_model">pmk.metal.fastener</field>
    <field name="view_mode">list</field>
    <field name="context">{'search_default_by_type': 1}</field>
  </record>

  <record id="view_paint_coating_list" model="ir.ui.view">
    <field name="name">pmk.paint.coating.list</field>
    <field name="model">pmk.paint.coating</field>
    <field name="arch" type="xml">
      <list string="Краски (ЛКП)" editable="bottom">
        <field name="paint_type"/>
        <field name="name"/>
        <field name="color"/>
        <field name="consumption"/>
        <field name="base_thickness_um"/>
        <field name="layers"/>
      </list>
    </field>
  </record>

  <!-- Разбор UX, шаг 35: «Краски (ЛКП)» — пункт меню и заголовок экрана
       (было «Лакокрасочные покрытия», рядом — «Покрытия доборки»). -->
  <record id="action_paint_coating" model="ir.actions.act_window">
    <field name="name">Краски (ЛКП)</field>
    <field name="res_model">pmk.paint.coating</field>
    <field name="view_mode">list</field>
  </record>

</odoo>
