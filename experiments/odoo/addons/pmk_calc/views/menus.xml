<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    Раздел называется «Калькуляторы», а не «Модули»: в Odoo модуль — это
    служебное понятие (аддон, который ставят в настройках), и сотрудник,
    увидев такой пункт, пойдёт туда за настройками, а не за расчётом.

    Пока внутри только справочники — сами калькуляторы добавятся следующими
    пунктами, поэтому «Справочники» вынесены в отдельную группу сразу,
    чтобы потом не перекладывать меню.
  -->
  <menuitem id="menu_pmk_calc" name="Калькуляторы" sequence="80"/>

  <menuitem id="menu_pmk_calc_spec" name="Расчёт металлопроката"
            parent="menu_pmk_calc" action="action_metal_spec" sequence="10"/>

  <menuitem id="menu_pmk_calc_dobor" name="Доборные элементы"
            parent="menu_pmk_calc" action="action_dobor_order" sequence="20"/>

  <menuitem id="menu_pmk_calc_reference" name="Справочники"
            parent="menu_pmk_calc" sequence="90"/>

  <!-- Шаг З-10: позиции, заведённые из расчёта («на разнос»), — первым
       пунктом справочников, только администратору: он разносит. -->
  <menuitem id="menu_pmk_calc_pending" name="Новые позиции на разнос"
            parent="menu_pmk_calc_reference" action="action_metal_pending" sequence="5"
            groups="base.group_system"/>
  <menuitem id="menu_pmk_calc_profile" name="Линейный прокат"
            parent="menu_pmk_calc_reference" action="action_metal_profile" sequence="10"/>
  <menuitem id="menu_pmk_calc_sheet" name="Лист"
            parent="menu_pmk_calc_reference" action="action_metal_sheet" sequence="20"/>
  <menuitem id="menu_pmk_calc_grade" name="Марки стали"
            parent="menu_pmk_calc_reference" action="action_metal_grade" sequence="40"/>
  <menuitem id="menu_pmk_calc_fastener" name="Метизы"
            parent="menu_pmk_calc_reference" action="action_metal_fastener" sequence="25"/>
  <!-- Разбор UX, шаг 35 (02.10.2026): «Лакокрасочные покрытия» и «Покрытия
       доборки» стояли рядом, а экран второго назывался просто «Покрытия».
       Теперь «Краски (ЛКП)» — краски расчёта металлопроката, «Цвета доборки
       (RAL)» — цвета, из которых гнут доборку. Имена — только в en_US базы
       (перевода ru_RU нет), поэтому правка в XML видна сразу после -u. -->
  <menuitem id="menu_pmk_calc_paint" name="Краски (ЛКП)"
            parent="menu_pmk_calc_reference" action="action_paint_coating" sequence="45"/>
  <menuitem id="menu_pmk_calc_coating" name="Цвета доборки (RAL)"
            parent="menu_pmk_calc_reference" action="action_dobor_coating" sequence="50"/>
</odoo>
