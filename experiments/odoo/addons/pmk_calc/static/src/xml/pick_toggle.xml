<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- «Перенести» — простая галочка, как в МоёмСкладе (Антон 13.10.2026: «экономить место»),
         щелчок по ячейке и Shift-диапазон — js/pick_toggle.js. -->
    <t t-name="pmk_calc.PmkPickCheck">
        <div class="pmk-pick-check" t-on-click="onClick">
            <CheckBox id="props.id" value="state.value" className="'d-inline-block'"
                      disabled="false" onChange.bind="onChange"/>
        </div>
    </t>

    <!-- Заголовок колонки галочек — «отметить все» (js/pick_head.js). Щелчок не
         сортирует колонку: .stop. -->
    <t t-inherit="web.ListRenderer" t-inherit-mode="extension">
        <xpath expr="//th[@t-att-data-name='column.name']/t[@t-if]" position="before">
            <div t-if="column.widget === 'pmk_pick_toggle'" class="pmk-pick-check pmk-pick-head"
                 t-att-title="pmkPickAllOn(column) ? 'Снять все отметки' : 'Отметить все строки'"
                 t-on-click.stop.prevent="() => this.pmkPickToggleAll(column)">
                <CheckBox value="pmkPickAllOn(column)" className="'d-inline-block'"
                          disabled="!props.list.records.length" onChange="() => {}"/>
            </div>
        </xpath>
    </t>
</templates>
