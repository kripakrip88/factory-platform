<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Первичное наследование: создаём СВОЙ шаблон строк на основе штатного.
    Расширение (extension) поменяло бы все списки в системе, а нужен только
    список изделий.
  -->
  <t t-name="pmk_calc.ProductRows" t-inherit="web.ListRenderer.Rows" t-inherit-mode="primary">
    <xpath expr="//t[@t-call='{{ constructor.recordRowTemplate }}']" position="after">
      <tr t-if="countLines(record)" class="pmk-prow">
        <td t-att-colspan="compositionColspan">
          <button type="button" class="pmk-prow__toggle" aria-expanded="false"
                  t-on-click.stop.prevent="(ev) => this.toggleComposition(ev, record)">
            <i class="fa fa-fw fa-angle-right"/>
            Состав: <t t-esc="linesLabel(record)"/>
          </button>
          <!-- Содержимое вставляет виджет при раскрытии: из памяти формы
               оно приходит пустыми заглушками, см. пояснение в js. -->
          <div class="pmk-prow__wrap"/>
        </td>
      </tr>
    </xpath>
  </t>

</templates>
