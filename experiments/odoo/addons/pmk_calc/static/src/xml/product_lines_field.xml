<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Первичное наследование: создаём СВОЙ шаблон строк на основе штатного.
    Расширение (extension) поменяло бы все списки в системе, а нужен только
    список изделий.
  -->
  <t t-name="pmk_calc.ProductRows" t-inherit="web.ListRenderer.Rows" t-inherit-mode="primary">
    <xpath expr="//t[@t-call='{{ constructor.recordRowTemplate }}']" position="after">
      <tr class="pmk-prow">
        <td t-att-colspan="compositionColspan">

          <!-- Кнопка, а не строка с обработчиком: так переключатель доступен
               с клавиатуры и читается как переключатель. -->
          <button type="button" class="pmk-prow__toggle" t-att-aria-expanded="isOpen(record)"
                  t-on-click.stop.prevent="() => this.toggleComposition(record)">
            <i class="fa fa-fw" t-att-class="isOpen(record) ? 'fa-angle-down' : 'fa-angle-right'"/>
            <t t-if="countLines(record)">Состав: <t t-esc="linesLabel(record)"/></t>
            <t t-else="">Состав не заполнен</t>
          </button>

          <div t-if="isOpen(record)" class="pmk-prow__wrap">

            <t t-foreach="compositionSections(record)" t-as="section" t-key="section.mode">
              <div class="pmk-prow__section" t-attf-style="--pmk-accent:{{ section.accent }}">
                <div class="pmk-prow__head">
                  <span class="pmk-prow__title" t-esc="section.title"/>
                  <span class="pmk-prow__sum">
                    <t t-esc="section.lines.length"/> поз. · <t t-esc="num(section.weight)"/> кг
                  </span>
                </div>

                <table class="pmk-prow__table">
                  <!--
                    Шапка НЕ в <thead> намеренно. Odoo раздаёт ширины колонок
                    перебором всех "thead th" внутри таблицы списка, а наши
                    таблицы лежат внутри его строки — заголовки состава
                    попадали в тот же перебор и получали чужие ширины. Хуже
                    того, от раскрытия состава менялось их число, и Odoo
                    пересчитывал ширины самого списка изделий.
                    Ячейки остаются <th scope="col"> — для чтения с экрана
                    это по-прежнему заголовки столбцов.
                  -->
                  <tbody>
                    <tr class="pmk-prow__headrow">
                      <th scope="col" class="pmk-c-detail">Деталь</th>
                      <th scope="col" class="pmk-c-what">Позиция</th>
                      <th scope="col" class="pmk-c-size">Размеры</th>
                      <th scope="col" class="pmk-num pmk-c-qty">Кол-во</th>
                      <th scope="col" class="pmk-num pmk-c-weight">Вес, кг</th>
                      <th scope="col" class="pmk-c-act"><span class="visually-hidden">Действия</span></th>
                    </tr>
                    <t t-foreach="section.lines" t-as="line" t-key="line.id">

                      <!-- Чтение. Клик по строке открывает её редактор —
                           так же, как строка изделия открывает изделие. -->
                      <tr t-if="!isEditing(line)" class="pmk-prow__row" tabindex="0"
                          t-on-click.stop="() => this.editLine(record, section, line)"
                          t-on-keydown.stop="(ev) => ['Enter',' '].includes(ev.key) &amp;&amp; this.editLine(record, section, line)">
                        <t t-set="info" t-value="describe(line)"/>
                        <td class="pmk-c-detail" t-att-title="detailOf(line)" t-esc="detailOf(line)"/>
                        <td class="pmk-c-what" t-att-title="info[0]" t-esc="info[0]"/>
                        <td class="pmk-c-size" t-esc="info[1]"/>
                        <td class="pmk-num pmk-c-qty" t-esc="qtyOf(line)"/>
                        <td class="pmk-num pmk-c-weight" t-esc="weightOf(line)"/>
                        <td class="pmk-c-act">
                          <button type="button" class="pmk-prow__del" title="Удалить деталь"
                                  aria-label="Удалить деталь"
                                  t-on-click.stop.prevent="() => this.removeLine(record, section, line)">
                            <i class="fa fa-trash-o"/>
                          </button>
                        </td>
                      </tr>

                      <!-- Правка. Поля с подписями, а не вписанные в колонки:
                           в колонку шириной 8% справочник не помещается, а
                           подпись над полем нужна и при вводе (input-labels). -->
                      <tr t-else="" class="pmk-prow__editrow">
                        <td colspan="6">
                          <div class="pmk-edit">
                            <t t-foreach="section.inputs" t-as="input" t-key="input.name">
                              <label class="pmk-edit__field"
                                     t-att-class="{ 'pmk-edit__field--wide': input.wide }">
                                <span class="pmk-edit__label" t-esc="input.label"/>
                                <!-- Позиции справочника из подсказки не заводим:
                                     опечатка не должна порождать новый сортамент.
                                     Справочники правят отдельным разделом. -->
                                <Field t-if="input.ref" record="line" name="input.name"
                                       canCreate="false" canCreateEdit="false"
                                       canQuickCreate="false"/>
                                <Field t-else="" record="line" name="input.name"/>
                              </label>
                            </t>
                            <div class="pmk-edit__actions">
                              <span class="pmk-edit__weight">
                                <t t-esc="weightOf(line)"/> кг
                              </span>
                              <button type="button" class="btn btn-sm btn-primary"
                                      t-on-click.stop.prevent="() => this.stopEdit(record, section)">Готово</button>
                              <button type="button" class="btn btn-sm btn-link pmk-edit__del"
                                      t-on-click.stop.prevent="() => this.removeLine(record, section, line)">Удалить</button>
                            </div>
                          </div>
                        </td>
                      </tr>

                    </t>
                  </tbody>
                </table>
              </div>
            </t>

            <!-- Добавление. Все четыре вида показаны всегда, в том числе когда
                 раздела ещё нет: иначе завести первую краску было бы негде. -->
            <div class="pmk-prow__add">
              <span class="pmk-prow__add-label">Добавить:</span>
              <t t-foreach="allSections" t-as="section" t-key="section.mode">
                <button type="button" class="pmk-prow__add-btn"
                        t-attf-style="--pmk-accent:{{ section.accent }}"
                        t-on-click.stop.prevent="() => this.addLine(record, section)">
                  <i class="fa fa-plus"/> <t t-esc="section.short"/>
                </button>
              </t>
            </div>

          </div>
        </td>
      </tr>
    </xpath>
  </t>

</templates>
