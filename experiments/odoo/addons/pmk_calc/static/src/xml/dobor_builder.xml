<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="pmk_calc.DoborBuilder">
    <div class="pmk-dobor" t-ref="wrap">

      <div class="pmk-dobor__bar">
        <button type="button" class="btn btn-sm btn-secondary"
                t-on-click="() => this.toggle('growEnd')"
                t-att-title="state.growEnd ? 'Полки добавляются в конец — нажмите, чтобы в начало' : 'Полки добавляются в начало — нажмите, чтобы в конец'">
          <t t-esc="state.growEnd ? 'в конец' : 'в начало'"/>
        </button>
        <!-- Вращение живёт ручкой на холсте (ниже), в панели его кнопок нет. -->
        <button type="button" class="btn btn-sm btn-secondary" t-on-click="alignFlat"
                title="Выровнять эскиз: длинную полку — горизонтально, симметричный домик — по оси симметрии">▭</button>
        <button type="button" class="btn btn-sm btn-secondary" t-on-click="mirror" title="Зеркало: завальцовка и сторона окраски тоже меняются">⇋</button>

        <span class="pmk-dobor__sep"/>

        <!--
          Чекбокс и его кнопка разворота живут ОДНОЙ группой, и кнопка есть в
          разметке всегда — просто скрыта, пока завальцовка выключена. Если
          добавлять её по месту, при каждом включении соседние подписи
          сдвигаются (правило content-jumping: под условный элемент место
          резервируют заранее).
        -->
        <span class="pmk-dobor__unit">
          <label class="pmk-dobor__check">
            <input type="checkbox" t-att-checked="state.hemLeft" t-on-change="() => this.toggle('hemLeft')"/>
            завальцовка слева
          </label>
          <button type="button" class="btn btn-sm btn-secondary pmk-dobor__flip"
                  t-att-class="{ 'pmk-dobor__flip--off': !state.hemLeft }"
                  t-att-tabindex="state.hemLeft ? 0 : -1"
                  t-on-click="() => this.flipHem('left')" title="Развернуть левую завальцовку">⮃</button>
        </span>

        <span class="pmk-dobor__unit">
          <label class="pmk-dobor__check">
            <input type="checkbox" t-att-checked="state.hemRight" t-on-change="() => this.toggle('hemRight')"/>
            справа
          </label>
          <button type="button" class="btn btn-sm btn-secondary pmk-dobor__flip"
                  t-att-class="{ 'pmk-dobor__flip--off': !state.hemRight }"
                  t-att-tabindex="state.hemRight ? 0 : -1"
                  t-on-click="() => this.flipHem('right')" title="Развернуть правую завальцовку">⮃</button>
        </span>

        <label class="pmk-dobor__check">
          длина
          <input type="number" class="pmk-dobor__num" t-att-value="state.hemLen" t-on-change="onHemLenChange"/>
        </label>

        <span class="pmk-dobor__sep"/>

        <label class="pmk-dobor__check">
          <input type="checkbox" t-att-checked="state.lock" t-on-change="() => this.toggle('lock')"/>
          замок
        </label>
        <span class="pmk-dobor__unit">
          <label class="pmk-dobor__check">
            <input type="checkbox" t-att-checked="state.paintOn" t-on-change="() => this.toggle('paintOn')"/>
            покрытие
          </label>
          <button type="button" class="btn btn-sm btn-secondary pmk-dobor__flip"
                  t-att-class="{ 'pmk-dobor__flip--off': !state.paintOn }"
                  t-att-tabindex="state.paintOn ? 0 : -1"
                  t-on-click="flipPaint" title="Сторона покрытия">↔</button>
        </span>

        <span class="pmk-dobor__sep"/>

        <button type="button" class="btn btn-sm btn-secondary" t-on-click="undo" title="Убрать последнюю полку">Отменить полку</button>
        <button type="button" class="btn btn-sm btn-secondary" t-on-click="clearAll">Очистить</button>
      </div>

      <!--
        Сцена = холст плюс ручка вращения поверх него. Обёртка нужна только
        ручке: она позиционируется по углу ХОЛСТА, а не диалога, и без своего
        относительного родителя уехала бы к краю всего построителя.
      -->
      <div class="pmk-dobor__stage">
        <!--
          Холст фиксированного размера 760x440: чертёж вписывается в него
          пересчётом масштаба, поэтому миллиметры профиля не зависят от того,
          насколько широким получилось окно.
        -->
        <svg t-ref="svg" class="pmk-dobor__canvas" viewBox="0 0 760 440"
             t-on-pointerdown="onCanvasPointerDown"
             t-on-pointermove="onCanvasPointerMove"
             t-on-pointerup="onCanvasPointerUp"
             t-on-pointerleave="onCanvasPointerUp"
             t-on-pointercancel="onCanvasPointerUp"
             t-on-lostpointercapture="onCanvasPointerUp"/>

        <!--
          Ручка вращения. Стоит на холсте, а не в панели инструментов, и это
          не про красоту: ей нужен touch-action:none, чтобы жест достался нам
          целиком, — а в панели палец, начавший прокрутку диалога и попавший на
          кнопку, вместо прокрутки крутанул бы профиль. Холст жест и так забрал
          себе (там тянут вершины), поэтому над ним ручка ни у кого ничего не
          отнимает. В построителе ERPNext она жила ровно там же.

          Обработчики висят на самой ручке: на pointerdown она захватывает
          указатель, поэтому движение и отпускание приходят сюда же, даже если
          увели курсор за пределы окна. t-on-click нужен только клавиатуре
          (Enter/Space) — мышиный клик отсекается по detail в onRotateClick,
          иначе шаг удвоился бы.
        -->
        <button type="button" class="btn btn-secondary pmk-dobor__rot" t-ref="rot"
                t-on-pointerdown="startRotate"
                t-on-pointermove="onRotateMove"
                t-on-pointerup="endRotate"
                t-on-pointercancel="cancelRotate"
                t-on-click="onRotateClick"
                title="Повернуть добор: клик — на 5° по часовой, зажать и вести вокруг ручки — на любой угол">⟳</button>
      </div>

      <!-- Правка размера по месту: клик по числу на чертеже. -->
      <input type="number" t-ref="edit" class="pmk-dobor__edit"
             t-on-keydown="onEditKeydown" t-on-blur="flushEdit"/>

      <div class="pmk-dobor__results">
        <span>Полок: <b t-esc="state.flanges"/></span>
        <span>Гибов: <b t-esc="state.bends"/></span>
        <span>Развёртка: <b t-esc="state.developed"/> мм</span>
        <span class="pmk-dobor__hint">Клик по пустому месту — новая полка, по числу — правка размера, за точку — тянуть</span>
      </div>
    </div>
  </t>

</templates>
