<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Действия над отмеченными — в строке заголовков таблицы, поверх названий
         колонок (js/pick_bar.js). .stop: щелчки не сортируют колонку. -->
    <t t-name="pmk_calc.PmkPickActions">
        <div class="pmk-pick-actions" t-on-click.stop="">
            <button type="button" class="btn btn-link pmk-pick-all pmk-pick-all--on"
                    title="Снять все отметки" t-on-click="() => this.clear()">
                <t t-esc="picked.length"/> поз.
            </button>
            <Dropdown>
                <button type="button" class="btn btn-sm btn-secondary">
                    Перенести в <i class="fa fa-caret-down ms-1" aria-hidden="true"/>
                </button>
                <t t-set-slot="content">
                    <t t-foreach="targets" t-as="t" t-key="t.key">
                        <DropdownItem onSelected="() => this.run('move', t.key)">
                            <t t-esc="t.label"/>
                        </DropdownItem>
                    </t>
                </t>
            </Dropdown>
            <button type="button" class="btn btn-sm btn-secondary" title="Копировать отмеченные"
                    aria-label="Копировать отмеченные" t-on-click="() => this.run('copy')">
                <i class="fa fa-clone" aria-hidden="true"/>
            </button>
            <button type="button" class="btn btn-sm btn-secondary" title="Удалить отмеченные"
                    aria-label="Удалить отмеченные" t-on-click="() => this.confirmDelete()">
                <i class="fa fa-trash-o" aria-hidden="true"/>
            </button>
        </div>
    </t>
</templates>
