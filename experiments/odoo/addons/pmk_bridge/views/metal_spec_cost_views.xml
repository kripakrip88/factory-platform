<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!--
    Деньги в форме расчёта металлопроката.

    Вид наследуется, а не переписывается: разметка калькулятора живёт в
    pmk_calc и продолжает работать без моста. Установлен мост — появляются
    поля цены, не установлен — форма прежняя.
  -->
  <record id="view_metal_spec_form_cost" model="ir.ui.view">
    <field name="name">pmk.metal.spec.form.cost</field>
    <field name="model">pmk.metal.spec</field>
    <field name="inherit_id" ref="pmk_calc.view_metal_spec_form"/>
    <field name="arch" type="xml">

      <!--
        Настройки расчёта — рядом с клиентом и датой, в той же колонке ввода.
        Поставщик и дата цен стоят вместе: это одна мысль «чей прайс и на
        какое число», разносить их по разным углам формы незачем.
      -->
      <xpath expr="//div[hasclass('pmk-doc-head__fields')]" position="inside">
        <div class="pmk-field">
          <label for="company_id"/>
          <field name="company_id" nolabel="1" options="{'no_create': True}"/>
        </div>
        <div class="pmk-field">
          <label for="supplier_id"/>
          <field name="supplier_id" nolabel="1"
                 placeholder="Любой, по рейтингу…"/>
        </div>
        <div class="pmk-field">
          <label for="price_date"/>
          <div class="d-flex align-items-center gap-2">
            <field name="price_date" nolabel="1"/>
            <!--
              Сигнал о том, что расчёт смотрит в архив. Дата цен замораживается
              при создании, а строка прайса выбирается по ней: после заливки
              нового прайса кнопка честно перечитает старые цены и промолчит.
              Молчание читается как «нас не задело» — поэтому говорим явно,
              красным, и рядом даём кнопку перехода.
            -->
            <span class="badge text-bg-danger" invisible="not price_stale"
                  title="Есть прайс свежее — текущие цены взяты из архива">!</span>
            <button name="action_use_latest_prices" type="object"
                    class="btn btn-sm btn-link p-0" invisible="not price_stale"
                    string="Взять свежий прайс"/>
            <field name="price_stale" invisible="1"/>
            <field name="latest_price_date" invisible="1"/>
          </div>
        </div>
        <!--
          Коэффициентов использования на форме НЕТ. Себестоимость считается по
          чистому весу справочника (решение владельца 24.09.2026), а сколько
          металла реально купить — отдельный предварительный расчёт, который
          проверяет технолог. Поля остались в модели со значением 100%: когда
          накопится статистика, доля вернётся на экран осмысленной.
        -->
      </xpath>

      <!--
        Сигнал об изменении цен. Показывается ТОЛЬКО после пересчёта и только
        если сумма действительно поменялась: постоянная плашка перестаёт
        читаться на третий день.

        Красная при росте, зелёная при удешевлении — цвет не единственный
        признак, рядом стоит знак и процент, чтобы это читалось и без цвета.
      -->
      <xpath expr="//div[hasclass('oe_title')]" position="before">
        <!--
          ⚠️ В ПЛАШКЕ ТОЛЬКО СНИМКИ, НИ ОДНОГО ЖИВОГО ПОЛЯ. Живой итог рядом с
          замороженным «было» разъезжается от первой же правки состава: текст
          «подорожал на 6%» встаёт над числами, показывающими обратное.
          Поэтому «стало» — тоже снимок, а при расхождении снимка с итогом
          сигнал гасится целиком (price_signal_stale).
        -->
        <div class="alert alert-warning mb-2" role="alert"
             invisible="price_lost_count == 0 or price_signal_stale">
          <i class="fa fa-exclamation-triangle me-1" title="Внимание" aria-hidden="true"/>
          Позиций выпало из прайса: <field name="price_lost_count" nolabel="1"
                                           class="fw-bold"/>.
          Металл всё равно придётся купить — итог занижен, а не уменьшился.
        </div>
        <div class="alert alert-danger mb-2" role="alert"
             invisible="not price_changed or cost_change_pct &lt;= 0 or price_signal_stale">
          Металл подорожал на <field name="cost_change_abs_pct" nolabel="1"
                                     class="fw-bold"/>%
          — было <field name="cost_prev_total" nolabel="1" widget="monetary"/>,
          стало <field name="cost_new_total" nolabel="1" widget="monetary"/>.
          Проверьте цену в предложении клиенту.
          <span class="ms-2 opacity-75">Пересчитано
            <field name="price_refreshed_on" nolabel="1"/>.</span>
        </div>
        <div class="alert alert-success mb-2" role="alert"
             invisible="not price_changed or cost_change_pct &gt;= 0 or price_signal_stale or price_lost_count &gt; 0">
          Металл подешевел на <field name="cost_change_abs_pct" nolabel="1"
                                     class="fw-bold"/>%
          — было <field name="cost_prev_total" nolabel="1" widget="monetary"/>,
          стало <field name="cost_new_total" nolabel="1" widget="monetary"/>.
          <span class="ms-2 opacity-75">Пересчитано
            <field name="price_refreshed_on" nolabel="1"/>.</span>
        </div>
        <field name="price_changed" invisible="1"/>
        <field name="price_signal_stale" invisible="1"/>
        <field name="cost_change_pct" invisible="1"/>
      </xpath>

      <!--
        Итоги в деньгах — теми же карточками, что и вес. Закупка стоит первой:
        это число, которое ляжет в себестоимость, а «металл в деталях» рядом
        показывает, сколько из него дошло до изделия.
      -->
      <!--
        Неполный расчёт — жёлтой плашкой над шапкой: какие позиции без цены
        и сколько весят (разбор UX, шаг 11, CA-02; Антон: «давай исправим»).
        Ничего не блокирует: КП печатается, плашка — наблюдение.
      -->
      <xpath expr="//div[hasclass('pmk-doc-head')]" position="before">
        <div class="alert pmk-price-alert mb-3" role="alert"
             invisible="not price_incomplete">
          <i class="fa fa-exclamation-triangle me-1" title="Внимание" aria-hidden="true"/>
          <strong class="me-1">Нет цены у <field name="no_price_count" nolabel="1"/> поз.:</strong>
          <field name="price_missing_text" nolabel="1"/>.
          Металл занижен, маржа завышена — проверьте цены перед отправкой КП.
        </div>
      </xpath>

      <xpath expr="//div[hasclass('pmk-kpi')]" position="inside">
        <!--
          Цена клиенту стоит ПЕРЕД металлом: для менеджера это главное число
          документа, а себестоимость — то, что он проверяет. Маржа рядом,
          потому что смысл имеет только их разница.
        -->
        <div class="pmk-kpi__card">
          <div class="pmk-kpi__label">Цена клиенту</div>
          <div class="pmk-kpi__value">
            <field name="price_customer_total" widget="monetary"/>
          </div>
        </div>
        <!--
          Процент маржи — отдельной строкой под суммой: в одной строке с
          суммой он вылезал за край карточки (Антон, 28.09.2026: «расчёт
          процента выходит за рамку»).

          Карточки «Маржа» и «Металл» — в двух вариантах: при неполном
          расчёте жёлтая рамка и пометка «без N поз.», у процента «≤» — это
          верхняя граница. Вариант переключается по price_incomplete: у
          разметки формы нет условного класса.
        -->
        <div class="pmk-kpi__card"
             invisible="price_customer_total == 0 or price_incomplete">
          <div class="pmk-kpi__label">Маржа над металлом</div>
          <div class="pmk-kpi__value">
            <field name="margin_amount" widget="monetary"/>
          </div>
          <div class="pmk-kpi__sub"><field name="margin_pct" nolabel="1"/> % от цены</div>
        </div>
        <div class="pmk-kpi__card pmk-kpi__card--warn"
             invisible="price_customer_total == 0 or not price_incomplete">
          <div class="pmk-kpi__label">Маржа над металлом</div>
          <div class="pmk-kpi__value">
            <field name="margin_amount" widget="monetary"/>
          </div>
          <div class="pmk-kpi__sub">≤ <field name="margin_pct" nolabel="1"/> % · без
            <field name="no_price_count" nolabel="1"/> поз.</div>
        </div>
        <div class="pmk-kpi__card" invisible="price_incomplete">
          <div class="pmk-kpi__label">Металл к закупке</div>
          <div class="pmk-kpi__value">
            <field name="total_cost_fact" widget="monetary"/>
          </div>
        </div>
        <div class="pmk-kpi__card pmk-kpi__card--warn" invisible="not price_incomplete">
          <div class="pmk-kpi__label">Металл к закупке</div>
          <div class="pmk-kpi__value">
            <field name="total_cost_fact" widget="monetary"/>
          </div>
          <div class="pmk-kpi__sub">занижен: без <field name="no_price_count" nolabel="1"/> поз.</div>
        </div>
        <!--
          ⚠️ ВТОРАЯ КАРТОЧКА ПОКАЗЫВАЕТСЯ, ТОЛЬКО ЕСЛИ ЕСТЬ ОТХОД.
          Себестоимость сейчас считается по чистому весу (решение владельца
          24.09.2026), поэтому «к закупке» и «в деталях» — одно и то же число,
          а «цена раскроя» всегда ноль. Два одинаковых числа рядом читаются как
          поломка: владелец так и прочитал — «такого не может быть».
          Появится отход — карточка вернётся сама.
        -->
        <div class="pmk-kpi__card" invisible="total_cost_waste == 0">
          <div class="pmk-kpi__label">Из них в деталях</div>
          <div class="pmk-kpi__value">
            <field name="total_cost_clean" widget="monetary"/>
          </div>
        </div>
        <!--
          Цена раскроя — разница между закупкой и тем, что вошло в деталь.
          Отдельной строкой, потому что это единственное место, где видно
          стоимость отхода: в сумме заказа она растворяется.
        -->
        <div class="pmk-kpi__note">
          <span invisible="total_cost_waste == 0">Цена раскроя:</span>
          <field name="total_cost_waste" widget="monetary"
                 invisible="total_cost_waste == 0"/>
          <span class="pmk-kpi__dot" invisible="total_cost_waste == 0">·</span>
          <!-- «Купить, т» — только когда отличается от веса в карточке:
               пока себестоимость по чистому весу (решение 24.09), это то же
               число, третий раз (разбор UX, CA-09). Предупреждение о
               позициях без цены переехало в плашку над шапкой (CA-02). -->
          <span invisible="not buy_weight_differs">Купить, т:</span>
          <field name="total_weight_fact_t" digits="[12,3]"
                 invisible="not buy_weight_differs"/>
          <field name="buy_weight_differs" invisible="1"/>
        </div>
        <field name="price_incomplete" invisible="1"/>
        <field name="currency_id" invisible="1"/>
      </xpath>

      <!--
        Кнопка обновления цен — в шапке листа, рядом с номером документа.
        Пересчёт ручной по замыслу: спецификация считается НА ДАТУ, и
        отправленное клиенту КП не должно менять сумму само по себе после
        заливки нового прайса.
      -->
      <xpath expr="//header" position="inside">
        <button name="action_refresh_prices" type="object"
                string="Перечитать цены" class="btn-secondary"/>
      </xpath>

      <!--
        ВКЛАДКА «ЦЕНЫ»: что изменилось и за какой период.

        Замысел владельца 25.09.2026. Колонка процента в составе не подошла:
        таблицу состава рисует свой виджет с прошитой шапкой, и место там
        занято — пять колонок уже есть. А главное, в строке состава не
        помещается то, ради чего всё затевалось: с каким прайсом сравниваем.

        Здесь сравнение с ЛЮБЫМ прайсом, а не только с последним нажатием
        кнопки: прайсы лежат рядами по датам, и «что изменилось с июня»
        считается той же арифметикой, что «что изменилось вчера».
      -->
      <xpath expr="//notebook" position="inside">
        <page string="Цены" name="prices">
          <div class="d-flex align-items-center gap-2 mb-3">
            <label for="compare_price_date" class="mb-0"/>
            <field name="compare_price_date" nolabel="1"
                   placeholder="предыдущий прайс"/>
            <!-- Пустое поле не молчит: рядом сказано, что взято по умолчанию.
                 Иначе «сравнить с ценами на ____» оставляет гадать, с чем
                 именно сравнили числа в таблице. -->
            <span class="text-muted" invisible="not compare_hint">
              <field name="compare_hint" nolabel="1" readonly="1"/>
            </span>
            <field name="compare_effective_date" invisible="1"/>
            <span class="text-muted ms-3" invisible="not price_refreshed_on">
              Перечитано <field name="price_refreshed_on" nolabel="1"
                                readonly="1"/>
            </span>
          </div>
          <field name="price_line_ids" readonly="1">
            <list create="0" delete="0" edit="0">
              <field name="detail_name" string="Деталь"/>
              <field name="position_label" string="Позиция"/>
              <field name="calc_mode" optional="hide"/>
              <field name="price_partner_id" string="Поставщик" optional="hide"/>
              <field name="price_compare_unit" string="Было" digits="[16,2]"/>
              <field name="price_unit" string="Стало" digits="[16,2]"/>
              <field name="price_compare_pct" string="Изм., %"
                     decoration-danger="price_compare_pct &gt; 0"
                     decoration-success="price_compare_pct &lt; 0"/>
              <field name="cost_compare_delta" string="В сумме, ₽"
                     sum="Разница" widget="monetary"
                     decoration-danger="cost_compare_delta &gt; 0"
                     decoration-success="cost_compare_delta &lt; 0"/>
              <field name="cost_fact_total" string="Закупка" widget="monetary"
                     sum="Итого" optional="show"/>
              <field name="price_compare_note" string="Замечание"
                     decoration-danger="price_compare_note != False"/>
              <field name="currency_id" column_invisible="1"/>
            </list>
          </field>
          <group class="mt-3">
            <group>
              <field name="compare_total_cost" widget="monetary"/>
              <field name="total_cost_fact" string="Стало сейчас"
                     widget="monetary" readonly="1"/>
            </group>
            <group>
              <field name="compare_delta" widget="monetary"/>
              <field name="compare_pct"/>
            </group>
          </group>
          <div class="alert alert-warning mt-2" role="alert"
               invisible="not price_incomplete">
            <i class="fa fa-exclamation-triangle me-1" aria-hidden="true"/>
            Позиций без цены: <field name="no_price_count" nolabel="1"
                                     class="fw-bold"/>.
            Их нет в прайсах — значит в городе позиции нет, и везти придётся
            из другого региона. Итог расчёта на эту сумму занижен.
          </div>
        </page>
      </xpath>

      <!--
        Деньги в составе изделия.

        ⚠️ ПОЛЯ ОБЪЯВЛЯЮТСЯ ВО ВСЕХ ЧЕТЫРЁХ НАБОРАХ. Состав правится в четырёх
        вкладках — прокат, лист, метизы, покрытия, — и у каждой своя разметка.
        Объявить поле в одной значит получить пустые суммы в трёх остальных:
        Odoo не запрашивает у сервера то, чего нет в разметке списка.

        ⚠️ БЕЗ column_invisible. На этом стенде уже обжигались: постоянно
        невидимая колонка вырезается из запроса (getFieldsSpec её пропускает),
        и поле приходит нулём. Прячем пользовательской настройкой
        optional="hide" — колонка скрыта, а данные читаются.
      -->
      <!--
        Цена изделия правится там же, где количество: менеджер видит вес и
        ставит цену, не уходя в другой экран.
      -->
      <!--
        ⚠️ ЦЕНА НУЖНА И В КАРТОЧКЕ ИЗДЕЛИЯ, НЕ ТОЛЬКО В СПИСКЕ. Список изделий
        не редактируется на месте: клик открывает карточку. Колонка без поля в
        карточке означала «вижу, но не ввести» — поймано при проверке глазами.
      -->
      <xpath expr="//field[@name='product_ids']/form//field[@name='qty']"
             position="after">
        <field name="price_customer_unit" widget="monetary"/>
        <field name="price_customer_total" widget="monetary" readonly="1"/>
        <field name="currency_id" invisible="1"/>
      </xpath>

      <xpath expr="//field[@name='product_ids']/list/field[@name='weight_total']"
             position="after">
        <field name="price_customer_unit" string="Цена за шт" widget="monetary"/>
        <field name="price_customer_total" string="Сумма" widget="monetary"
               sum="Цена клиенту" readonly="1"/>
        <field name="currency_id" column_invisible="1"/>
      </xpath>

      <xpath expr="//field[@name='line_linear_ids']/list" position="inside">
        <field name="price_state" optional="hide"/>
        <field name="price_unit" optional="hide"/>
        <field name="utilization_pct" optional="hide"/>
        <field name="cost_clean_total" optional="hide"/>
        <field name="cost_fact_total" optional="show" sum="Закупка"/>
        <field name="currency_id" column_invisible="1"/>
      </xpath>

      <xpath expr="//field[@name='line_sheet_ids']/list" position="inside">
        <field name="price_state" optional="hide"/>
        <field name="price_unit" optional="hide"/>
        <field name="utilization_pct" optional="show"/>
        <field name="cost_clean_total" optional="hide"/>
        <field name="cost_fact_total" optional="show" sum="Закупка"/>
        <field name="currency_id" column_invisible="1"/>
      </xpath>

      <xpath expr="//field[@name='line_fastener_ids']/list" position="inside">
        <field name="price_state" optional="hide"/>
        <field name="price_unit" optional="hide"/>
        <field name="cost_fact_total" optional="show" sum="Закупка"/>
        <field name="currency_id" column_invisible="1"/>
      </xpath>

      <xpath expr="//field[@name='line_paint_ids']/list" position="inside">
        <field name="price_state" optional="hide"/>
        <field name="price_unit" optional="hide"/>
        <field name="cost_fact_total" optional="show" sum="Закупка"/>
        <field name="currency_id" column_invisible="1"/>
      </xpath>

    </field>
  </record>

  <!--
    Массовый пересчёт из списка: отметил расчёты, нажал — цены перечитаны.

    ЗАЧЕМ ОТДЕЛЬНО ОТ КНОПКИ НА ФОРМЕ. После заливки нового прайса обновить
    нужно сразу несколько расчётов, а открывать каждый — работа ради работы.
    Автоматический пересчёт при заливке сознательно НЕ делаем: спецификация
    считается на дату, и суммы в уже названных клиенту расчётах не должны
    меняться сами.
  -->
  <record id="view_metal_spec_list_cost" model="ir.ui.view">
    <field name="name">pmk.metal.spec.list.cost</field>
    <field name="model">pmk.metal.spec</field>
    <field name="inherit_id" ref="pmk_calc.view_metal_spec_list"/>
    <field name="arch" type="xml">
      <xpath expr="//list" position="inside">
        <header>
          <button name="action_refresh_prices" type="object"
                  string="Перечитать цены" class="btn-secondary"/>
        </header>
      </xpath>
      <!-- «Итого, т» — по умолчанию скрыта: повторяет «Итого, кг», а после
           колонок цены клиенту и маржи номер расчёта обрезался до «СМ-00…».
           Вернуть — в меню колонок списка (29.09.2026). -->
      <xpath expr="//field[@name='total_weight_t']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      <xpath expr="//field[@name='total_weight_t']" position="after">
        <field name="total_cost_fact" optional="show" sum="Металл"
               widget="monetary"/>
        <!--
          Текстом, а не числом: у расчёта, который ни разу не пересчитывали,
          числовая колонка показывает 0,0 — и это читается как «проверено,
          цены не менялись», хотя проверки не было.
        -->
        <field name="cost_change_label" optional="show" string="Изм., %"
               decoration-danger="cost_change_pct &gt; 0 and not price_signal_stale"
               decoration-success="cost_change_pct &lt; 0 and not price_signal_stale"
               decoration-muted="price_signal_stale"/>
        <field name="cost_change_pct" column_invisible="1"/>
        <field name="price_signal_stale" column_invisible="1"/>
        <field name="price_incomplete" optional="hide"/>
        <field name="currency_id" column_invisible="1"/>
        <!--
          «Оживить таблицы», приём 4 (29.09.2026): цена клиенту и полоска
          маржи. Полоске нужны три соседних поля — цена клиенту (нет её —
          прочерк), признак неполного расчёта (серая полоска, «≤») и число
          позиций без цены (в подсказку). Логика — js/margin_bar_field.js.
        -->
        <field name="price_customer_total" optional="show" sum="Цена клиенту"
               widget="monetary"/>
        <field name="margin_pct" string="Маржа" optional="show"
               widget="pmk_margin_bar"
               options="{'incomplete_field': 'price_incomplete', 'base_field': 'price_customer_total', 'missing_field': 'no_price_count'}"/>
        <field name="no_price_count" column_invisible="1"/>
      </xpath>
    </field>
  </record>

  <!--
    Рейтинг поставщика — на карточке контрагента, во вкладке закупок нет
    смысла: её может не быть. Ставим рядом с реквизитами, одной строкой.
  -->
  <record id="view_partner_form_supplier_rank" model="ir.ui.view">
    <field name="name">res.partner.form.supplier.rank</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="(//sheet)[1]//field[@name='vat']" position="after">
        <field name="pmk_supplier_rank"/>
      </xpath>
    </field>
  </record>

</odoo>
