<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Колонка «Закупка» в составе изделия.

    ЗАЧЕМ ОТДЕЛЬНЫМ ФАЙЛОМ. Таблицу состава рисует свой виджет калькулятора, и
    шапка у него прошита в шаблоне: объявить денежное поле в разметке списка
    мало — колонка сама там не появится. Но и дописать её прямо в pmk_calc
    нельзя: без моста поля cost_fact_total не существует, и калькулятор,
    который обещает работать без номенклатуры, упал бы на первом же открытии.

    Поэтому расширяем шаблон отсюда, из моста: установлен — колонка есть, не
    установлен — состав прежний.

    ПОЧЕМУ ИМЕННО «ЗАКУПКА», А НЕ ОБЕ СУММЫ. В строке уже пять колонок, и
    шестая читается, а седьмая превращает таблицу в простыню. Показываем то,
    что ляжет в себестоимость; чистая стоимость и процент использования
    доступны в настройках колонок списка.
  -->
  <t t-inherit="pmk_calc.ProductRows" t-inherit-mode="extension">

    <xpath expr="//th[hasclass('pmk-c-weight')]" position="after">
      <th scope="col" class="pmk-num pmk-c-cost">Закупка, ₽</th>
    </xpath>

    <xpath expr="//td[hasclass('pmk-c-weight')]" position="after">
      <td class="pmk-num pmk-c-cost" t-esc="costOf(line)"/>
    </xpath>

    <!--
      Строка редактора растянута на всю таблицу. Колонок стало на одну больше,
      и без правки редактор оказался бы уже таблицы: последняя колонка
      выпадала бы из рамки.
    -->
    <xpath expr="//tr[hasclass('pmk-prow__editrow')]/td" position="attributes">
      <attribute name="colspan">7</attribute>
    </xpath>

  </t>

</templates>
