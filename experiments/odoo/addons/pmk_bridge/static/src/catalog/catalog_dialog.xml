<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="pmk_bridge.CatalogDialog">
    <Dialog title="'Каталог материалов'" size="'xl'" contentClass="'o_pmk_catalog'">
      <div class="o_pmk_catalog__body">
        <nav class="o_pmk_catalog__tree" t-ref="tree">
          <div class="o_pmk_catalog__kind o_pmk_catalog__all"
               t-att-class="{ 'o_pmk_catalog__kind--on': state.section === 'all' }"
               t-on-click="() => this.selectKind('all', null)"><span><i class="fa fa-search me-1"/>Искать везде</span></div>
          <t t-foreach="state.tree" t-as="sec" t-key="sec.key">
            <div class="o_pmk_catalog__sec" t-esc="sec.label"/>
            <div class="o_pmk_catalog__kind"
                 t-att-class="{ 'o_pmk_catalog__kind--on': state.section === sec.key and !state.kind }"
                 t-on-click="() => this.selectKind(sec.key, null)">Все</div>
            <t t-foreach="sec.kinds" t-as="k" t-key="k.key">
              <div class="o_pmk_catalog__kind"
                   t-att-class="{ 'o_pmk_catalog__kind--on': state.section === sec.key and state.kind === k.key }"
                   t-on-click="() => this.selectKind(sec.key, k.key)">
                <span class="o_pmk_catalog__label"><t t-call="pmk_bridge.CatalogIcon"><t t-set="icon" t-value="k.icon"/></t><t t-esc="k.label"/></span>
                <span class="o_pmk_catalog__count" t-esc="k.count"/>
              </div>
            </t>
          </t>
        </nav>
        <section class="o_pmk_catalog__main">
          <div class="o_pmk_catalog__filters">
            <input class="o_input o_pmk_catalog__q" placeholder="Размер или название: 20х60, 63х5, 4 мм"
                   t-att-value="state.query" t-on-input="onQuery"/>
            <t t-if="isFastener">
              <select class="o_input o_pmk_catalog__sel" title="Диаметр резьбы" t-on-change="(ev) => this.onFilter('diameter', ev)">
                <option value="" t-att-selected="!state.diameter">Ø</option>
                <t t-foreach="diameters" t-as="d" t-key="d">
                  <option t-att-value="d" t-att-selected="state.diameter === d" t-esc="(state.kind === 'screw' ? '' : 'М') + d.replace('.', ',')"/>
                </t>
              </select>
              <select t-if="state.kind !== 'washer' and state.kind !== 'screw' and state.kind !== 'anchor'"
                      class="o_input o_pmk_catalog__sel" title="Класс прочности" t-on-change="(ev) => this.onFilter('strength_class', ev)">
                <option value="" t-att-selected="!state.strength_class">Класс</option>
                <t t-foreach="classes" t-as="c" t-key="c">
                  <option t-att-value="c" t-att-selected="state.strength_class === c" t-esc="'кл. ' + c"/>
                </t>
              </select>
              <select class="o_input o_pmk_catalog__sel" title="Покрытие" t-on-change="(ev) => this.onFilter('coating', ev)">
                <option value="" t-att-selected="!state.coating">Покрытие</option>
                <option value="black" t-att-selected="state.coating === 'black'">Без покрытия</option>
                <option value="zinc" t-att-selected="state.coating === 'zinc'">Цинк</option>
                <option value="hot_zinc" t-att-selected="state.coating === 'hot_zinc'">Горячий цинк</option>
                <option value="painted" t-att-selected="state.coating === 'painted'">RAL</option>
              </select>
            </t>
            <label class="o_pmk_catalog__priced">
              <input type="checkbox" t-att-checked="state.priced" t-on-change="(ev) => this.onFilter('priced', ev)"/>
              только с ценой
            </label>
          </div>
          <div class="o_pmk_catalog__table">
            <table class="table table-sm">
              <thead><tr>
                <th>Позиция</th><th class="o_pmk_catalog__mass">Масса</th>
                <th class="text-end">Цена</th><th>Поставщик</th>
              </tr></thead>
              <tbody>
                <tr t-foreach="state.rows" t-as="row" t-key="row.key"
                    t-att-class="{ 'o_pmk_catalog__row--sel': state.sel === row.key }"
                    t-on-click="() => this.state.sel = row.key" t-on-dblclick="() => this.pick(row.key)">
                  <td>
                    <span t-esc="row.name"/>
                    <span t-if="row.pending" class="o_pmk_catalog__pending">на разнос</span>
                    <span t-if="row.gost and !isFastener" class="o_pmk_catalog__gost" t-esc="row.gost"/>
                  </td>
                  <td class="o_pmk_catalog__mass" t-esc="row.mass"/>
                  <td class="text-end">
                    <t t-if="row.price"><span t-esc="priceText(row)"/> ₽/<t t-esc="row.unit"/></t>
                    <span t-else="" class="o_pmk_catalog__noprice">нет цены</span>
                  </td>
                  <td class="o_pmk_catalog__sup" t-att-title="row.date and ('цена от ' + row.date)" t-esc="row.supplier or '—'"/>
                </tr>
                <tr t-if="!state.rows.length and !state.loading">
                  <td colspan="4" class="o_pmk_catalog__empty">
                    <t t-if="state.section === 'all' and !state.query">Наберите размер или название — поиск по всему справочнику.</t>
                    <t t-else="">Ничего не найдено. Уберите фильтр, поищите «везде» или заведите позицию.</t>
                  </td>
                </tr>
              </tbody>
            </table>
            <div t-if="state.more" class="o_pmk_catalog__more">Показаны первые 80 — уточните поиск.</div>
          </div>
        </section>
      </div>
      <t t-set-slot="footer">
        <button class="btn btn-primary" t-on-click="() => this.pick()" t-att-disabled="!state.sel or state.busy">Выбрать</button>
        <button class="btn btn-secondary" t-on-click="createPending">Нет в справочнике — завести</button>
        <button class="btn btn-link" t-on-click="props.close">Отмена</button>
      </t>
    </Dialog>
  </t>

  <!-- Значки разделов каталога (26.10.2026): контур сечения / изделия, 16×16, цвет текста. -->
  <t t-name="pmk_bridge.CatalogIcon">
    <svg class="o_pmk_catalog__icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor"
         stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
      <t t-if="icon === 'ibeam'"><path d="M3 2.5h10M3 13.5h10M8 2.5v11"/></t>
      <t t-elif="icon === 'channel'"><path d="M12 2.5H4.5v11H12"/></t>
      <t t-elif="icon === 'angle'"><path d="M4 2.5v10.5h9"/></t>
      <t t-elif="icon === 'rebar'"><circle cx="8" cy="8" r="4.5"/><path d="M4.5 5.5l7 5M4.5 10.5l7-5"/></t>
      <t t-elif="icon === 'roundbar'"><circle cx="8" cy="8" r="5" fill="currentColor" fill-opacity=".25"/></t>
      <t t-elif="icon === 'squarebar'"><rect x="3.5" y="3.5" width="9" height="9" fill="currentColor" fill-opacity=".25"/></t>
      <t t-elif="icon === 'hexbar'"><path d="M8 2.5l4.8 2.75v5.5L8 13.5l-4.8-2.75v-5.5z" fill="currentColor" fill-opacity=".25"/></t>
      <t t-elif="icon === 'pipe'"><circle cx="8" cy="8" r="5.5"/><circle cx="8" cy="8" r="3.3"/></t>
      <t t-elif="icon === 'rtube'"><rect x="2.5" y="4" width="11" height="8" rx="1"/><rect x="4.5" y="6" width="7" height="4"/></t>
      <t t-elif="icon === 'strip'"><rect x="2" y="6.5" width="12" height="3" fill="currentColor" fill-opacity=".25"/></t>
      <t t-elif="icon === 'sheet_ribbed'"><path d="M2.5 4.5h11v7h-11z"/><path d="M5 6.5l1.5 1.5M9 6.5l1.5 1.5M5 9.5l1.5 1.5M9 9.5l1.5 1.5"/></t>
      <t t-elif="icon === 'sheet_mesh'"><path d="M2.5 4.5h11v7h-11z"/><path d="M5 8l1.5-1.5L8 8l-1.5 1.5zM9 8l1.5-1.5L12 8l-1.5 1.5z"/></t>
      <t t-elif="icon === 'sheet'"><path d="M2.5 5.5l3-2h8l-3 2zM2.5 5.5v6.5h8v-6.5M10.5 12l3-2V3.5"/></t>
      <t t-elif="icon === 'bolt'"><path d="M4 3.5h8v3H4zM6.5 6.5v7M9.5 6.5v7M6.5 8.5l3 1M6.5 11l3 1"/></t>
      <t t-elif="icon === 'nut'"><path d="M8 2.5l4.8 2.75v5.5L8 13.5l-4.8-2.75v-5.5z"/><circle cx="8" cy="8" r="2.2"/></t>
      <t t-elif="icon === 'washer'"><circle cx="8" cy="8" r="5.5"/><circle cx="8" cy="8" r="2.2"/></t>
      <t t-elif="icon === 'screw'"><path d="M4.5 3.5h7M8 3.5v10M6.5 6l3 1M6.5 8.5l3 1M6.5 11l3 1"/></t>
      <t t-elif="icon === 'anchor'"><path d="M8 2.5v11M6 4.5h4M5.5 13.5l2.5-3 2.5 3"/></t>
      <t t-else=""><circle cx="8" cy="8" r="1.6" fill="currentColor"/></t>
    </svg>
  </t>
</templates>
