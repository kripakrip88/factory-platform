<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Фильтр документов в окне ползунков — js/filter_panel.js. Упрощён 25.10.2026:
         ряды по виду полей (период чипами, поля в ряд, варианты группами, «Показать
         только»), штатное меню свёрнуто под ссылку, одна кнопка «Показать N». -->
    <t t-name="pmk_orders.FilterPanel">
        <div t-if="fields.length" t-attf-class="pmk-filter {{ state.std ? 'pmk-filter--std' : '' }}"
             t-on-keydown="onKeydown">
            <div class="pmk-filter__head">
                <i class="fa fa-filter" aria-hidden="true"/>
                <span>Фильтр</span>
                <span t-if="activeCount" class="pmk-filter__badge" t-esc="activeCount"/>
                <button t-if="activeCount" type="button" class="pmk-filter__reset" t-on-click="() => this.clear()">Сбросить</button>
            </div>

            <!-- Период: быстрые чипы и «Свой…» с датами — одна настройка, один ряд. -->
            <t t-set="pf" t-value="periodField"/>
            <div t-if="pf" class="pmk-filter__row">
                <div class="pmk-filter__label" t-esc="pf.label"/>
                <div class="pmk-filter__chips">
                    <t t-foreach="quickList" t-as="q" t-key="q[0]">
                        <button type="button" t-attf-class="pmk-filter__chip {{ quickActive(q[0]) ? 'pmk-filter__chip--on' : '' }}"
                                t-att-aria-pressed="quickActive(q[0]) ? 'true' : 'false'"
                                t-on-click="() => this.quick(q[0])" t-esc="q[1]"/>
                    </t>
                    <button type="button" t-attf-class="pmk-filter__chip {{ quickActive('all') ? 'pmk-filter__chip--on' : '' }}"
                            t-att-aria-pressed="quickActive('all') ? 'true' : 'false'"
                            t-on-click="() => this.quick('all')">Всё время</button>
                    <button type="button" t-attf-class="pmk-filter__chip {{ periodCustom ? 'pmk-filter__chip--on' : '' }}"
                            t-att-aria-pressed="periodCustom ? 'true' : 'false'"
                            t-on-click="() => this.quick('custom')">Свой…</button>
                    <div t-if="periodCustom" class="pmk-filter__pair pmk-filter__pair--dates">
                        <input type="date" class="pmk-filter__in" t-att-value="periodValue.from or ''" aria-label="С"
                               t-on-change="(ev) => this.set(pf.key, { from: ev.target.value, quick: '' })"/>
                        <span class="pmk-filter__dash">—</span>
                        <input type="date" class="pmk-filter__in" t-att-value="periodValue.to or ''" aria-label="По"
                               t-on-change="(ev) => this.set(pf.key, { to: ev.target.value, quick: '' })"/>
                    </div>
                </div>
            </div>

            <!-- Выбор записей и суммы — один ряд. -->
            <div t-if="inputFields.length" class="pmk-filter__grid">
                <t t-foreach="inputFields" t-as="f" t-key="f.key">
                    <t t-set="v" t-value="value(f.key)"/>
                    <div class="pmk-filter__field">
                        <label class="pmk-filter__label" t-esc="f.label"/>
                        <div t-if="f.type === 'range'" class="pmk-filter__pair">
                            <input type="number" class="pmk-filter__in" placeholder="от" t-att-value="v.from or ''"
                                   t-on-change="(ev) => this.set(f.key, { from: ev.target.value })"/>
                            <span class="pmk-filter__dash">—</span>
                            <input type="number" class="pmk-filter__in" placeholder="до" t-att-value="v.to or ''"
                                   t-on-change="(ev) => this.set(f.key, { to: ev.target.value })"/>
                        </div>
                        <div t-else="" class="pmk-filter__in pmk-filter__in--many">
                            <MultiRecordSelector resModel="f.model" resIds="v.ids or []" placeholder="'любой'"
                                                 domain="f.domain ? f.domain(env.searchModel.globalContext or {}) : []"
                                                 update="(ids) => this.set(f.key, { ids })"/>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Варианты (статусы МоегоСклада, вид расчёта) — чипы, с подписью группы. -->
            <div t-foreach="choiceFields" t-as="f" t-key="f.key" class="pmk-filter__row">
                <t t-set="v" t-value="value(f.key)"/>
                <div class="pmk-filter__label" t-esc="f.label"/>
                <div class="pmk-filter__chips" role="group" t-att-aria-label="f.label">
                    <t t-foreach="choiceItems(f)" t-as="c" t-key="c.key">
                        <span t-if="c.head" class="pmk-filter__group" t-esc="c.head"/>
                        <button type="button" t-attf-class="pmk-filter__chip {{ (v.keys or []).includes(c.key) ? 'pmk-filter__chip--on' : '' }}"
                                t-att-aria-pressed="(v.keys or []).includes(c.key) ? 'true' : 'false'"
                                t-on-click="() => this.toggleChoice(f, c.key)" t-esc="c.label"/>
                    </t>
                </div>
            </div>

            <!-- «Мои …», пары «да/нет» и признаки — одной строкой. -->
            <div t-if="toggleFields.length" class="pmk-filter__row">
                <div class="pmk-filter__label">Показать только</div>
                <div class="pmk-filter__chips">
                    <t t-foreach="toggleItems()" t-as="it" t-key="it.id">
                        <button type="button" t-attf-class="pmk-filter__chip {{ it.on ? 'pmk-filter__chip--on' : '' }}"
                                t-att-aria-pressed="it.on ? 'true' : 'false'"
                                t-on-click="() => this.toggle(it)" t-esc="it.label"/>
                    </t>
                </div>
            </div>

            <div class="pmk-filter__foot">
                <button type="button" class="pmk-filter__more" t-att-aria-expanded="state.std ? 'true' : 'false'"
                        t-on-click="() => this.toggleStd()">
                    <i t-attf-class="fa fa-angle-{{ state.std ? 'down' : 'right' }}" aria-hidden="true"/>
                    Ещё фильтры, группировка и избранное
                </button>
                <button type="button" class="btn btn-primary btn-sm" t-on-click="() => this.apply()" t-esc="countLabel"/>
            </div>
        </div>
    </t>

    <!-- Над «Фильтры / Группировка / Избранное» в окне ползунков. -->
    <t t-inherit="web.SearchBarMenu" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='content']/*[1]" position="before">
            <t t-if="pmkFilterKey" t-component="pmkFilterPanel" configKey="pmkFilterKey"/>
        </xpath>
    </t>
</templates>
