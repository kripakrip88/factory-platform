<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    Продажи правят строки «Заказов в работе» без прав Проектов (шаг З-2).

    Строка планировщика — задача штатного проекта. Право на модель у всех
    сотрудников уже есть (project_todo, access_task_on_partner 1,1,1,1), а
    правила ядра для того, у кого нет группы «Проекты»:
      • читать — задачи проектов с видимостью «все сотрудники» (task_visibility_rule)
        → строку менеджер видит;
      • менять, заводить, удалять — только свои личные дела без проекта
        (project_todo.task_edition_rule_internal) → «Сумма оплаты», этап и
        «Новый заказ в работе» кнопкой «Заказ» падали на «нет доступа».
    Автосоздание строки по «Выиграно» и подтверждению счёта идёт от sudo
    (project_task.py, _pmk_create_order_row) и правила не касается.

    Решение: правило на группу «Продажи: только свои документы» (её
    наследуют «все документы» и руководитель продаж) — читать, менять и
    заводить строки ТОЛЬКО проекта-планировщика (pmk_is_orders). Удаление не
    даём: строка — след заказа, в архив её убирает «Проекты»-пользователь.
    Остальные задачи («Доработка системы», дела коллег) продажам так и не
    видны на запись. Правила групп складываются через «или» — права
    пользователей «Проектов» не меняются.
  -->
  <record id="rule_orders_rows_sales" model="ir.rule">
    <field name="name">Заказы в работе: продажи читают, правят и заводят строки планировщика</field>
    <field name="model_id" ref="project.model_project_task"/>
    <field name="domain_force">[('project_id.pmk_is_orders', '=', True)]</field>
    <field name="groups" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="False"/>
  </record>
</odoo>
