<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    Расчёт: кнопка «Счёт» (разбор UX, шаг З-9, 09.10.2026).

    Выбор Антона 09.10: черновик счёта покупателю — КНОПКОЙ в расчёте (не сам
    и не стадией сделки). Контурная, сразу за «Отправить КП»: залитая на
    экране расчёта одна — «КП (PDF)». Счёт один на сделку — повтор открывает
    тот же (models/metal_spec.py). Видна только у расчёта со сделкой и
    продавцам; у технического расчёта её прячет pmk_tech.

    «Отправить КП» уже есть рядом (pmk_bridge): после настоящей отправки счёт
    этого расчёта станет «Отправлен».

    Наследуем вид моста (его кнопки КП — там же). active в XML — грабли
    Odoo 19.
  -->
  <record id="view_metal_spec_form_invoice" model="ir.ui.view">
    <field name="name">pmk.metal.spec.form.invoice</field>
    <field name="model">pmk.metal.spec</field>
    <field name="inherit_id" ref="pmk_bridge.view_metal_spec_form_cost"/>
    <field name="active" eval="True"/>
    <field name="arch" type="xml">
      <xpath expr="//header/button[@name='action_send_quotation']" position="after">
        <button name="action_pmk_invoice" type="object" string="Счёт"
                class="btn-secondary" groups="sales_team.group_sale_salesman"
                invisible="not opportunity_id"
                title="Черновик счёта покупателю из этого расчёта: условия, согласование. Повторно — откроет тот же счёт сделки"/>
      </xpath>
    </field>
  </record>

  <!--
    «Создать ▾» / «Печать ▾» в расчёте — как в сделке и счёте (Антон
    20.10.2026: «да делаем»). Пункты — pmk.metal.spec.pmk_doc_menu (pmk_deal
    + «Счёт» отсюда). Кнопки «КП (PDF)», «Отправить КП», «Счёт» скрыты, НЕ
    удалены: на них держатся xpath'ы pmk_tech. Наследник вида МОСТА с priority
    99: дети одного родителя идут по priority, внук (наследник вида
    pmk_orders) применился бы до соседа pmk_tech — и его invisible вернул бы
    кнопки. «Перечитать цены» и
    «Заявка на металл» (технический) — остаются кнопками: это не документы.
  -->
  <record id="view_metal_spec_form_doc_menu" model="ir.ui.view">
    <field name="name">pmk.metal.spec.form.doc.menu</field>
    <field name="model">pmk.metal.spec</field>
    <field name="inherit_id" ref="pmk_bridge.view_metal_spec_form_cost"/>
    <field name="priority">99</field>
    <field name="active" eval="True"/>
    <field name="arch" type="xml">
      <xpath expr="//header/*[1]" position="before">
        <widget name="pmk_deal_doc_menu"/>
      </xpath>
      <xpath expr="//header/button[@name='action_print_quotation']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//header/button[@name='action_send_quotation']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//header/button[@name='action_pmk_invoice']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
    </field>
  </record>
</odoo>
