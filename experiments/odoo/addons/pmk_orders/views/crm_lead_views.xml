<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!--
    Сделка: кнопки-счётчики «Счёт» и «Заказ» сразу за «Доборками» (шаг З-2).
    Наши шаги процесса — видны всегда, ноль серым (stat_buttons.js темы); у
    лида нет, как «Расчётов» и «Доборок». Значки свои: надписи кнопок тема
    прячет, значок не должен повторять соседний.
      «Счёт»  — действующий счёт покупателю (прежние редакции не в счёт);
      «Заказ» — строка «Заказов в работе»: нет — форма новой с данными
                сделки, одна — она, несколько — список.
    Xpath по узлу pmk_deal (в зависимостях); active — грабли Odoo 19.
  -->
  <record id="view_crm_lead_form_orders" model="ir.ui.view">
    <field name="name">crm.lead.form.pmk.orders</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="pmk_deal.view_crm_lead_form_dobors"/>
    <field name="active" eval="True"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']/button[@name='action_open_dobors']" position="after">
        <button name="action_open_invoice" type="object"
                class="oe_stat_button" icon="fa-file-text-o"
                invisible="type == 'lead'">
          <field name="pmk_invoice_count" widget="statinfo" string="Счёт"/>
        </button>
        <button name="action_open_orders" type="object"
                class="oe_stat_button" icon="fa-industry"
                invisible="type == 'lead'">
          <field name="pmk_order_count" widget="statinfo" string="Заказ"/>
        </button>
      </xpath>
    </field>
  </record>

  <!--
    Штатные кнопки sale_crm «Коммерческие предложения» и «Заказы» (сумма) —
    спрятаны: тот же документ, что наша «Счёт», другими словами. Спрятаны,
    не удалены (узлы нужны xpath'ам); вернуть — снять invisible.
    docs/disabled-features.md, шаг З-2.
  -->
  <record id="view_crm_lead_form_hide_sale_buttons" model="ir.ui.view">
    <field name="name">crm.lead.form.pmk.orders.hide.sale</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="pmk_deal.view_crm_lead_form_hide_empty_quotations"/>
    <field name="active" eval="True"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='action_view_sale_quotation']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//button[@name='action_view_sale_order']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
    </field>
  </record>

  <!--
    Шаг З-15: «Выиграно» на форме сделки — с коротким окном «Оплата /
    гарантия» (сумма и дата оплаты, гарантийное письмо; «Пропустить» — без них).
    Наша кнопка встаёт на место штатной: та же надпись, та же клавиша w, то
    же условие видимости, контурная (sale_crm сняла заливку и со штатной).
    Штатная action_set_won_rainbowman спрятана, а не удалена: на её узел
    смотрят xpath sale_crm и тесты pmk_deal (порядок кнопок, шаг 48); метод
    не переопределён — ссылка «Выиграно» из письма (/lead/case_mark_won)
    работает как раньше, без окна. Вернуть — выключить этот вид.
    docs/disabled-features.md, шаг З-15. active — грабли Odoo 19.
  -->
  <record id="view_crm_lead_form_won_dialog" model="ir.ui.view">
    <field name="name">crm.lead.form.pmk.orders.won.dialog</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="active" eval="True"/>
    <field name="arch" type="xml">
      <xpath expr="//header/button[@name='action_set_won_rainbowman']" position="before">
        <button name="action_pmk_won" type="object" string="Выиграно" data-hotkey="w"
                title="Пришла предоплата или гарантийное письмо"
                invisible="won_status == 'won' or type == 'lead' or not active"/>
      </xpath>
      <xpath expr="//header/button[@name='action_set_won_rainbowman']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
    </field>
  </record>

</odoo>
