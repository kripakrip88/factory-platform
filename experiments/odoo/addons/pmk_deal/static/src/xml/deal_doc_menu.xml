<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pmk_deal.DealDocMenu">
        <div class="o_pmk_doc_menu d-inline-flex gap-1">
            <Dropdown beforeOpen="load">
                <button type="button" class="btn btn-secondary">
                    <i class="fa fa-plus me-1"/>Создать<i class="fa fa-caret-down ms-1"/>
                </button>
                <t t-set-slot="content">
                    <t t-foreach="state.create" t-as="item" t-key="item.key">
                        <DropdownItem onSelected="() => this.run(item)">
                            <i t-att-class="'fa fa-fw me-2 ' + item.icon"/><t t-esc="item.label"/>
                        </DropdownItem>
                    </t>
                </t>
            </Dropdown>
            <Dropdown beforeOpen="load">
                <button type="button" class="btn btn-secondary o_pmk_doc_menu__print" title="Печать и отправка">
                    <i class="fa fa-print"/><span class="o_pmk_doc_menu__label ms-1">Печать</span><i class="fa fa-caret-down ms-1"/>
                </button>
                <t t-set-slot="content">
                    <t t-foreach="state.print" t-as="item" t-key="item.key">
                        <DropdownItem onSelected="() => this.run(item)">
                            <i t-att-class="'fa fa-fw me-2 ' + item.icon"/><t t-esc="item.label"/>
                        </DropdownItem>
                    </t>
                    <div t-if="state.loaded and !state.print.length and !state.send.length" class="dropdown-item-text text-muted small">
                        Печатать пока нечего
                    </div>
                    <t t-if="state.send.length">
                        <div t-if="state.print.length" class="dropdown-divider"/>
                        <t t-foreach="state.send" t-as="item" t-key="item.key">
                            <DropdownItem onSelected="() => this.run(item)">
                                <i t-att-class="'fa fa-fw me-2 ' + item.icon"/><t t-esc="item.label"/>
                            </DropdownItem>
                        </t>
                    </t>
                </t>
            </Dropdown>
        </div>
    </t>
</templates>
