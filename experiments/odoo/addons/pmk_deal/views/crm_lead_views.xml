<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!--
    Кнопка-счётчик «Расчёты» в шапке сделки — ПЕРВОЙ. Расчёт и КП из него —
    главный шаг завода по сделке (разбор UX, шаг 3, решение Антона
    28.09.2026; скрин 31). Показывается и при нуле: ноль значит «шаг ещё не
    сделан», это наблюдение. Серым ноль красит тема (stat_buttons.js).

    Встреча — только когда назначена: пустая кнопка «Нет встречи» висела на
    каждой сделке и сдвигала название.

    У лида «Расчётов» нет (шаг 31): считают по сделке, а не по интересу, —
    поле «Сделка» у расчёта принимает только сделки. Кнопка у лида открыла
    бы форму нового расчёта, привязанного к лиду, как «Расчёт и КП» у
    сделки, а строка денег у лида скрыта — результат нигде не был бы виден.
  -->
  <record id="view_crm_lead_form_specs" model="ir.ui.view">
    <field name="name">crm.lead.form.specs</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='action_schedule_meeting']" position="before">
        <button name="action_open_specs" type="object"
                class="oe_stat_button" icon="fa-calculator"
                invisible="type == 'lead'">
          <field name="spec_count" widget="statinfo" string="Расчёты"/>
        </button>
      </xpath>
      <xpath expr="//button[@name='action_schedule_meeting']" position="attributes">
        <attribute name="invisible">not id or type == 'lead' or not meeting_display_date</attribute>
      </xpath>
    </field>
  </record>

  <!--
    Штатные КП Odoo (sale.order) — только когда они есть. Наше КП печатается
    из расчёта, штатным завод не пользуется, и «Коммерческие предложения 0»
    путало: главное КП сделки не там (прогон 27.09, П-13).

    ⚠️ ОТДЕЛЬНЫЙ ВИД НАД ВИДОМ sale_crm, А НЕ ПРАВКА В ВИДЕ ВЫШЕ. Кнопку
    добавляет модуль sale_crm; xpath на его узел из вида над crm упал бы при
    загрузке, если бы наш вид применился раньше (грабли 23.09.2026 —
    project_odoo_view_load_order). Поэтому sale_crm — в зависимостях.
  -->
  <!--
    Главная кнопка сделки — «Расчёт и КП» (разбор UX, шаг 31, 30.09.2026).
    Одна залитая кнопка на экран — следующий шаг процесса. Была штатная
    «Новое коммерческое предложение»: вела в КП Odoo (sale.order), которым
    завод не пользуется, и была единственной залитой. Наша кнопка: расчёта
    нет — форма нового со сделкой и клиентом, один — он сам, несколько —
    список (deal_link.py, action_open_specs). Стоит на месте штатной, перед
    «Выиграно»; штатная скрыта, НЕ удалена — узел нужен xpath'ам других
    видов, а вернуть её — снять invisible (docs/disabled-features.md).
  -->
  <record id="view_crm_lead_form_hide_empty_quotations" model="ir.ui.view">
    <field name="name">crm.lead.form.hide.empty.quotations</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="sale_crm.crm_case_form_view_oppor"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='action_view_sale_quotation']" position="attributes">
        <attribute name="invisible">type == 'lead' or quotation_count == 0</attribute>
      </xpath>
      <xpath expr="//button[@name='action_sale_quotations_new']" position="before">
        <button name="action_open_specs" type="object" string="Расчёт и КП"
                class="oe_highlight" data-hotkey="q"
                title="Нет расчёта — создать со сделкой и клиентом; один — открыть; несколько — список"
                invisible="type == 'lead' or not active"/>
      </xpath>
      <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
    </field>
  </record>

  <!--
    Кнопка-счётчик в карточке клиента: «Сделки», а не «Возможности».
    Разбор UX, шаг 3 (Антон, 28.09.2026: «адаптацию сделай человеческую»).
    У завода — сделка, «возможность» — слово штатного CRM. Кнопку добавляет
    модуль crm, поэтому правка здесь: модуль зависит от crm.
  -->
  <record id="view_partner_form_deals_label" model="ir.ui.view">
    <field name="name">res.partner.form.deals.label</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="crm.view_partners_form_crm1"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='action_view_opportunity']/field[@name='opportunity_count']" position="attributes">
        <attribute name="string">Сделки</attribute>
      </xpath>
    </field>
  </record>


  <!--
    Лид и сделка — без адреса, языка, сайта и маркетинга. Разбор UX, шаг 8
    (28.09.2026, согласовано Антоном: «давай уберём эту кучу строк»).

    Адрес клиента живёт в карточке контрагента («Фактический адрес»), а не в
    каждой сделке; язык у завода один; сайт — в карточке контрагента; рекламных
    кампаний, каналов и источников завод не ведёт. Остаются компания, имя
    контакта, должность и команда.

    Поля в базе остаются, ядро по-прежнему переносит их в контрагента при
    создании. Xpath по узлам внутри своей группы/страницы: у лида и у сделки
    блоки адреса разные (group lead_partner и page lead), а на форме
    контрагента в «Контактах» есть свой адрес.
  -->
  <record id="view_crm_lead_form_trim" model="ir.ui.view">
    <field name="name">crm.lead.form.pmk.trim</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">
      <!-- Лид: верхняя группа -->
      <xpath expr="//group[@name='lead_partner']/label[@for='street']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//group[@name='lead_partner']/div[hasclass('o_address_format')]" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//group[@name='lead_partner']/field[@name='website']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//group[@name='lead_partner']/field[@name='lang_id']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <!-- Лид: «Дополнительная информация» — маркетинг -->
      <xpath expr="//page[@name='extra']//group[@name='categorization']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <!-- Сделка: вкладка «Контакты» -->
      <xpath expr="//page[@name='lead']//label[@for='street_page_lead']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//page[@name='lead']//div[hasclass('o_address_format')]" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//page[@name='lead']//field[@name='lang_id']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//page[@name='lead']//field[@name='website']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//page[@name='lead']//group[field[@name='campaign_id']]" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
    </field>
  </record>

  <!--
    Список сделок — «оживить таблицы» (29.09.2026).
    • Стадия — плашкой в цвете стадии (как кнопка стадии в сделке: цвет из
      «Настройки CRM → Этапы»). Было — простой текст (badge_rotting ядра
      рисует плашку только у «залежавшейся» сделки, сроки залёживания не
      заданы). Свой виджет pmk_stage_badge, а не штатный badge: штатный
      только для чтения, и стадию нельзя было бы сменить в списке (у списка
      multi_edit). В правке строки — штатный редактор стадии.
    • «Ожидаемое закрытие» — видно по умолчанию и по смыслу: просрочено —
      красным («5 дней назад»), сегодня — янтарным, дальше — обычным. Только
      у сделок в работе: у выигранной и проигранной срок уже не горит.
      [@optional] обязателен: выше в том же списке есть скрытая служебная
      колонка date_deadline.
  -->
  <record id="view_crm_lead_list_tones" model="ir.ui.view">
    <field name="name">crm.lead.list.pmk.tones</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='stage_id']" position="attributes">
        <attribute name="widget">pmk_stage_badge</attribute>
      </xpath>
      <!-- Шаг 31: «Ожидаемое закрытие» → «Ответить клиенту до» — срок
           ответа, а не прогноз закрытия. Сигнал, не запрет. -->
      <xpath expr="//field[@name='date_deadline'][@optional]" position="attributes">
        <attribute name="string">Ответить клиенту до</attribute>
        <attribute name="widget">remaining_days</attribute>
        <attribute name="optional">show</attribute>
        <attribute name="options">{'classes': {'danger': "days &lt; 0 and record.won_status == 'pending'", 'warning': "days == 0 and record.won_status == 'pending'", 'bf': "days &lt;= 0 and record.won_status == 'pending'"}}</attribute>
      </xpath>
      <!-- Шаг 31: доход сделки теперь — цена клиенту из главного расчёта
           (deal_money.py), так колонка и называется. Узел не заменяем:
           на него xpath-ят виды прогноза и отчётов crm. -->
      <xpath expr="//field[@name='expected_revenue']" position="attributes">
        <attribute name="string">Цена клиенту</attribute>
      </xpath>
    </field>
  </record>

  <!--
    Колонки списка сделок — разбор UX, шаг 25 (01.10.2026).
    Итог: Сделка · Клиент · Имя контакта · Менеджер · Цена клиенту · Маржа ·
    Вес, т · Ответить клиенту до · Стадия с «N дн».

    • Клиент — компания, а не человек (pmk_client_id, как на карточке
      воронки). Штатный «Контакт» (человек) остался в меню колонок.
    • Маржа — полоской, как в списке расчётов: неполный расчёт (есть позиции
      без цены закупки) — красная полоска и «≤» (маржа завышена), цены клиенту
      в расчёте нет — прочерк. База полоски — цена клиенту из расчёта
      (pmk_spec_price), а не «Цена клиенту» списка: ту можно вписать в строке,
      и сделка без расчёта показала бы «0,0 %» как плохую маржу. Вес, т —
      главного расчёта. Всё — окно в расчёт (связанные поля,
      models/deal_money.py), не копия.
    • «Эл. почта» — в меню колонок: показывала «Имя <адрес>» — дубль имени.
    • Из меню колонок убраны (column_invisible, а не удаление: узлы на месте
      для xpath'ов других модулей; колонки и раньше были только в ⚙): город,
      регион, страна, команда (у всех одна), вероятность (считал автомат без
      истории), кампания, канал, источник (маркетинг скрыт шагом 8, пусто у
      всех), теги (0), задачи (0). Задачи остались в ⚙ списка «Мои задачи» —
      вид ниже. Списки «Анализ воронки» и «Прогноз» строятся из этого
      (mode primary) и получают ту же правку.
    • Кнопки «Эл. почта» — в шапке над выбранными и в каждой строке —
      скрыты: письмо клиенту пишут из почты или из сделки, рассылки по
      списку завод не делает. «СМС» — модуль pmk_deal_sms.
    Всё скрыто обратимо: вернуть — снять атрибут (docs/disabled-features.md).
  -->
  <record id="view_crm_lead_list_columns" model="ir.ui.view">
    <field name="name">crm.lead.list.pmk.columns</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
    <field name="arch" type="xml">
      <!-- Ширины «Клиента» и «Менеджера» заданы: без них ядро отдаёт
           свободное место самой длинной колонке («Возможность»), а эти две
           сжимает до минимума — «ООО «Ар…», «Антон Карне». -->
      <xpath expr="//field[@name='name']" position="after">
        <field name="pmk_client_id" optional="show" width="160px"/>
      </xpath>
      <xpath expr="//field[@name='email_from']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      <xpath expr="//field[@name='user_id']" position="attributes">
        <attribute name="string">Менеджер</attribute>
        <attribute name="width">130px</attribute>
      </xpath>
      <xpath expr="//field[@name='expected_revenue']" position="after">
        <field name="pmk_margin_pct" string="Маржа" optional="show"
               widget="pmk_margin_bar"
               options="{'incomplete_field': 'pmk_price_incomplete', 'base_field': 'pmk_spec_price', 'missing_field': 'pmk_no_price_count'}"/>
        <field name="pmk_weight_t" string="Вес, т" digits="[12,3]"
               sum="Итого, т" optional="show"/>
        <field name="pmk_price_incomplete" column_invisible="1"/>
        <field name="pmk_no_price_count" column_invisible="1"/>
        <field name="pmk_spec_price" column_invisible="1"/>
      </xpath>
      <xpath expr="//field[@name='city']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='state_id']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='country_id']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='team_id']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='probability']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='campaign_id']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='medium_id']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='source_id']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='tag_ids']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='activity_ids']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='activity_user_id']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='my_activity_date_deadline']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//header/button[@name='%(crm.action_lead_mass_mail)d']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <!-- Кнопка строки: одного invisible мало — колонка кнопок остаётся
           пустой полосой ~90 px и сжимает «Клиента» и «Менеджера». Колонку
           убирает column_invisible, и только когда он стоит у ВСЕХ кнопок
           группы (рядом кнопка «СМС» — её гасит pmk_deal_sms). -->
      <xpath expr="//button[@name='%(crm.action_lead_mail_compose)d']" position="attributes">
        <attribute name="invisible">1</attribute>
        <attribute name="column_invisible">1</attribute>
      </xpath>
    </field>
  </record>

  <!--
    «Мои задачи» (часики вверху → Сделки) — тот же список сделок, но про
    задачи. Колонки задач здесь нужны: возвращаем их к штатному виду
    (в меню колонок, «Мой срок» — порядок списка). Вид наследует список
    сделок и применяется после правки выше.
  -->
  <record id="view_crm_lead_list_activities_keep" model="ir.ui.view">
    <field name="name">crm.lead.list.activities.pmk.keep</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_list_activities"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='activity_ids']" position="attributes">
        <attribute name="column_invisible"/>
      </xpath>
      <xpath expr="//field[@name='activity_user_id']" position="attributes">
        <attribute name="column_invisible"/>
      </xpath>
      <xpath expr="//field[@name='my_activity_date_deadline']" position="attributes">
        <attribute name="column_invisible"/>
      </xpath>
    </field>
  </record>

  <!--
    Колонки списка лидов — разбор UX, шаг 25. Итог: Лид · Получен · Эл. почта ·
    Менеджер. «Получен» — когда клиент написал (pmk_received,
    models/deal_money.py): у лида из почты — дата письма, у заведённого
    руками — дата заведения. Не дата создания лида: лид заводят кнопкой
    «Лид» часы и дни спустя, и create_date занижал бы задержку ответа.
    Штатная «Дата создания» осталась на своём месте в ⚙. Сразу за
    названием. Город, страна (пусты у всех) и команда (у всех одна) —
    в меню колонок (⚙). «Откуда пришёл» — в меню колонок; заодно новое поле
    в виде сбрасывает выбор колонок, запомненный браузером до шага 25 (иначе
    старый выбор оказался бы сильнее новых настроек).
    Маркетинг и вероятность у лида и так только в меню колонок — их этот шаг
    не трогает (таблица «Чего не хватает» о них для лидов молчит).
  -->
  <record id="view_crm_lead_leads_list_columns" model="ir.ui.view">
    <field name="name">crm.lead.list.lead.pmk.columns</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="after">
        <field name="pmk_received" widget="date" optional="show"/>
      </xpath>
      <xpath expr="//field[@name='user_id']" position="attributes">
        <attribute name="string">Менеджер</attribute>
      </xpath>
      <xpath expr="//field[@name='user_id']" position="after">
        <field name="pmk_source" optional="hide"/>
      </xpath>
      <xpath expr="//field[@name='city']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      <xpath expr="//field[@name='country_id']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      <xpath expr="//field[@name='team_id']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
    </field>
  </record>

</odoo>
