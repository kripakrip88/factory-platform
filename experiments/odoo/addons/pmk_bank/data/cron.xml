<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Опрос банков раз в 5 минут. Первый опрос счёта только запоминает,
         что уже было (в группу не идёт). Выключить — active = False. -->
    <record id="cron_pmk_bank_sync" model="ir.cron">
        <field name="name">Банк: забрать поступления</field>
        <field name="model_id" ref="model_pmk_bank_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
