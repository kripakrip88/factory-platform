<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    «Поставщик не выбран» — служебный контрагент заявок на металл (шаг З-4).

    Позиция без цены в прайсах — сигнал «в городе нет», а не ошибка данных:
    поставщика у неё нет, а заказ поставщику без контрагента Odoo не
    сохранит (partner_id обязателен). Такие позиции собираются в отдельный
    черновик на этого контрагента — снабженец видит их в том же списке
    «Заявки на металл» (фильтр «Поставщик не выбран») и сам выбирает
    поставщика в черновике: штатная смена поля, цены строк ядро перечитает
    по прайсу выбранного.

    В архиве (active=False): не мешает в контактах и в выборе поставщика,
    в «Поставщиках» его нет (ранг поставщика заказ поставщику не растит).
    Ссылка из кода на архивную запись работает. noupdate — переименование
    обновлением модуля не затрётся. Писем ему не уходит: адреса нет.
  -->
  <data noupdate="1">
    <record id="partner_no_supplier" model="res.partner">
      <field name="name">Поставщик не выбран</field>
      <field name="is_company" eval="True"/>
      <field name="active" eval="False"/>
      <field name="comment">Служебный контрагент «Заявок на металл»: позиции без цены в прайсах (в городе нет). Выберите поставщика в черновике заявки.</field>
    </record>
  </data>
</odoo>
