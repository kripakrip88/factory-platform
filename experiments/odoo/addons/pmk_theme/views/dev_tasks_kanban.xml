<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Карточка доски «Доработка системы» (Антон 20.10.2026: «задачам можем
    автоматически присваивать порядковый номер? и в карточках не видно, кто
    создал карточку и когда»). Номер — id задачи: так задачи и называют в
    переписке (№307, №313), отдельный счётчик не нужен. Свой вид только для
    этой доски (основной вид задач — у «Заказов в работе» и прочих досок).
  -->
  <record id="view_dev_task_kanban" model="ir.ui.view">
    <field name="name">project.task.kanban.pmk.dev</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_kanban"/>
    <field name="mode">primary</field>
    <field name="priority">50</field>
    <field name="arch" type="xml">
      <xpath expr="//t[@t-name='card']//field[@name='name']" position="before">
        <div class="pmk-dev-card-meta text-muted small text-nowrap text-truncate">
          <span>№<field name="id"/></span>
          <span> · </span><field name="create_uid" options="{'no_open': True}"/>
          <span> · </span><field name="pmk_created_on"/>
        </div>
      </xpath>
      <!-- Кружок «состояния задачи» Odoo (В процессе / Нужны правки / Готово…)
           убран (Антон 20.10.2026): статус задачи на доске — её колонка, а
           второе «состояние» рядом путало. -->
      <xpath expr="//footer//field[@name='state']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
    </field>
  </record>

  <record id="action_dev_tasks_view_kanban" model="ir.actions.act_window.view">
    <field name="sequence">1</field>
    <field name="view_mode">kanban</field>
    <field name="view_id" ref="view_dev_task_kanban"/>
    <field name="act_window_id" ref="action_dev_tasks"/>
  </record>
</odoo>
