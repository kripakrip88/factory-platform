<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Выбранный вид — атрибутом на <html>, а не классом на <body>.

    На <html> потому, что это единственный элемент, который существует уже в
    момент разбора <head>: CSS-переменные светлого набора начинают действовать
    до того, как браузер нарисует первый пиксель. Класс на <body> опоздал бы на
    тот самый тёмный проблеск, ради избавления от которого всё и затевалось.

    Значение кладём в html_data: web.layout выводит его через
    <html t-att="html_data or {}"/>, то есть это штатная точка расширения, а не
    подмена ядровой разметки. t-set стоит внутри тела t-call намеренно — QWeb
    вычисляет тело ДО вызова web.layout, поэтому переменная успевает попасть
    в контекст вызываемого шаблона.

    Ключ pmk_scheme приходит из webclient_rendering_context (models/ir_http.py).
  -->
  <template id="webclient_bootstrap_pmk_scheme" inherit_id="web.webclient_bootstrap">
    <xpath expr="//t[@t-call='web.layout']" position="inside">
      <t t-set="html_data" t-value="{'data-pmk-scheme': pmk_scheme}"/>
    </xpath>
  </template>

</odoo>
