  <!-- ═══════════════════════════════════════════════════════════════════════
       СВЕТЛАЯ ВЕРСИЯ НАВИГАЦИИ — для работы поверх чужой светлой темы.

       Sequence 39, то есть ПОСЛЕ всех наших (30-38) и заведомо после чужой
       темы: её ассеты объявлены манифестом и получают sequence по умолчанию
       (16), а всё, что здесь, дописывается в конец бандла.

       ⚠️ Эта запись и asset_scss_navbar (sequence 32, тёмная версия) —
       ВЗАИМОИСКЛЮЧАЮЩИЕ. Оба файла красят одни и те же узлы в противоположные
       цвета; включить оба — значит отдать результат на волю порядка.
       Возврат к тёмной теме: выключить эту запись, включить остальные.
       ═══════════════════════════════════════════════════════════════════════ -->
  <record id="asset_scss_navbar_light" model="ir.asset">
    <field name="name">ПМК: navbar_nexus.scss — навигация в светлой теме</field>
    <field name="bundle">web.assets_backend</field>
    <field name="directive">append</field>
    <field name="path">pmk_theme/static/src/scss/navbar_nexus.scss</field>
    <field name="sequence">39</field>
  </record>

  <!-- Разметка переключателя тем в шапке. Идёт В ПАРЕ со светлой темой:
       механизм переключения приходит из чужой темы, и без неё кнопка не
       отрисуется (в шаблоне стоит проверка на наличие её метода). -->
  <record id="asset_xml_theme_toggle" model="ir.asset">
    <field name="name">ПМК: переключатель тем в шапке</field>
    <field name="bundle">web.assets_backend</field>
    <field name="directive">append</field>
    <field name="path">pmk_theme/static/src/xml/theme_toggle.xml</field>
    <field name="sequence">40</field>
  </record>

  <!-- Геометрия форм для светлой темы: только вёрстка, без цветов.
       Без неё сетка группы схлопывает колонку значений в ноль и содержимое
       вываливается поверх соседей. Подробности и замеры — в самом файле. -->
  <record id="asset_scss_forms_light" model="ir.asset">
    <field name="name">ПМК: forms_nexus.scss — геометрия форм в светлой теме</field>
    <field name="bundle">web.assets_backend</field>
