<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Полоса сворачивания чата и признак модели на корне.

    Признак модели нужен, чтобы стилями убрать лишние кнопки там, где они не
    к месту: в складской накладной некому отправлять сообщение и незачем
    планировать активность, а вот внутренняя заметка — рабочий инструмент
    кладовщика («пришло с недостачей», «сертификат в бумаге»).

    Кнопку вставляем ПЕРЕД «Отправить сообщение», а не перед блоком t-else:
    в шаблоне ядра идут парные t-if/t-else, и вставка между ними роняет Owl
    с «t-elif and t-else must be preceded by a t-if» — уже проходили на шапке.
  -->
  <t t-name="pmk_theme.ChatterCollapsible"
     t-inherit="mail.Chatter"
     t-inherit-mode="extension">

    <xpath expr="//div[hasclass('o-mail-Chatter')]" position="attributes">
      <attribute name="t-att-data-pmk-model">props.threadModel</attribute>
      <attribute name="t-att-data-pmk-collapsed">pmk.collapsed ? '1' : '0'</attribute>
    </xpath>

    <xpath expr="//button[hasclass('o-mail-Chatter-sendMessage')]" position="before">
      <button class="pmk-chatter-toggle btn btn-link text-action d-flex align-items-center"
              t-att-aria-expanded="pmk.collapsed ? 'false' : 'true'"
              t-att-title="pmk.collapsed ? 'Показать историю' : 'Свернуть историю'"
              t-on-click="pmkToggle">
        <i class="fa fa-fw" t-att-class="pmk.collapsed ? 'fa-angle-right' : 'fa-angle-down'"
           aria-hidden="true"/>
        <span class="pmk-chatter-toggle__label">История</span>

        <!-- Счётчики видны только в свёрнутом виде: развёрнутый чат говорит сам за себя. -->
        <t t-if="pmk.collapsed">
          <span t-if="pmkCounts.messages" class="pmk-chatter-badge" title="Сообщений">
            <i class="fa fa-comment-o" aria-hidden="true"/><t t-esc="pmkCounts.messages"/>
          </span>
          <span t-if="pmkCounts.attachments" class="pmk-chatter-badge" title="Вложений">
            <i class="fa fa-paperclip" aria-hidden="true"/><t t-esc="pmkCounts.attachments"/>
          </span>
          <!-- Просроченные помечены значком И словом, не только цветом. -->
          <span t-if="pmkCounts.overdue" class="pmk-chatter-badge pmk-chatter-badge--overdue"
                title="Просроченные задачи">
            <i class="fa fa-exclamation-triangle" aria-hidden="true"/><t t-esc="pmkCounts.overdue"/>
            <span class="pmk-chatter-badge__word">просрочено</span>
          </span>
          <span t-elif="pmkCounts.activities" class="pmk-chatter-badge" title="Запланированных задач">
            <i class="fa fa-clock-o" aria-hidden="true"/><t t-esc="pmkCounts.activities"/>
          </span>
        </t>
      </button>
    </xpath>
  </t>

</templates>
