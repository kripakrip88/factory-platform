<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Поправка на гиб круга (25.10.2026): технолог вписывает свой коэффициент для диаметра.
       После правки — пересчитать изделия (запись строки заново) и обновить справочник (-u). -->
  <record id="view_kolodec_bend_list" model="ir.ui.view">
    <field name="name">pmk.kolodec.bend.list</field>
    <field name="model">pmk.kolodec.bend</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="diameter"/>
        <field name="factor"/>
        <field name="deduction_mm"/>
        <field name="note"/>
      </list>
    </field>
  </record>

  <record id="action_kolodec_bend" model="ir.actions.act_window">
    <field name="name">Поправка на гиб круга</field>
    <field name="res_model">pmk.kolodec.bend</field>
    <field name="view_mode">list</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Вычет с развёртки на один гиб — в диаметрах круга</p>
      <p>Заготовка = сумма наружных размеров − гибов × коэффициент × ⌀. Нет строки — коэффициент 2.</p>
    </field>
  </record>
</odoo>
