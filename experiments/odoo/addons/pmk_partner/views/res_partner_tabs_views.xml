<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!--
    Карточка контрагента на вкладках — по образцу карточки товара
    (product/views/product_views.xml, product.product_template_form_view).

    ОБРАЗЕЦ. Над блокнотом у товара лежит ТОЛЬКО шапка: кнопки-счётчики,
    лента «В архиве», картинка, заголовок и строка флажков. Ни одной группы
    полей выше блокнота нет — всё содержимое разнесено по страницам.

    У контрагента шапка уже такая же: картинка, переключатель «Гость /
    Компания» (это и есть «флажки»), название, почта, телефон. Не хватает
    одного: большая двухколоночная группа с адресом, сайтом и метками висит
    МЕЖДУ шапкой и вкладками. Её и переносим на первую страницу.

    Вкладки идут сверху и во всю ширину БЕЗ участия темы: в арче у notebook
    нет атрибута orientation, компилятор его не выставляет, а у компонента по
    умолчанию «horizontal» — боковых вкладок форма получить не может. Полосу
    вкладок в поля листа вытягивает сама Odoo. В стилях тут делать нечего.
  -->
  <record id="view_partner_form_tabs" model="ir.ui.view">
    <field name="name">res.partner.form.pmk.tabs</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <!-- Применяемся последними, после чужих наследников. -->
    <field name="priority">99</field>
    <!-- Состояние держим кодом, а не базой: прецедент 2026-09-20 — вид
         оказался выключенным на стенде, и правку не видел никто. -->
    <field name="active">True</field>
    <field name="arch" type="xml">

      <!--
        Шаг 1: пустая страница.

        ⚠️ ЯКОРЬ — ШТАТНЫЕ «КОНТАКТЫ», А НЕ page[1]. Первой страницей к этому
        моменту уже стоят «Реквизиты» из pmk_dadata, и вставка «перед первой»
        уехала бы ПЕРЕД ними. Сослаться на саму страницу реквизитов отсюда
        нельзя: pmk_dadata зависит от pmk_partner, и во время загрузки этого
        файла её ещё не существует — xpath упадёт и уронит базу целиком.
      -->
      <!--
        Подпись над названием — как «Товар» в карточке товара
        (product_views.xml: <div class="oe_title"><label for="name"/><h1>…).
        У контрагента её не было: название начиналось сразу, и две карточки
        читались по-разному с первого взгляда.

        Ставим перед переключателем «Гость / Компания», внутри той же колонки
        шапки. Ограничение (//sheet)[1] обязательно: во вложенной форме
        контактного лица есть своё поле company_type, и без него подпись
        уехала бы туда.
      -->
      <xpath expr="(//sheet)[1]//field[@name='company_type']" position="before">
        <label for="name" string="Контрагент" class="fw-bold text-muted small"/>
      </xpath>

      <xpath expr="//notebook/page[@name='contact_addresses']" position="before">
        <page string="Основная информация" name="pmk_main"/>
      </xpath>

      <!--
        Шаг 2: переносим в неё то, что висит между шапкой и вкладками.

        Перенос, а не объявление полей заново: у полей свои groups и
        invisible, и переписывание рано или поздно откроет лишнее не тому
        человеку.

        ⚠️ (//sheet)[1] ОБЯЗАТЕЛЕН. Второй такой же блок адреса лежит во
        вложенной форме контактного лица; без ограничения переезжает он, и
        карточка разваливается — подписи рассыпаются по буквам, кнопки
        ложатся поверх соседних полей. Проверено 23.09.2026 на боевой.

        ⚠️ position="replace" mode="inner", а не "inside": ядро выполняет
        move только в ветках replace и before, в inside перенос молча не
        происходит и приёмник остаётся пустым.
      -->
      <xpath expr="//page[@name='pmk_main']" position="replace" mode="inner">
        <xpath expr="(//sheet)[1]/group[.//div[hasclass('o_address_format')]]"
               position="move"/>
        <xpath expr="(//sheet)[1]/div[field[@name='properties']]"
               position="move"/>
      </xpath>

    </field>
  </record>

</odoo>
