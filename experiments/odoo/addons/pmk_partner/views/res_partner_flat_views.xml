<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!--
    Карточка контрагента одним списком вместо вкладок.

    Почему переносим узлы, а не объявляем поля заново: на форме 28 наследованных
    представлений, у полей свои `groups=` и `invisible=`, и переписывание их
    вручную рано или поздно откроет снабженцу счета учёта. Перенос сохраняет
    все атрибуты как есть.

    Приоритет 99 — чтобы представление применялось ПОСЛЕДНИМ. Иначе чужие
    модули, дописывающие внутрь страниц (stock, account_add_gln, l10n_ru_doc),
    положат своё уже в опустевшую страницу, и поля тихо исчезнут.

    ВАЖНО про синтаксис, дважды проверено на живой форме:
    1) узел `<xpath position="move"/>` обязан быть ПРЯМЫМ потомком
       спецификации-приёмника; вложенный глубже он не выполняется, а
       вставляется в разметку как есть;
    2) `position="inside"` перенос НЕ выполняет вовсе — ядро обрабатывает
       `move` только в ветках `before` и `replace`
       (odoo/tools/template_inheritance.py:45, 210, 214). Поэтому приёмник
       объявлен как `position="replace" mode="inner"`: там ядро ставит
       sentinel специально ради переноса существующих узлов внутрь.

    Обе ошибки стоили сломанной карточки: секции выходили пустыми, а блокнот
    был уже скрыт — форма оставалась без единого поля.
  -->
  <record id="view_partner_form_flat" model="ir.ui.view">
    <field name="name">res.partner.form.pmk.flat</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="priority">99</field>

    <!--
      Включение держим кодом, а не состоянием базы. Прецедент 2026-09-20:
      представление оказалось выключенным на стенде (active=f) — плоских
      секций не видел никто, ни у клиента, ни у поставщика, хотя само оно
      исправно: при включении применяется без ошибок. Обновление модуля его
      не возвращало, потому что поля active в записи не было, а деплой прятал
      предупреждения фильтром вывода. Теперь состояние приезжает с кодом.
    -->
    <field name="active">True</field>
    <field name="arch" type="xml">

      <!-- Шаг 1: пустые секции в листе, в нужном порядке. -->
      <xpath expr="//notebook" position="before">
        <group string="Реквизиты" name="pmk_s_requisites" class="pmk-section"/>
        <group string="Контактные лица" name="pmk_s_contacts"
               class="pmk-section pmk-section--closed"/>
        <group string="Продажи и закупки" name="pmk_s_trade"
               class="pmk-section pmk-section--closed"/>
        <group string="Банковские счета" name="pmk_s_bank"
               class="pmk-section pmk-section--closed"/>
        <!-- Права и условие видимости переезжают со страницы на секцию:
             без них счета учёта увидел бы кто угодно. -->
        <group string="Выставление счетов" name="pmk_s_accounting"
               class="pmk-section pmk-section--closed"
               groups="account.group_account_invoice,account.group_account_readonly"
               invisible="not is_company and parent_id"/>
        <group string="Заметки" name="pmk_s_notes"
               class="pmk-section pmk-section--closed"/>
      </xpath>

      <!-- Шаг 2: переносим содержимое вкладок в секции. -->
      <!--
        Секции «Реквизиты» и «Банковские счета» наполняет pmk_dadata, а не этот
        файл, и это не вкусовщина. Страницу «Реквизиты» создаёт pmk_dadata,
        который зависит от pmk_partner, — обратной связи нет. Во время загрузки
        Odoo собирает представление ТОЛЬКО из уже загруженных модулей, поэтому
        отсюда той страницы ещё не видно, и перенос падал с «cannot be located
        in parent view». Представление из-за этого держали выключенным, и
        плоских секций не видел никто (обнаружено 2026-09-20).
        Приёмники стоят выше пустыми, наполнение — в pmk_dadata с приоритетом 100.
      -->

      <xpath expr="//group[@name='pmk_s_contacts']" position="replace" mode="inner">
        <xpath expr="//page[@name='contact_addresses']/field[@name='child_ids']"
               position="move"/>
      </xpath>

      <xpath expr="//group[@name='pmk_s_trade']" position="replace" mode="inner">
        <xpath expr="//page[@name='sales_purchases']/group[@name='container_row_2']"
               position="move"/>
      </xpath>

      <xpath expr="//group[@name='pmk_s_accounting']" position="replace" mode="inner">
        <xpath expr="//page[@name='accounting']/group[1]" position="move"/>
      </xpath>

      <xpath expr="//group[@name='pmk_s_notes']" position="replace" mode="inner">
        <xpath expr="//page[@name='internal_notes']/field[@name='comment']"
               position="move"/>
        <xpath expr="//page[@name='internal_notes']/group[@name='warnings']"
               position="move"/>
      </xpath>

      <!-- Шаг 3: блокнот скрываем, а не удаляем — чужие xpath продолжают
           находить свои узлы, и обновление сторонних модулей не падает. -->
      <notebook position="attributes">
        <attribute name="invisible">1</attribute>
      </notebook>

      <!-- Шаг 4: пустые заголовки штатных групп.
           Содержимое из них мы разнесли по своим секциям выше, но сами
           заголовки остались висеть в карточке — замер на боевой карточке
           поставщика: «Фискальная информация» и «Прочее» без единого поля
           внутри. Прячем их тем же способом, что и блокнот: атрибутом, а не
           удалением узла, чтобы xpath чужих модулей продолжали находить свои
           места и обновление account не падало. -->
      <xpath expr="//group[@name='fiscal_information']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

      <xpath expr="//group[@name='misc']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

    </field>
  </record>

</odoo>
