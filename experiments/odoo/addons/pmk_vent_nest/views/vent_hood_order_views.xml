<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    Заказ вентзонтов: таблица размеров уходит во вкладку «Размеры» (перенос
    position="move" — тот же узел, xpath соседей и виджет pmk_vent_hood_lines
    не меняются), рядом вкладка «Раскрой». Вкладку «Файлы» тема (шаг 65)
    добавляет сама — туда ложатся программы CypCut.
    active в XML — грабли Odoo 19 (выключенный вид не проверяется).
  -->
  <record id="view_vent_hood_order_form_nest" model="ir.ui.view">
    <field name="name">pmk.vent.hood.order.form.nest</field>
    <field name="model">pmk.vent.hood.order</field>
    <field name="inherit_id" ref="pmk_calc.view_vent_hood_order_form"/>
    <field name="active" eval="True"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='line_ids']" position="before">
        <notebook name="pmk_nest_notebook">
          <page string="Размеры" name="pmk_sizes"/>
          <page string="Раскрой" name="pmk_nest">
            <div class="pmk-nest-run">
              <div class="pmk-nest-run__params">
                <label for="nest_gap"/>
                <field name="nest_gap" nolabel="1" readonly="nest_busy"/>
                <label for="nest_edge"/>
                <field name="nest_edge" nolabel="1" readonly="nest_busy"/>
                <button name="action_nest_plan" type="object" class="btn-secondary"
                        icon="fa-th-large" string="Рассчитать раскрой" invisible="nest_busy"/>
              </div>
              <field name="nest_busy" invisible="1"/>
              <field name="nest_status_kind" invisible="1"/>
              <div class="pmk-nest-status text-danger" invisible="nest_status_kind != 'error'">
                <i class="fa fa-exclamation-triangle me-1"/>
                <field name="nest_status" nolabel="1"/>
              </div>
              <div class="pmk-nest-status" invisible="nest_status_kind in ('none', 'error')">
                <i class="fa fa-spinner fa-spin me-1" invisible="nest_status_kind != 'busy'"/>
                <i class="fa fa-exclamation-triangle me-1 text-warning" invisible="nest_status_kind != 'stale'"/>
                <field name="nest_status" nolabel="1"/>
              </div>
              <div class="pmk-nest-status pmk-nest-muted" invisible="nest_status_kind != 'none'">
                Раскрой раскладывает детали заказа на лист 1250 — склад (2500) и бухта (длина кратна 50,
                до 3000) — и сразу перебирает свес 150…125. Считается в фоне несколько минут; можно
                уйти с экрана — придёт уведомление.
              </div>
            </div>
            <div invisible="not nest_material_ids">
              <h3 class="pmk-nest-h">Решение по каждому цвету: щёлкните ячейку — свес и лист</h3>
              <field name="nest_material_ids" widget="pmk_nest_choice" nolabel="1" readonly="nest_busy"/>
              <button name="action_nest_build" type="object" class="btn-secondary mt-2"
                      icon="fa-check" string="Принять решение и собрать программы" invisible="nest_busy"/>
              <div class="pmk-nest-muted mt-1">
                Свес записывается в заказ — заготовки, сборочная ведомость, DXF и чертежи
                пересчитаются под решение; программы CypCut появятся во вкладке «Файлы».
              </div>
            </div>
            <field name="nest_png" widget="image" nolabel="1" readonly="1"
                   class="pmk-nest-png" invisible="not nest_png"/>
          </page>
        </notebook>
      </xpath>
      <xpath expr="//page[@name='pmk_sizes']" position="inside">
        <xpath expr="//field[@name='line_ids']" position="move"/>
      </xpath>
    </field>
  </record>
</odoo>
