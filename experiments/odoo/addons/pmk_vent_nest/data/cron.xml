<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Раз в минуту: забрать готовый раскрой, запустить следующий из очереди.
       Кнопка «Рассчитать» сама дёргает задание (_trigger) — первое ожидание
       короче минуты. -->
  <record id="cron_vent_nest" model="ir.cron">
    <field name="name">Раскрой вентзонтов: забрать результат</field>
    <field name="model_id" ref="model_pmk_vent_nest_job"/>
    <field name="state">code</field>
    <field name="code">model._cron_collect()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">minutes</field>
    <field name="active" eval="True"/>
  </record>
</odoo>
