<?xml version="1.0" encoding="UTF-8"?>
<!-- «Конструкции» — таблица Бутика в расчёте (20.10.2026), js/konstr_grid.js. Разметка —
     копия pmk_butik.Grid (xml/butik_grid.xml) с переключателем «Таблица / Подробно» и
     колонками «Металл, ₽» и «Цена за шт». Правишь одну — сверь другую. -->
<templates xml:space="preserve">
  <t t-name="pmk_butik.KonstrGrid">
    <div class="o_pmk_butik o_pmk_konstr" t-ref="root" t-att-data-mode="view.mode">
      <div class="o_pmk_konstr__mode btn-group btn-group-sm" role="group" aria-label="Вид состава">
        <button type="button" class="btn" t-att-class="view.mode === 'table' ? 'btn-secondary active' : 'btn-light'"
                t-on-click="() => this.setMode('table')" title="Таблица как в Excel: короткая запись, стрелки, вставка из Excel">
          <i class="fa fa-table me-1" aria-hidden="true"/>Таблица</button>
        <button type="button" class="btn" t-att-class="view.mode === 'detail' ? 'btn-secondary active' : 'btn-light'"
                t-on-click="() => this.setMode('detail')" title="Прежний редактор: раскладка листа, позиции «на разнос», цена закупки строкой">
          <i class="fa fa-list me-1" aria-hidden="true"/>Подробно</button>
      </div>
      <t t-if="view.mode === 'table'">
      <div t-if="!specId" class="o_pmk_butik__start">
        <button type="button" class="btn btn-primary" t-on-click="() => this.start()">
          <i class="fa fa-table me-1" aria-hidden="true"/>Начать состав</button>
        <span class="o_pmk_butik__muted">расчёт сохранится, и откроется таблица конструкций</span>
      </div>
      <p t-elif="state.loading or !state.data" class="o_pmk_butik__muted">Загружаю…</p>
      <t t-else="">
        <div class="o_pmk_butik__bar">
          <button type="button" class="btn btn-secondary btn-sm" t-att-disabled="state.busy" t-on-click="() => this.addRow()">
            <i class="fa fa-plus me-1" aria-hidden="true"/>Строка</button>
          <button type="button" class="btn btn-secondary btn-sm" t-att-disabled="state.busy" t-on-click="() => this.addProduct()" title="Ctrl+Enter (на Mac — Cmd+Enter)">
            <i class="fa fa-cube me-1" aria-hidden="true"/>Изделие</button>
          <button type="button" class="btn btn-secondary btn-sm" t-att-disabled="state.busy" t-on-click="() => this.duplicate()">
            <i class="fa fa-clone me-1" aria-hidden="true"/>Копия строки</button>
          <button type="button" class="btn btn-link btn-sm text-muted" t-att-disabled="state.busy" t-on-click="() => this.remove()">
            <i class="fa fa-trash-o me-1" aria-hidden="true"/>Удалить строку</button>
          <!-- №314: ручные цены — только кнопкой (было → стало при уходе со страницы, js/price_pending.js). -->
          <t t-if="pendingCount">
            <button type="button" class="btn btn-primary btn-sm" t-att-disabled="state.busy" t-on-click="() => this.savePrices()">
              <i class="fa fa-floppy-o me-1" aria-hidden="true"/>Сохранить цены (<t t-esc="pendingCount"/>)</button>
            <button type="button" class="btn btn-link btn-sm" t-att-disabled="state.busy" t-on-click="() => this.discardPrices()">Отменить</button>
          </t>
          <span class="o_pmk_butik__saved" t-att-class="{ 'o_pmk_butik__saved--busy': state.busy, 'o_pmk_konstr__unsaved': pendingCount and !state.busy }">
            <t t-if="state.busy">Сохраняю…</t>
            <t t-elif="pendingCount"><i class="fa fa-exclamation-circle me-1" aria-hidden="true"/>Цены не сохранены: <t t-esc="pendingCount"/></t>
            <t t-elif="state.savedAt"><i class="fa fa-check me-1" aria-hidden="true"/>Сохранено в <t t-esc="state.savedAt"/></t>
            <t t-else=""><i class="fa fa-check me-1" aria-hidden="true"/>Каждая ячейка сохраняется сама</t>
          </span>
          <span class="o_pmk_butik__hint">Enter, ↑↓ ←→, Tab · Ctrl+Enter — новое изделие · Ctrl+D — значение сверху · Ctrl+V — блок из Excel или столбик строк</span>
        </div>
        <div class="o_pmk_butik__wrap">
          <table class="o_pmk_butik__table">
            <colgroup>
              <!-- Наименование — без ширины: берёт всё, что осталось (№312: + ручка и действия). -->
              <col style="width:22px"/>
              <col style="width:60px"/><col/><col style="width:84px"/><col style="width:84px"/><col style="width:64px"/>
              <col style="width:60px"/><col style="width:76px"/><col style="width:74px"/><col style="width:90px"/>
              <col style="width:92px"/><col style="width:92px"/><col style="width:92px"/><col style="width:104px"/>
              <col style="width:52px"/>
            </colgroup>
            <thead><tr>
              <th class="o_pmk_butik__th-grip"/><th class="o_pmk_butik__th-pos"><button type="button" class="o_pmk_butik__chev" t-att-class="{ 'o_pmk_butik__chev--open': allOpen }"
                  t-att-title="allOpen ? 'Свернуть все изделия' : 'Развернуть все изделия'"
                  t-on-click="() => this.toggleAll()"/>№ поз.</th><th>Наименование</th><th class="n" title="Для листовых деталей: «Лист 10х60» заполнит сам">Ширина, мм</th><th class="n">Длина, мм</th><th class="n">На 1 шт</th>
              <th class="n">Всего</th><th>Марка</th><th class="n">Вес 1, кг</th><th class="n" title="Впишите массу из спецификации КМ — длина проката посчитается сама; пусто — вес по размерам">Вес всего, кг</th>
              <th class="n" title="Закупка металла по прайсам: у детали — на все изделия, у изделия — итог">Металл, ₽</th>
              <th class="n" title="Цена металла детали за тонну: по прайсу (серым) или вписанная вручную, если позиции в прайсах нет">Металл, ₽/т</th>
              <th class="n" title="Цена клиенту за тонну изделия: цена за шт посчитается из веса">Клиенту, ₽/т</th>
              <th class="n" title="Цена клиенту за одно изделие">Клиенту, ₽/шт</th>
            <th/></tr></thead>
            <tbody>
              <t t-foreach="rows" t-as="row" t-key="row.id">
                <tr t-if="row.kind === 'product'" class="o_pmk_butik__product" t-att-draggable="state.data.can_write ? 'true' : 'false'" t-att-data-over="state.over === row.id ? '1' : ''" t-on-dragstart="(ev) => this.onRowDragStart(row, ev)" t-on-dragend="(ev) => this.onRowDragEnd(ev)" t-on-dragover="(ev) => this.onRowDragOver(row, ev)" t-on-drop="(ev) => this.onRowDrop(row, ev)">
                  <td class="o_pmk_butik__grip" title="Перетащить строку" t-on-mousedown="() => this.armDrag()">⠿</td>
                  <td class="n o_pmk_butik__num">
                    <button type="button" class="o_pmk_butik__chev" t-att-class="{ 'o_pmk_butik__chev--open': !isCollapsed(row.id) }"
                            t-att-title="isCollapsed(row.id) ? 'Развернуть' : 'Свернуть'"
                            t-on-click="() => this.toggle(row.id)"/>
                    <t t-esc="row.number"/>
                  </td>
                  <td colspan="4" t-att-class="{ sel: isSel(row_index, 'name') }">
                    <!-- Наименование — textarea (как у Бутика): длинное название переносится, строка
                         растёт (Антон 16.10). Enter в ней — переход ниже, как везде. -->
                    <textarea rows="1" class="o_pmk_butik__in o_pmk_butik__in--product o_pmk_butik__ta" t-att-value="val(row, 'name')"
                           t-att-data-index="row_index" t-att-data-key="row.id" data-col="name" t-att-readonly="!state.data.can_write"
                           placeholder="Изделие: название, шифр, покрытие"
                           t-on-focus="() => this.onFocus(row_index, 'name')"
                           t-on-input="(ev) => this.onInput(row, row_index, 'name', ev)"
                           t-on-change="(ev) => this.commit(row, 'name', ev)"
                           t-on-keydown="(ev) => this.onKeydown(row_index, 'name', ev)"/>
                  </td>
                  <td t-att-class="{ sel: isSel(row_index, 'product_qty') }">
                    <input class="o_pmk_butik__in n" t-att-value="val(row, 'product_qty')" inputmode="numeric"
                           t-att-data-index="row_index" t-att-data-key="row.id" data-col="product_qty" t-att-readonly="!state.data.can_write"
                           t-on-focus="() => this.onFocus(row_index, 'product_qty')"
                           t-on-input="(ev) => this.onInput(row, row_index, 'product_qty', ev)"
                           t-on-change="(ev) => this.commit(row, 'product_qty', ev)"
                           t-on-keydown="(ev) => this.onKeydown(row_index, 'product_qty', ev)"/>
                  </td>
                  <td class="o_pmk_butik__muted-cell o_pmk_butik__nowrap">изд., шт<t t-if="isCollapsed(row.id) and childCount(row.id)"> · <t t-esc="childCount(row.id)"/> дет.</t></td>
                  <td class="n o_pmk_butik__ro o_pmk_butik__pw" title="Вес одного изделия" t-esc="kg(row.weight_one)"/>
                  <td class="n o_pmk_butik__ro o_pmk_butik__pw" title="Вес изделий всего" t-esc="kg(row.weight_total)"/>
                  <td class="n o_pmk_butik__ro o_pmk_butik__pw" title="Металл по прайсам на все изделия" t-esc="money(row.cost)"/>
                  <td class="o_pmk_butik__ro o_pmk_butik__pw"/>
                  <td t-att-class="{ sel: isSel(row_index, 'price_ton') }">
                    <input class="o_pmk_butik__in n o_pmk_konstr__price" t-att-value="val(row, 'price_ton')" inputmode="decimal"
                           t-att-data-index="row_index" t-att-data-key="row.id" data-col="price_ton" t-att-readonly="!state.data.can_write"
                           placeholder="за т"
                           t-on-focus="() => this.onFocus(row_index, 'price_ton')"
                           t-on-input="(ev) => this.onInput(row, row_index, 'price_ton', ev)"
                           t-on-change="(ev) => this.commit(row, 'price_ton', ev)"
                           t-on-keydown="(ev) => this.onKeydown(row_index, 'price_ton', ev)"/>
                  </td>
                  <td t-att-class="{ sel: isSel(row_index, 'price') }">
                    <input class="o_pmk_butik__in n o_pmk_konstr__price" t-att-value="val(row, 'price')" inputmode="decimal"
                           t-att-data-index="row_index" t-att-data-key="row.id" data-col="price" t-att-readonly="!state.data.can_write"
                           placeholder="цена"
                           t-on-focus="() => this.onFocus(row_index, 'price')"
                           t-on-input="(ev) => this.onInput(row, row_index, 'price', ev)"
                           t-on-change="(ev) => this.commit(row, 'price', ev)"
                           t-on-keydown="(ev) => this.onKeydown(row_index, 'price', ev)"/>
                  </td>
                <td class="o_pmk_butik__acts">
                    <button type="button" class="btn btn-link btn-sm" title="Копировать — копия встанет ниже" aria-label="Копировать"
                            t-att-disabled="state.busy or !state.data.can_write" t-on-click="() => this.copyRow(row)"><i class="fa fa-clone"/></button>
                    <button type="button" class="btn btn-link btn-sm o_pmk_butik__del" title="Удалить строку" aria-label="Удалить"
                            t-att-disabled="state.busy or !state.data.can_write" t-on-click="() => this.deleteRow(row)"><i class="fa fa-trash-o"/></button>
                  </td>
                </tr>
                <tr t-elif="!isCollapsed(row.parent)" class="o_pmk_butik__detail" t-att-class="{ 'o_pmk_butik__detail--bad': row.match_state === 'none' }" t-att-draggable="state.data.can_write ? 'true' : 'false'" t-att-data-over="state.over === row.id ? '1' : ''" t-on-dragstart="(ev) => this.onRowDragStart(row, ev)" t-on-dragend="(ev) => this.onRowDragEnd(ev)" t-on-dragover="(ev) => this.onRowDragOver(row, ev)" t-on-drop="(ev) => this.onRowDrop(row, ev)">
                  <td class="o_pmk_butik__grip" title="Перетащить строку" t-on-mousedown="() => this.armDrag()">⠿</td>
                  <t t-foreach="['pos', 'name', 'width', 'length_mm', 'qty']" t-as="col" t-key="col">
                    <td t-if="col === 'width' and !row.is_sheet" class="o_pmk_butik__ro"/>
                    <td t-else="" t-att-class="{ sel: isSel(row_index, col), n: isNum(col), 'o_pmk_butik__namecell': col === 'name' }">
                      <textarea t-if="col === 'name'" rows="1" class="o_pmk_butik__in o_pmk_butik__ta"
                             t-att-value="val(row, col)" t-att-data-index="row_index" t-att-data-key="row.id" data-col="name"
                             t-att-readonly="!state.data.can_write"
                             placeholder="Уголок 63х4 · коротко: д1 шв10 1200мм 10шт 09г · лист: т1 10мм 100х100мм 10шт"
                             t-on-focus="() => this.onFocus(row_index, col)"
                             t-on-input="(ev) => this.onInput(row, row_index, col, ev)"
                             t-on-change="(ev) => this.commit(row, col, ev)"
                             t-on-keydown="(ev) => this.onKeydown(row_index, col, ev)"
                             t-on-paste="(ev) => this.onPaste(row_index, ev)"/>
                      <input t-else="" class="o_pmk_butik__in" t-att-class="{ n: isNum(col), o_pmk_konstr__derived: col === 'length_mm' and row.length_derived }"
                             t-att-value="val(row, col)" t-att-data-index="row_index" t-att-data-key="row.id" t-att-data-col="col"
                             t-att-readonly="!state.data.can_write"
                             t-on-focus="() => this.onFocus(row_index, col)"
                             t-on-input="(ev) => this.onInput(row, row_index, col, ev)"
                             t-on-change="(ev) => this.commit(row, col, ev)"
                             t-on-keydown="(ev) => this.onKeydown(row_index, col, ev)"
                             t-on-paste="(ev) => this.onPaste(row_index, ev)"/>
                      <div t-if="col === 'name' and row.label" class="o_pmk_butik__rec"
                           t-att-class="{ 'o_pmk_butik__rec--bad': row.match_state === 'none' }" t-esc="row.label"/>
                      <!-- №314: та же позиция вручную в другом расчёте — подсказка со ссылкой, подставить щелчком. -->
                      <div t-if="col === 'name' and row.manual_hint" class="o_pmk_konstr__hint"
                           t-att-title="'Та же позиция и марка, цена вписана вручную ' + row.manual_hint.date + ' в расчёте ' + row.manual_hint.spec">
                        вручную в <a t-att-href="'/odoo/pmk.metal.spec/' + row.manual_hint.spec_id" target="_blank"
                                     t-esc="row.manual_hint.spec"/>: <t t-esc="money(row.manual_hint.price)"/> ₽/т ·
                        <button type="button" class="btn btn-link btn-sm p-0 align-baseline o_pmk_konstr__hint-use"
                                t-att-disabled="!state.data.can_write" t-on-click="() => this.useManualHint(row)">подставить</button>
                      </div>
                      <!-- Каталог материалов (26.10.2026): найти позицию глазами, если запись не попала. -->
                      <button t-if="col === 'name' and state.data.can_write" type="button" class="o_pmk_butik__cat"
                              title="Каталог материалов — найти позицию вручную"
                              t-on-mousedown.prevent="() => this.openCatalog(row_index)"><i class="fa fa-book"/></button>
                      <div t-if="col === 'name' and state.suggest and state.suggestRow === row_index" class="o_pmk_butik__suggest">
                        <div t-foreach="state.suggest" t-as="item" t-key="item.key" class="o_pmk_butik__sitem"
                             t-att-class="{ 'o_pmk_butik__sitem--active': item_index === state.suggestIdx }"
                             t-on-mousedown="(ev) => this.choose(row_index, item, ev)">
                          <span class="o_pmk_butik__skind" t-esc="item.kind"/>
                          <span t-esc="item.label"/>
                        </div>
                      </div>
                    </td>
                  </t>
                  <td class="n o_pmk_butik__ro" t-esc="total(row)"/>
                  <td t-att-class="{ sel: isSel(row_index, 'grade') }">
                    <input class="o_pmk_butik__in" t-att-value="val(row, 'grade')" t-att-data-index="row_index" t-att-data-key="row.id"
                           data-col="grade" t-att-readonly="!state.data.can_write"
                           t-on-focus="() => this.onFocus(row_index, 'grade')"
                           t-on-input="(ev) => this.onInput(row, row_index, 'grade', ev)"
                           t-on-change="(ev) => this.commit(row, 'grade', ev)"
                           t-on-keydown="(ev) => this.onKeydown(row_index, 'grade', ev)"
                           t-on-paste="(ev) => this.onPaste(row_index, ev)"/>
                  </td>
                  <td class="n o_pmk_butik__ro" t-esc="kg(row.weight_one)"/>
                  <td t-att-class="{ sel: isSel(row_index, 'mass') }">
                    <input class="o_pmk_butik__in n o_pmk_konstr__mass" t-att-class="{ 'o_pmk_konstr__mass--km': row.by_mass }"
                           t-att-value="val(row, 'mass')" inputmode="decimal" t-att-placeholder="kg(row.weight_total)"
                           t-att-title="row.by_mass ? 'Масса по КМ: длина выведена из неё. Сотрите — вес снова по размерам' : 'Впишите массу по КМ — длина посчитается сама'"
                           t-att-data-index="row_index" t-att-data-key="row.id" data-col="mass" t-att-readonly="!state.data.can_write"
                           t-on-focus="() => this.onFocus(row_index, 'mass')"
                           t-on-input="(ev) => this.onInput(row, row_index, 'mass', ev)"
                           t-on-change="(ev) => this.commit(row, 'mass', ev)"
                           t-on-keydown="(ev) => this.onKeydown(row_index, 'mass', ev)"
                           t-on-paste="(ev) => this.onPaste(row_index, ev)"/>
                  </td>
                  <td class="n o_pmk_butik__ro">
                    <span t-if="row.no_price" class="o_pmk_konstr__noprice" title="Позиции нет в прайсах — металл не посчитан. Впишите цену за тонну в ячейку «Металл, ₽/т»">нет цены</span>
                    <t t-else="" t-esc="money(row.cost)"/>
                  </td>
                  <!-- №314: «Металл, ₽/т» детали: из прайса серым; нет в прайсах — вписать. -->
                  <td t-if="row.can_manual" t-att-class="{ sel: isSel(row_index, 'metal_ton') }">
                    <input class="o_pmk_butik__in n o_pmk_konstr__price o_pmk_konstr__manual"
                           t-att-class="{ 'o_pmk_konstr__manual--set': row.manual and !isPending(row), 'o_pmk_konstr__manual--pending': isPending(row) }"
                           t-att-value="val(row, 'metal_ton')" inputmode="decimal" placeholder="₽/т"
                           t-att-title="isPending(row) ? 'Не сохранено — кнопка «Сохранить цены» над таблицей' : (row.manual ? 'Цена вручную: позиции нет в прайсах. Сотрите — снова «нет цены»' : 'Позиции нет в прайсах — впишите примерную цену металла за тонну и нажмите «Сохранить цены»')"
                           t-att-data-index="row_index" t-att-data-key="row.id" data-col="metal_ton" t-att-readonly="!state.data.can_write"
                           t-on-focus="() => this.onFocus(row_index, 'metal_ton')"
                           t-on-input="(ev) => this.onInput(row, row_index, 'metal_ton', ev)"
                           t-on-change="(ev) => this.commit(row, 'metal_ton', ev)"
                           t-on-keydown="(ev) => this.onKeydown(row_index, 'metal_ton', ev)"/>
                  </td>
                  <td t-else="" class="n o_pmk_butik__ro o_pmk_konstr__ton"
                      title="Цена металла за тонну по прайсу" t-esc="money(row.metal_ton)"/>
                  <td class="o_pmk_butik__ro"/>
                  <td class="o_pmk_butik__ro"/>
                <td class="o_pmk_butik__acts">
                    <button type="button" class="btn btn-link btn-sm" title="Копировать — копия встанет ниже" aria-label="Копировать"
                            t-att-disabled="state.busy or !state.data.can_write" t-on-click="() => this.copyRow(row)"><i class="fa fa-clone"/></button>
                    <button type="button" class="btn btn-link btn-sm o_pmk_butik__del" title="Удалить строку" aria-label="Удалить"
                            t-att-disabled="state.busy or !state.data.can_write" t-on-click="() => this.deleteRow(row)"><i class="fa fa-trash-o"/></button>
                  </td>
                </tr>
              </t>
            </tbody>
          </table>
        </div>
        <div class="o_pmk_butik__total">
          Изделий: <b t-esc="state.data.products"/> · Металл всего: <b><t t-esc="kg(state.data.weight_kg) or '0'"/> кг</b>
          <t t-if="state.data.cost"> · по прайсам <b><t t-esc="money(state.data.cost)"/> ₽</b></t>
        </div>
      </t>
    </t>
    </div>
  </t>
</templates>
