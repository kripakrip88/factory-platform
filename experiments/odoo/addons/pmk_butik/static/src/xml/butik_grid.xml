<?xml version="1.0" encoding="UTF-8"?>
<!-- Бутик — таблица спецификации как в Excel (15.10.2026), js/butik_grid.js. -->
<templates xml:space="preserve">
  <t t-name="pmk_butik.Grid">
    <div class="o_pmk_butik" t-ref="root">
      <div t-if="!specId" class="o_pmk_butik__start">
        <button type="button" class="btn btn-primary" t-on-click="() => this.start()">
          <i class="fa fa-table me-1" aria-hidden="true"/>Начать спецификацию</button>
        <span class="o_pmk_butik__muted">расчёт сохранится, и откроется таблица</span>
      </div>
      <p t-elif="state.loading or !state.data" class="o_pmk_butik__muted">Загружаю…</p>
      <t t-else="">
        <div class="o_pmk_butik__bar">
          <button type="button" class="btn btn-secondary btn-sm" t-att-disabled="state.busy" t-on-click="() => this.addRow()">
            <i class="fa fa-plus me-1" aria-hidden="true"/>Строка</button>
          <button type="button" class="btn btn-secondary btn-sm" t-att-disabled="state.busy" t-on-click="() => this.addProduct()" title="Ctrl+Enter (на Mac — Cmd+Enter)">
            <i class="fa fa-cube me-1" aria-hidden="true"/>Изделие</button>
          <button type="button" class="btn btn-secondary btn-sm" t-att-disabled="state.busy" t-on-click="() => this.duplicate()">
            <i class="fa fa-clone me-1" aria-hidden="true"/>Копия строки</button>
          <button type="button" class="btn btn-link btn-sm text-muted" t-att-disabled="state.busy" t-on-click="() => this.remove()">
            <i class="fa fa-trash-o me-1" aria-hidden="true"/>Удалить строку</button>
          <span class="o_pmk_butik__saved" t-att-class="{ 'o_pmk_butik__saved--busy': state.busy }">
            <t t-if="state.busy">Сохраняю…</t>
            <t t-elif="state.savedAt"><i class="fa fa-check me-1" aria-hidden="true"/>Сохранено в <t t-esc="state.savedAt"/></t>
            <t t-else=""><i class="fa fa-check me-1" aria-hidden="true"/>Каждая ячейка сохраняется сама</t>
          </span>
          <span class="o_pmk_butik__hint">Enter, ↑↓ ←→, Tab · Ctrl+Enter — новое изделие · Ctrl+D — значение сверху · Ctrl+V — блок из Excel или столбик строк</span>
        </div>
        <div class="o_pmk_butik__wrap">
          <table class="o_pmk_butik__table">
            <colgroup>
              <col style="width:22px"/>
              <col style="width:64px"/><col/><col style="width:90px"/><col style="width:96px"/><col style="width:80px"/>
              <col style="width:76px"/><col style="width:96px"/><col style="width:90px"/><col style="width:110px"/>
              <col style="width:52px"/>
            </colgroup>
            <thead><tr>
              <th class="o_pmk_butik__th-grip"/><th class="o_pmk_butik__th-pos"><button type="button" class="o_pmk_butik__chev" t-att-class="{ 'o_pmk_butik__chev--open': allOpen }"
                  t-att-title="allOpen ? 'Свернуть все изделия' : 'Развернуть все изделия'"
                  t-on-click="() => this.toggleAll()"/>№ поз.</th><th>Наименование</th><th class="n" title="Для листовых деталей: «Лист 10х60» заполнит сам">Ширина, мм</th><th class="n">Длина, мм</th><th class="n">На 1 шт</th>
              <th class="n">Всего</th><th>Марка</th><th class="n">Вес 1, кг</th><th class="n">Вес всего, кг</th>
            <th/></tr></thead>
            <tbody>
              <t t-foreach="rows" t-as="row" t-key="row.id">
                <tr t-if="row.kind === 'product'" class="o_pmk_butik__product" t-att-draggable="state.data.can_write ? 'true' : 'false'" t-att-data-over="state.over === row.id ? '1' : ''" t-on-dragstart="(ev) => this.onRowDragStart(row, ev)" t-on-dragend="(ev) => this.onRowDragEnd(ev)" t-on-dragover="(ev) => this.onRowDragOver(row, ev)" t-on-drop="(ev) => this.onRowDrop(row, ev)">
                  <td class="o_pmk_butik__grip" title="Перетащить строку" t-on-mousedown="() => this.armDrag()">⠿</td>
                  <td class="n o_pmk_butik__num">
                    <button type="button" class="o_pmk_butik__chev" t-att-class="{ 'o_pmk_butik__chev--open': !isCollapsed(row.id) }"
                            t-att-title="isCollapsed(row.id) ? 'Развернуть' : 'Свернуть'"
                            t-on-click="() => this.toggle(row.id)"/>
                    <t t-esc="row.number"/>
                  </td>
                  <td colspan="4" t-att-class="{ sel: isSel(row_index, 'name') }">
                    <!-- Наименование — textarea: длинное название переносится, строка
                         растёт (Антон 16.10). Enter в ней — переход ниже, как везде. -->
                    <textarea rows="1" class="o_pmk_butik__in o_pmk_butik__in--product o_pmk_butik__ta" t-att-value="val(row, 'name')"
                           t-att-data-index="row_index" t-att-data-key="row.id" data-col="name" t-att-readonly="!state.data.can_write"
                           placeholder="Изделие: название, шифр, покрытие"
                           t-on-focus="() => this.onFocus(row_index, 'name')"
                           t-on-input="(ev) => this.onInput(row, row_index, 'name', ev)"
                           t-on-change="(ev) => this.commit(row, 'name', ev)"
                           t-on-keydown="(ev) => this.onKeydown(row_index, 'name', ev)"/>
                  </td>
                  <td t-att-class="{ sel: isSel(row_index, 'product_qty') }">
                    <input class="o_pmk_butik__in n" t-att-value="val(row, 'product_qty')" inputmode="numeric"
                           t-att-data-index="row_index" t-att-data-key="row.id" data-col="product_qty" t-att-readonly="!state.data.can_write"
                           t-on-focus="() => this.onFocus(row_index, 'product_qty')"
                           t-on-input="(ev) => this.onInput(row, row_index, 'product_qty', ev)"
                           t-on-change="(ev) => this.commit(row, 'product_qty', ev)"
                           t-on-keydown="(ev) => this.onKeydown(row_index, 'product_qty', ev)"/>
                  </td>
                  <td class="o_pmk_butik__muted-cell o_pmk_butik__nowrap">изд., шт<t t-if="isCollapsed(row.id) and childCount(row.id)"> · <t t-esc="childCount(row.id)"/> дет.</t></td>
                  <td class="n o_pmk_butik__ro o_pmk_butik__pw" title="Вес одного изделия" t-esc="kg(row.weight_one)"/>
                  <td class="n o_pmk_butik__ro o_pmk_butik__pw" title="Вес изделий всего" t-esc="kg(row.weight_total)"/>
                <td class="o_pmk_butik__acts">
                    <button type="button" class="btn btn-link btn-sm" title="Копировать — копия встанет ниже" aria-label="Копировать"
                            t-att-disabled="state.busy or !state.data.can_write" t-on-click="() => this.copyRow(row)"><i class="fa fa-clone"/></button>
                    <button type="button" class="btn btn-link btn-sm o_pmk_butik__del" title="Удалить строку" aria-label="Удалить"
                            t-att-disabled="state.busy or !state.data.can_write" t-on-click="() => this.deleteRow(row)"><i class="fa fa-trash-o"/></button>
                  </td>
                </tr>
                <tr t-elif="!isCollapsed(row.parent)" class="o_pmk_butik__detail" t-att-class="{ 'o_pmk_butik__detail--bad': row.match_state === 'none' }" t-att-draggable="state.data.can_write ? 'true' : 'false'" t-att-data-over="state.over === row.id ? '1' : ''" t-on-dragstart="(ev) => this.onRowDragStart(row, ev)" t-on-dragend="(ev) => this.onRowDragEnd(ev)" t-on-dragover="(ev) => this.onRowDragOver(row, ev)" t-on-drop="(ev) => this.onRowDrop(row, ev)">
                  <td class="o_pmk_butik__grip" title="Перетащить строку" t-on-mousedown="() => this.armDrag()">⠿</td>
                  <t t-foreach="['pos', 'name', 'width', 'length_mm', 'qty']" t-as="col" t-key="col">
                    <td t-if="col === 'width' and !row.is_sheet" class="o_pmk_butik__ro"/>
                    <td t-else="" t-att-class="{ sel: isSel(row_index, col), n: isNum(col), 'o_pmk_butik__namecell': col === 'name' }">
                      <textarea t-if="col === 'name'" rows="1" class="o_pmk_butik__in o_pmk_butik__ta"
                             t-att-value="val(row, col)" t-att-data-index="row_index" t-att-data-key="row.id" data-col="name"
                             t-att-readonly="!state.data.can_write"
                             placeholder="Уголок 63х4 · коротко: д1 шв10 1200мм 10шт 09г · лист: т1 10мм 100х100мм 10шт"
                             t-on-focus="() => this.onFocus(row_index, col)"
                             t-on-input="(ev) => this.onInput(row, row_index, col, ev)"
                             t-on-change="(ev) => this.commit(row, col, ev)"
                             t-on-keydown="(ev) => this.onKeydown(row_index, col, ev)"
                             t-on-paste="(ev) => this.onPaste(row_index, ev)"/>
                      <input t-else="" class="o_pmk_butik__in" t-att-class="{ n: isNum(col) }"
                             t-att-value="val(row, col)" t-att-data-index="row_index" t-att-data-key="row.id" t-att-data-col="col"
                             t-att-readonly="!state.data.can_write"
                             t-on-focus="() => this.onFocus(row_index, col)"
                             t-on-input="(ev) => this.onInput(row, row_index, col, ev)"
                             t-on-change="(ev) => this.commit(row, col, ev)"
                             t-on-keydown="(ev) => this.onKeydown(row_index, col, ev)"
                             t-on-paste="(ev) => this.onPaste(row_index, ev)"/>
                      <div t-if="col === 'name' and row.label" class="o_pmk_butik__rec"
                           t-att-class="{ 'o_pmk_butik__rec--bad': row.match_state === 'none' }" t-esc="row.label"/>
                      <div t-if="col === 'name' and state.suggest and state.suggestRow === row_index" class="o_pmk_butik__suggest">
                        <div t-foreach="state.suggest" t-as="item" t-key="item.key" class="o_pmk_butik__sitem"
                             t-att-class="{ 'o_pmk_butik__sitem--active': item_index === state.suggestIdx }"
                             t-on-mousedown="(ev) => this.choose(row_index, item, ev)">
                          <span class="o_pmk_butik__skind" t-esc="item.kind"/>
                          <span t-esc="item.label"/>
                        </div>
                      </div>
                    </td>
                  </t>
                  <td class="n o_pmk_butik__ro" t-esc="total(row)"/>
                  <td t-att-class="{ sel: isSel(row_index, 'grade') }">
                    <input class="o_pmk_butik__in" t-att-value="val(row, 'grade')" t-att-data-index="row_index" t-att-data-key="row.id"
                           data-col="grade" t-att-readonly="!state.data.can_write"
                           t-on-focus="() => this.onFocus(row_index, 'grade')"
                           t-on-input="(ev) => this.onInput(row, row_index, 'grade', ev)"
                           t-on-change="(ev) => this.commit(row, 'grade', ev)"
                           t-on-keydown="(ev) => this.onKeydown(row_index, 'grade', ev)"
                           t-on-paste="(ev) => this.onPaste(row_index, ev)"/>
                  </td>
                  <td class="n o_pmk_butik__ro" t-esc="kg(row.weight_one)"/>
                  <td class="n o_pmk_butik__ro" t-esc="kg(row.weight_total)"/>
                <td class="o_pmk_butik__acts">
                    <button type="button" class="btn btn-link btn-sm" title="Копировать — копия встанет ниже" aria-label="Копировать"
                            t-att-disabled="state.busy or !state.data.can_write" t-on-click="() => this.copyRow(row)"><i class="fa fa-clone"/></button>
                    <button type="button" class="btn btn-link btn-sm o_pmk_butik__del" title="Удалить строку" aria-label="Удалить"
                            t-att-disabled="state.busy or !state.data.can_write" t-on-click="() => this.deleteRow(row)"><i class="fa fa-trash-o"/></button>
                  </td>
                </tr>
              </t>
            </tbody>
          </table>
        </div>
        <div class="o_pmk_butik__total">
          Изделий: <b t-esc="state.data.products"/> · Металл всего: <b><t t-esc="kg(state.data.weight_kg) or '0'"/> кг</b>
        </div>
      </t>
    </div>
  </t>
</templates>
