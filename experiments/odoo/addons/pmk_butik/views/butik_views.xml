<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Бутик (15.10.2026): отдельный калькулятор — спецификация таблицей, как в Excel
       Бутова. Основной поток (расчёт металлопроката, сделка) не меняется. -->
  <record id="view_butik_spec_list" model="ir.ui.view">
    <field name="name">pmk.butik.spec.list</field>
    <field name="model">pmk.butik.spec</field>
    <field name="arch" type="xml">
      <list string="Бутик">
        <field name="name" width="105px"/>
        <field name="date" width="100px"/>
        <field name="subject"/>
        <field name="partner_id"/>
        <field name="lead_id"/>
        <field name="product_count" width="80px"/>
        <field name="weight_kg" sum="Металл, кг" width="110px"/>
      </list>
    </field>
  </record>

  <record id="view_butik_spec_form" model="ir.ui.view">
    <field name="name">pmk.butik.spec.form</field>
    <field name="model">pmk.butik.spec</field>
    <field name="arch" type="xml">
      <!-- Как документы системы (Антон 16.10: «рамки как у нас в системе»): шапка одной
           рамкой с карточкой веса (pmk-doc-top / pmk-kpi темы, как у расчёта
           металлопроката), ниже вкладки «Спецификация» и «Связи». -->
      <form string="Бутик" class="pmk-doc-form pmk-labels-top pmk-butik-form">
        <!-- «Сохранить» всегда на виду (Антон 16.10: «нет кнопок сохранения
             документа»). Ячейки таблицы и так уходят на сервер сразу, но форма
             из-за этого не становится «изменённой», и штатная кнопка ядра не
             появлялась. Кнопка объекта сначала записывает форму (шапку, новый
             расчёт), потом сообщает «Расчёт сохранён». -->
        <header>
          <button name="action_butik_save" type="object" string="Сохранить" class="btn-primary"
                  data-hotkey="s"/>
        </header>
        <sheet>
          <div class="pmk-doc-top" name="pmk_doc_top">
            <div class="oe_title pmk-spec-title">
              <h1>
                <span class="pmk-spec-title__new" invisible="id">Новый расчёт «Бутик»</span>
                <field name="name" readonly="1" invisible="not id"/>
                <span class="pmk-spec-title__from">от</span>
                <field name="date" widget="pmk_long_date" class="pmk-spec-title__date"/>
              </h1>
            </div>
            <div class="pmk-doc-head">
              <div class="pmk-doc-head__fields">
                <!-- Имена блоков — как у расчёта металлопроката: порядок и ширину
                     задаёт тема (pmk_theme, type.scss): Сделка → Клиент → «Заказ»
                     во всю ширину (как «Предмет КП»). -->
                <div class="pmk-field" name="pmk_f_deal">
                  <label for="lead_id"/>
                  <field name="lead_id" nolabel="1" options="{'no_create': True}"/>
                </div>
                <div class="pmk-field" name="pmk_f_partner">
                  <label for="partner_id"/>
                  <field name="partner_id" nolabel="1"/>
                </div>
                <div class="pmk-field pmk-field--wide" name="pmk_f_note">
                  <label for="subject"/>
                  <field name="subject" nolabel="1" placeholder="Заказчик, спец./счёт №"/>
                </div>
              </div>
              <div class="pmk-kpi">
                <div class="pmk-kpi__card">
                  <div class="pmk-kpi__label">Общий вес, т</div>
                  <div class="pmk-kpi__value"><field name="weight_t" digits="[12,3]"/></div>
                  <div class="pmk-kpi__sub"><field name="weight_kg" digits="[12,1]"/> кг</div>
                </div>
                <div class="pmk-kpi__note">
                  <span>Изделий:</span><field name="product_count"/>
                  <span class="pmk-kpi__dot">·</span>
                  <span>Деталей:</span><field name="detail_count"/>
                </div>
              </div>
            </div>
          </div>
          <notebook>
            <page string="Спецификация" name="butik">
              <field name="line_ids" invisible="1"/>
              <widget name="pmk_butik_grid"/>
              <field name="note" placeholder="Примечание" nolabel="1"/>
            </page>
            <page string="Связи" name="pmk_flow">
              <widget name="pmk_flow_map"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_butik_spec_search" model="ir.ui.view">
    <field name="name">pmk.butik.spec.search</field>
    <field name="model">pmk.butik.spec</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="subject"/>
        <field name="partner_id"/>
        <field name="lead_id"/>
        <field name="line_ids" string="Наименование" filter_domain="[('line_ids.name', 'ilike', self)]"/>
      </search>
    </field>
  </record>

  <record id="action_butik_spec" model="ir.actions.act_window">
    <field name="name">Бутик</field>
    <field name="res_model">pmk.butik.spec</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Новая спецификация «Бутик»</p>
      <p>Таблица как в Excel: изделие, под ним детали — № поз., наименование, длина, на 1 шт,
        марка. Вес считается сам, наименование находится по справочнику.</p>
    </field>
  </record>

  <menuitem id="menu_pmk_butik" name="Бутик" parent="pmk_calc.menu_pmk_calc"
            action="action_butik_spec" sequence="35"/>
</odoo>
