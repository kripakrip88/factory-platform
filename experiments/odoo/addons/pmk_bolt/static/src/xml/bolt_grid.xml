<?xml version="1.0" encoding="UTF-8"?>
<!-- Болты — таблица Бутика (21.10.2026), js/bolt_grid.js. Разметка — по образцу
     pmk_butik.KonstrGrid (классы и поведение те же); строки плоские. -->
<templates xml:space="preserve">
  <t t-name="pmk_bolt.BoltGrid">
    <div class="o_pmk_butik o_pmk_bolt" t-ref="root">
      <div t-if="!specId" class="o_pmk_butik__start">
        <button type="button" class="btn btn-primary" t-on-click="() => this.start()">
          <i class="fa fa-table me-1" aria-hidden="true"/>Начать расчёт</button>
        <span class="o_pmk_butik__muted">расчёт сохранится, и откроется таблица болтов</span>
      </div>
      <p t-elif="state.loading or !state.data" class="o_pmk_butik__muted">Загружаю…</p>
      <t t-else="">
        <div class="o_pmk_butik__bar">
          <button type="button" class="btn btn-secondary btn-sm" t-att-disabled="state.busy" t-on-click="() => this.addRow()">
            <i class="fa fa-plus me-1" aria-hidden="true"/>Строка</button>
          <button type="button" class="btn btn-secondary btn-sm" t-att-disabled="state.busy" t-on-click="() => this.duplicate()">
            <i class="fa fa-clone me-1" aria-hidden="true"/>Копия строки</button>
          <button type="button" class="btn btn-link btn-sm text-muted" t-att-disabled="state.busy" t-on-click="() => this.remove()">
            <i class="fa fa-trash-o me-1" aria-hidden="true"/>Удалить строку</button>
          <span class="o_pmk_butik__saved" t-att-class="{ 'o_pmk_butik__saved--busy': state.busy }">
            <t t-if="state.busy">Сохраняю…</t>
            <t t-elif="state.savedAt"><i class="fa fa-check me-1" aria-hidden="true"/>Сохранено в <t t-esc="state.savedAt"/></t>
            <t t-else=""><i class="fa fa-check me-1" aria-hidden="true"/>Каждая ячейка сохраняется сама</t>
          </span>
          <span class="o_pmk_butik__hint">Enter, ↑↓ ←→, Tab · Ctrl+D — значение сверху · Ctrl+V — столбик строк или блок из Excel</span>
        </div>
        <div class="o_pmk_butik__wrap">
          <table class="o_pmk_butik__table">
            <colgroup>
              <col style="width:44px"/><col style="width:40%"/><col style="width:80px"/><col style="width:110px"/>
              <col style="width:96px"/><col style="width:90px"/><col style="width:110px"/><col style="width:90px"/>
              <col style="width:110px"/><col style="width:120px"/>
            </colgroup>
            <thead><tr>
              <th class="n">№</th>
              <th title="Коротко: бф 2.1 м30 640мм ст3 10шт · р250 — резьба · калён гайка 120 — гайки">Болт</th>
              <th class="n">Кол-во, шт</th>
              <th title="обычные, калёные, спецсталь">Гайки</th>
              <th class="n" title="Цена одной гайки — вписывает менеджер">Гайка, ₽</th>
              <th class="n">Масса шт, кг</th>
              <th class="n" title="Круг, плита, шайба, гайки, работа по нормам — на 1 болт">Себест. шт</th>
              <th class="n" title="Из ценовой политики на дату расчёта">Наценка, %</th>
              <th class="n">Цена шт</th>
              <th class="n">Сумма</th>
            </tr></thead>
            <tbody>
              <tr t-foreach="rows" t-as="row" t-key="row.id" class="o_pmk_butik__detail"
                  t-att-class="{ 'o_pmk_butik__detail--bad': row.bad, 'o_pmk_bolt__warn': row.warning }">
                <td class="n o_pmk_butik__num" t-esc="row.number"/>
                <td t-att-class="{ sel: isSel(row_index, 'name'), 'o_pmk_butik__namecell': true }">
                  <textarea rows="1" class="o_pmk_butik__in o_pmk_butik__ta" t-att-value="val(row, 'name')"
                         t-att-data-index="row_index" t-att-data-key="row.id" data-col="name" t-att-readonly="!state.data.can_write"
                         placeholder="бф 2.1 м30 640мм ст3 10шт"
                         t-on-focus="() => this.onFocus(row_index, 'name')"
                         t-on-input="(ev) => this.onInput(row, row_index, 'name', ev)"
                         t-on-change="(ev) => this.commit(row, 'name', ev)"
                         t-on-keydown="(ev) => this.onKeydown(row_index, 'name', ev)"
                         t-on-paste="(ev) => this.onPaste(row_index, ev)"/>
                  <div t-if="row.label" class="o_pmk_butik__rec" t-att-class="{ 'o_pmk_butik__rec--bad': row.bad }"
                       t-att-title="row.label" t-esc="row.label"/>
                  <div t-if="row.detail" class="o_pmk_butik__rec o_pmk_bolt__more" t-att-title="row.detail" t-esc="row.detail"/>
                  <div t-if="row.warning" class="o_pmk_butik__rec o_pmk_bolt__warning" t-att-title="row.warning" t-esc="row.warning"/>
                  <div t-if="row.history" class="o_pmk_butik__rec o_pmk_bolt__more" t-att-title="row.history">
                    Прошлые продажи: <t t-esc="row.history"/></div>
                </td>
                <t t-foreach="['qty', 'nut_kind', 'nut_price']" t-as="col" t-key="col">
                  <td t-att-class="{ sel: isSel(row_index, col), n: isNum(col) }">
                    <input class="o_pmk_butik__in" t-att-class="{ n: isNum(col) }" t-att-value="val(row, col)"
                           t-att-data-index="row_index" t-att-data-key="row.id" t-att-data-col="col"
                           t-att-readonly="!state.data.can_write"
                           t-att-placeholder="col === 'nut_price' ? 'впишите' : ''"
                           t-att-title="col === 'nut_price' ? row.nut_hint : ''"
                           t-on-focus="() => this.onFocus(row_index, col)"
                           t-on-input="(ev) => this.onInput(row, row_index, col, ev)"
                           t-on-change="(ev) => this.commit(row, col, ev)"
                           t-on-keydown="(ev) => this.onKeydown(row_index, col, ev)"
                           t-on-paste="(ev) => this.onPaste(row_index, ev)"/>
                  </td>
                </t>
                <td class="n o_pmk_butik__ro" t-esc="kg(row.mass)"/>
                <td class="n o_pmk_butik__ro" t-esc="money(row.cost)"/>
                <t t-foreach="['markup', 'price']" t-as="col" t-key="col">
                  <td t-att-class="{ sel: isSel(row_index, col), n: true }">
                    <input class="o_pmk_butik__in n o_pmk_konstr__price" t-att-value="val(row, col)" inputmode="decimal"
                           t-att-data-index="row_index" t-att-data-key="row.id" t-att-data-col="col"
                           t-att-readonly="!state.data.can_write"
                           t-on-focus="() => this.onFocus(row_index, col)"
                           t-on-input="(ev) => this.onInput(row, row_index, col, ev)"
                           t-on-change="(ev) => this.commit(row, col, ev)"
                           t-on-keydown="(ev) => this.onKeydown(row_index, col, ev)"/>
                  </td>
                </t>
                <td class="n o_pmk_butik__ro" t-esc="money(row.total)"/>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="o_pmk_butik__total">
          Болтов: <b><t t-esc="state.data.count or 0"/> шт</b> · Вес: <b><t t-esc="kg(state.data.weight_kg) or '0'"/> кг</b>
          <t t-if="state.data.cost"> · Себестоимость <b><t t-esc="money(state.data.cost)"/> ₽</b></t>
          <t t-if="state.data.amount"> · Сумма <b><t t-esc="money(state.data.amount)"/> ₽</b></t>
        </div>
      </t>
    </div>
  </t>
</templates>
