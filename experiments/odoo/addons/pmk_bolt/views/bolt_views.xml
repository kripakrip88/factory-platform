<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    Калькулятор фундаментных болтов (21.10.2026). Шапка — как у зонтов (pmk-doc-top,
    pmk-doc-head / pmk-kpi из pmk_theme); строки — список, болт открывается окном с
    разбором: комплект по ГОСТ, себестоимость по частям, прошлые продажи размера.
  -->
  <record id="view_bolt_calc_form" model="ir.ui.view">
    <field name="name">pmk.bolt.calc.form</field>
    <field name="model">pmk.bolt.calc</field>
    <field name="arch" type="xml">
      <form string="Фундаментные болты" class="pmk-doc-form pmk-labels-top">
        <sheet>
          <div class="pmk-doc-top" name="pmk_doc_top">
            <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
            <div class="alert alert-warning" role="alert" invisible="not has_warnings">
              У части болтов есть пометки — они в колонке «Внимание».
            </div>
            <div class="pmk-doc-head">
              <div class="pmk-doc-head__fields">
                <div class="pmk-field" name="pmk_f_partner"><label for="partner_id"/><field name="partner_id" nolabel="1"/></div>
                <div class="pmk-field" name="pmk_f_deal"><label for="opportunity_id"/><field name="opportunity_id" nolabel="1"/></div>
                <div class="pmk-field" name="pmk_f_date"><label for="date"/><field name="date" nolabel="1"/></div>
                <div class="pmk-field" name="pmk_f_user"><label for="user_id"/><field name="user_id" nolabel="1"/></div>
                <div class="pmk-field pmk-field--wide" name="pmk_f_note"><label for="note"/><field name="note" nolabel="1" placeholder="Объект, чертёж"/></div>
              </div>
              <div class="pmk-kpi">
                <div class="pmk-kpi__card"><div class="pmk-kpi__label">Вес, кг</div><div class="pmk-kpi__value"><field name="total_weight"/></div></div>
                <div class="pmk-kpi__card"><div class="pmk-kpi__label">Себестоимость, ₽</div><div class="pmk-kpi__value"><field name="total_cost" digits="[12,0]"/></div></div>
                <div class="pmk-kpi__card"><div class="pmk-kpi__label">Сумма, ₽</div><div class="pmk-kpi__value"><field name="amount_total" digits="[12,0]"/></div></div>
                <div class="pmk-kpi__note"><span>Болтов, шт:</span><field name="total_qty"/><span class="pmk-kpi__dot">·</span><span>Маржа, %:</span><field name="margin_pct"/></div>
              </div>
            </div>
          </div>
          <field name="has_warnings" invisible="1"/>
          <field name="currency_id" invisible="1"/>
          <field name="line_ids" string="Болт" context="{'default_calc_id': id}">
            <list decoration-warning="warning">
              <field name="sequence" widget="handle"/>
              <field name="short_name" width="300px"/>
              <field name="qty"/>
              <field name="mass_one"/>
              <field name="cost_one" digits="[12,0]"/>
              <field name="markup_pct" optional="show"/>
              <field name="price_unit" digits="[12,0]"/>
              <field name="price_total" digits="[12,0]" sum="Итого"/>
              <field name="margin_pct" optional="hide"/>
              <field name="warning" optional="show"/>
              <field name="currency_id" column_invisible="1"/>
            </list>
            <!-- pmk-doc-form: у дробных полей рамка ввода (pmk_theme, «Рамка в рамке»). -->
            <form string="Фундаментный болт" class="pmk-doc-form">
              <field name="currency_id" invisible="1"/>
              <div class="oe_title"><h2><field name="name" readonly="1"/></h2></div>
              <div class="alert alert-warning" role="alert" invisible="not warning"><field name="warning"/></div>
              <group>
                <group string="Болт">
                  <field name="bolt_type"/>
                  <field name="diameter"/>
                  <field name="length"/>
                  <field name="thread_len"/>
                  <field name="steel"/>
                  <field name="qty"/>
                </group>
                <group string="Гайки и цена">
                  <field name="nut_kind"/>
                  <field name="nut_price"/>
                  <field name="nut_hint" readonly="1" string="Прошлая цена гайки"/>
                  <field name="metal_ton"/>
                  <field name="markup_pct"/>
                  <field name="price_unit" digits="[12,0]"/>
                  <field name="history" readonly="1"/>
                </group>
              </group>
              <group>
                <group string="Комплект по ГОСТ, на 1 болт">
                  <field name="kit_text" nolabel="1" readonly="1" colspan="2"/>
                  <field name="blank_mm"/>
                  <field name="mass_one"/>
                </group>
                <group string="Себестоимость, на 1 болт">
                  <field name="metal_rub" digits="[12,0]"/>
                  <field name="plate_rub" digits="[12,0]" invisible="not plate_rub"/>
                  <field name="washer_rub" digits="[12,0]"/>
                  <field name="nuts_rub" digits="[12,0]"/>
                  <field name="thread_rub" digits="[12,0]"/>
                  <field name="work_rub" digits="[12,0]" invisible="not work_rub"/>
                  <field name="cost_one" digits="[12,0]"/>
                  <field name="margin_pct"/>
                </group>
              </group>
            </form>
          </field>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_bolt_calc_list" model="ir.ui.view">
    <field name="name">pmk.bolt.calc.list</field>
    <field name="model">pmk.bolt.calc</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="date"/>
        <field name="partner_id"/>
        <field name="opportunity_id" optional="show"/>
        <field name="note" optional="show"/>
        <field name="total_qty"/>
        <field name="total_weight" optional="show"/>
        <field name="amount_total" sum="Итого"/>
        <field name="user_id" optional="show"/>
        <field name="currency_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_bolt_calc_search" model="ir.ui.view">
    <field name="name">pmk.bolt.calc.search</field>
    <field name="model">pmk.bolt.calc</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="line_ids" string="Болт" filter_domain="[('line_ids.name', 'ilike', self)]"/>
        <filter name="mine" string="Мои" domain="[('user_id', '=', uid)]"/>
      </search>
    </field>
  </record>

  <record id="action_bolt_calc" model="ir.actions.act_window">
    <field name="name">Фундаментные болты</field>
    <field name="res_model">pmk.bolt.calc</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Посчитайте фундаментные болты по ГОСТ 24379.1-2012</p>
      <p>Тип, диаметр, длина, резьба и сталь — масса и комплект по ГОСТ, себестоимость по нормам, цена по ценовой политике.</p>
    </field>
  </record>
</odoo>
