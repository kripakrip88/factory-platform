<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Металл для болтов: правит Владимир; изменил цену — «Проверено» ставится само.
       Жёлтым — не проверяли или больше 90 дней. -->
  <record id="view_bolt_norm_list" model="ir.ui.view">
    <field name="name">pmk.bolt.norm.list</field>
    <field name="model">pmk.bolt.norm</field>
    <field name="arch" type="xml">
      <list editable="bottom" decoration-warning="stale">
        <field name="diameter"/>
        <field name="round_st3_ton"/>
        <field name="round_09g2s_ton"/>
        <field name="sheet_ton"/>
        <field name="checked_on"/>
        <field name="checked_by" widget="many2one_avatar_user"/>
        <field name="stale" column_invisible="1"/>
        <button name="action_mark_checked" type="object" string="Проверено" icon="fa-check" invisible="not stale"/>
        <field name="note" optional="show"/>
      </list>
    </field>
  </record>

  <record id="action_bolt_norm" model="ir.actions.act_window">
    <field name="name">Металл для болтов</field>
    <field name="res_model">pmk.bolt.norm</field>
    <field name="view_mode">list</field>
  </record>
</odoo>
