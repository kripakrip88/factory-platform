<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    Кнопка встаёт сразу после «Переслать», до разделителя. Якорь — сам
    разделитель: он в панели ровно один, и промах по нему уронит сборку
    с внятной ошибкой, а не оставит кнопку молча не появившейся.

    Подпись пишем по-русски прямо здесь: перевод вставленного узла ищется в
    контексте НАШЕГО модуля, а не mail_client.

    Шаг 17 (29.09.2026): панель стала закреплённой строкой над письмом, на
    узком окне чтения подписи кнопок прячутся и остаются значки. Подпись
    поэтому в span.o_mail_client_label — как у соседних кнопок модуля почты
    (правило в mail_client.scss); flex-shrink-0 — кнопку не сжимает длинная
    тема письма. На узком окне кнопка — один значок, поэтому имя для
    экранного диктора в aria-label, а значок от диктора спрятан.
  -->
  <t t-name="pmk_mail_ui.ReadingPaneLead"
     t-inherit="mail_client.ReadingPane"
     t-inherit-mode="extension">

    <xpath expr="//div[hasclass('o_mail_client_toolbar')]/div[hasclass('vr')]" position="before">
      <button class="btn btn-sm btn-light flex-shrink-0 pmk-mail-lead"
              t-if="env.pmkCrm"
              t-att-disabled="pmkLead.busy"
              title="Создать лида из этого письма"
              aria-label="Создать лида из этого письма"
              t-on-click="() => this.pmkCreateLead()">
        <i class="fa" aria-hidden="true" t-att-class="pmkLead.busy ? 'fa-circle-o-notch fa-spin' : 'fa-user-plus'"/><span class="o_mail_client_label ms-1">Лид</span>
      </button>
    </xpath>
  </t>

</templates>
