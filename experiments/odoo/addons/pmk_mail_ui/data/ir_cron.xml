<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Синхронизация почты — раз в 2 минуты (шаг 22 плана, 30.09.2026).

         С 29.09 стояло 10: первая загрузка ящика pmkpark@mail.ru 27.09 шла
         153 с и налезала на другой запуск синхронизации — «could not
         serialize access due to concurrent update», ящик вставал в error.
         Крон сам с собой не пересекается (поток один), но кнопка
         «Синхронизировать» гонит тот же проход в веб-процессе, а дочитка
         структур («Describe Older Messages») — свой вход в ящик.

         Теперь защита есть: один проход по ящику в каждый момент
         (advisory-блокировка Postgres на ящик, mail_client_account.py —
         _try_lock_mailbox). Занятый ящик крон молча пропускает, кнопка
         отвечает «Синхронизация уже идёт». Обычный проход — 2-3 с (журнал
         за 72 ч до 30.09: максимум 2,84 с).

         Не 1 минута: как часто mail.ru пускает по IMAP, неизвестно. Раз в 2
         минуты — 720 входов в сутки на ящик, столько же, сколько у автора
         модуля почты по умолчанию.

         В vendor/mail_client/data/ir_cron.xml значение то же (ПРАВКА ПМК), но
         noupdate там нет: любая правка того файла (или версия автора)
         переписала бы интервал при первом же -u mail_client. Эта запись
         применяется ПОСЛЕ него: -u mail_client тянет
         за собой -u pmk_mail_ui, а наш модуль обновляется при каждой
         выкладке. Поэтому последним всегда пишется наше значение. Правка
         руками в Настройках продержится до ближайшей выкладки. -->
    <record id="mail_client.ir_cron_mail_client_sync" model="ir.cron">
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
    </record>

    <!-- Дочитка текста писем (шаг 1 редизайна почты, 14.10.2026): текст
         сохраняется заранее, письмо открывается сразу, без ожидания mail.ru.
         Новые — первыми, потом за mail_client.prefetch_days дней (90), без
         спама и корзины, по mail_client.prefetch_batch писем (60) за запуск.
         Только просмотр — отметки «прочитано» на сервере не меняются.
         Метод — vendor/mail_client (mail.client.account._prefetch_bodies),
         запись — здесь: новые записи в vendor не кладём (deploy.sh делает -u
         вендору только при I18N=1). -->
    <record id="ir_cron_pmk_mail_prefetch_bodies" model="ir.cron">
        <field name="name">Почта: дочитка текста писем</field>
        <field name="model_id" ref="mail_client.model_mail_client_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_prefetch_bodies()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
