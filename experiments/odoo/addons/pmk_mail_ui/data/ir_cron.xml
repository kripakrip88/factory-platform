<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Синхронизация почты — раз в 10 минут, не 2 (29.09.2026).

         Первая загрузка ящика pmkpark@mail.ru 27.09 шла 153 с и налезала на
         другой запуск синхронизации: «could not serialize access due to
         concurrent update», ящик вставал в error. Крон сам с собой не
         пересекается (поток один), но кнопка «Синхронизировать» гонит тот же
         проход в веб-процессе. Обычный проход — 2-3 с (замер 29.09).

         В vendor/mail_client/data/ir_cron.xml значение уже исправлено
         (ПРАВКА ПМК), но noupdate там нет, и новая версия автора вернула бы 2
         при первом же -u mail_client. Эта запись применяется ПОСЛЕ него:
         -u mail_client тянет за собой -u pmk_mail_ui, а наш модуль обновляется
         при каждой выкладке. Поэтому последним всегда пишется 10.

         Интервал меняется только здесь — шагом 22 плана (чаще, но с защитой
         от наложения прохода крона и кнопки). Правка руками в Настройках
         продержится до ближайшей выкладки. -->
    <record id="mail_client.ir_cron_mail_client_sync" model="ir.cron">
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
    </record>

</odoo>
