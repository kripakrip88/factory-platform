<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Справочник опор ОСТ 36-146-88: собирается из tools/ost.py, только чтение. -->
  <record id="view_opora_ref_list" model="ir.ui.view">
    <field name="name">pmk.opora.ref.list</field>
    <field name="model">pmk.opora.ref</field>
    <field name="arch" type="xml">
      <list create="0" edit="0" delete="0">
        <field name="opora_type"/>
        <field name="designation"/>
        <field name="dn"/>
        <field name="execution"/>
        <field name="height"/>
        <field name="length"/>
        <field name="width" optional="show"/>
        <field name="thickness" optional="show"/>
        <field name="mass"/>
        <field name="ost_mass"/>
        <field name="ratio" optional="show"/>
      </list>
    </field>
  </record>

  <record id="view_opora_ref_form" model="ir.ui.view">
    <field name="name">pmk.opora.ref.form</field>
    <field name="model">pmk.opora.ref</field>
    <field name="arch" type="xml">
      <form create="0" edit="0" delete="0">
        <sheet>
          <div class="oe_title"><h1><field name="designation"/></h1></div>
          <group>
            <group>
              <field name="opora_type"/>
              <field name="dn"/>
              <field name="execution"/>
              <field name="height"/>
            </group>
            <group>
              <field name="length"/>
              <field name="width"/>
              <field name="thickness"/>
              <field name="mass"/>
              <field name="ost_mass"/>
              <field name="ratio"/>
            </group>
          </group>
          <field name="parts_text" nolabel="1"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_opora_ref_search" model="ir.ui.view">
    <field name="name">pmk.opora.ref.search</field>
    <field name="model">pmk.opora.ref</field>
    <field name="arch" type="xml">
      <search>
        <field name="designation"/>
        <field name="dn"/>
        <field name="execution"/>
        <filter name="kp" string="КП подвижные" domain="[('opora_type', '=', 'kp')]"/>
        <filter name="kp_fix" string="КП неподвижные" domain="[('opora_type', '=', 'kp_fix')]"/>
        <filter name="kx" string="КХ подвижные" domain="[('opora_type', '=', 'kx')]"/>
        <filter name="kx_fix" string="КХ неподвижные" domain="[('opora_type', '=', 'kx_fix')]"/>
        <group>
          <filter name="by_type" string="Категория" context="{'group_by': 'opora_type'}"/>
          <filter name="by_dn" string="Дн" context="{'group_by': 'dn'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_opora_ref" model="ir.actions.act_window">
    <field name="name">Опоры ОСТ 36-146-88</field>
    <field name="res_model">pmk.opora.ref</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_by_type': 1}</field>
  </record>
</odoo>
