<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Справочник опор по стандартам: собирается из tools/<стандарт>.py (tools/catalog.py), только чтение. -->
  <record id="view_opora_ref_list" model="ir.ui.view">
    <field name="name">pmk.opora.ref.list</field>
    <field name="model">pmk.opora.ref</field>
    <field name="arch" type="xml">
      <list create="0" edit="0" delete="0" decoration-muted="not has_parts">
        <field name="standard" optional="hide"/>
        <field name="family"/>
        <field name="opora_type" optional="show"/>
        <field name="designation"/>
        <field name="has_parts" widget="boolean"/>
        <field name="dn"/>
        <field name="execution"/>
        <field name="height"/>
        <field name="length"/>
        <field name="width" optional="show"/>
        <field name="thickness" optional="show"/>
        <field name="mass"/>
        <field name="ost_mass"/>
        <field name="ratio" optional="show"/>
      </list>
    </field>
  </record>

  <record id="view_opora_ref_form" model="ir.ui.view">
    <field name="name">pmk.opora.ref.form</field>
    <field name="model">pmk.opora.ref</field>
    <field name="arch" type="xml">
      <form create="0" edit="0" delete="0">
        <sheet>
          <div class="oe_title"><h1><field name="designation"/></h1></div>
          <group>
            <group>
              <field name="standard"/>
              <field name="family"/>
              <field name="opora_type"/>
              <field name="has_parts"/>
              <field name="dn"/>
              <field name="execution"/>
              <field name="height"/>
            </group>
            <group>
              <field name="length"/>
              <field name="width"/>
              <field name="thickness"/>
              <field name="mass"/>
              <field name="ost_mass"/>
              <field name="ratio"/>
            </group>
          </group>
          <field name="parts_text" nolabel="1"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_opora_ref_search" model="ir.ui.view">
    <field name="name">pmk.opora.ref.search</field>
    <field name="model">pmk.opora.ref</field>
    <field name="arch" type="xml">
      <search>
        <field name="designation"/>
        <field name="dn"/>
        <field name="execution"/>
        <filter name="ost146" string="ОСТ 36-146-88" domain="[('standard', '=', 'ОСТ 36-146-88')]"/>
        <filter name="ost94" string="ОСТ 36-94-83" domain="[('standard', '=', 'ОСТ 36-94-83')]"/>
        <separator/>
        <filter name="with_parts" string="Состав собран" domain="[('has_parts', '=', True)]"/>
        <filter name="no_parts" string="Состав не собран" domain="[('has_parts', '=', False)]"/>
        <separator/>
        <filter name="kp" string="КП подвижные" domain="[('opora_type', '=', 'kp')]"/>
        <filter name="kp_fix" string="КП неподвижные" domain="[('opora_type', '=', 'kp_fix')]"/>
        <filter name="kx" string="КХ подвижные" domain="[('opora_type', '=', 'kx')]"/>
        <filter name="kx_fix" string="КХ неподвижные" domain="[('opora_type', '=', 'kx_fix')]"/>
        <group>
          <filter name="by_standard" string="Стандарт" context="{'group_by': 'standard'}"/>
          <filter name="by_family" string="Тип" context="{'group_by': 'family'}"/>
          <filter name="by_type" string="Категория" context="{'group_by': 'opora_type'}"/>
          <filter name="by_dn" string="Дн" context="{'group_by': 'dn'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_opora_ref" model="ir.actions.act_window">
    <field name="name">Справочник опор</field>
    <field name="res_model">pmk.opora.ref</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_by_standard': 1, 'search_default_by_family': 1}</field>
  </record>
</odoo>
