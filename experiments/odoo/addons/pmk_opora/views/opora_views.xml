<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    Калькулятор опор трубопроводов (25.10.2026). Шапка — как у болтов (pmk-doc-top,
    pmk-doc-head / pmk-kpi из pmk_theme); опоры — таблица Бутика (виджет pmk_opora_grid):
    короткая запись в ячейке, под ней — название по ОСТ, пометки, прошлые продажи.
  -->
  <record id="view_opora_calc_form" model="ir.ui.view">
    <field name="name">pmk.opora.calc.form</field>
    <field name="model">pmk.opora.calc</field>
    <field name="arch" type="xml">
      <form string="Опоры трубопроводов" class="pmk-doc-form pmk-labels-top">
        <sheet>
          <div class="pmk-doc-top" name="pmk_doc_top">
            <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
            <div class="alert alert-warning" role="alert" invisible="not has_warnings">
              У части опор есть пометки — они под записью опоры, жёлтым.
            </div>
            <div class="pmk-doc-head">
              <div class="pmk-doc-head__fields">
                <div class="pmk-field" name="pmk_f_partner"><label for="partner_id"/><field name="partner_id" nolabel="1"/></div>
                <div class="pmk-field" name="pmk_f_deal"><label for="opportunity_id"/><field name="opportunity_id" nolabel="1"/></div>
                <div class="pmk-field" name="pmk_f_date"><label for="date"/><field name="date" nolabel="1"/></div>
                <div class="pmk-field" name="pmk_f_user"><label for="user_id"/><field name="user_id" nolabel="1"/></div>
                <div class="pmk-field pmk-field--wide" name="pmk_f_note"><label for="note"/><field name="note" nolabel="1" placeholder="Объект, чертёж"/></div>
              </div>
              <div class="pmk-kpi">
                <div class="pmk-kpi__card"><div class="pmk-kpi__label">Вес, кг</div><div class="pmk-kpi__value"><field name="total_weight"/></div></div>
                <div class="pmk-kpi__card"><div class="pmk-kpi__label">Себестоимость, ₽</div><div class="pmk-kpi__value"><field name="total_cost" digits="[12,0]"/></div></div>
                <div class="pmk-kpi__card"><div class="pmk-kpi__label">Сумма, ₽</div><div class="pmk-kpi__value"><field name="amount_total" digits="[12,0]"/></div></div>
                <div class="pmk-kpi__note"><span>Опор, шт:</span><field name="total_qty"/><span class="pmk-kpi__dot">·</span><span>Маржа, %:</span><field name="margin_pct"/></div>
              </div>
            </div>
          </div>
          <field name="has_warnings" invisible="1"/>
          <widget name="pmk_opora_grid"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_opora_calc_list" model="ir.ui.view">
    <field name="name">pmk.opora.calc.list</field>
    <field name="model">pmk.opora.calc</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="date"/>
        <field name="partner_id"/>
        <field name="opportunity_id" optional="show"/>
        <field name="note" optional="show"/>
        <field name="total_qty"/>
        <field name="total_weight" optional="show"/>
        <field name="amount_total" sum="Итого"/>
        <field name="user_id" optional="show"/>
        <field name="currency_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_opora_calc_search" model="ir.ui.view">
    <field name="name">pmk.opora.calc.search</field>
    <field name="model">pmk.opora.calc</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="line_ids" string="Опора" filter_domain="[('line_ids.name', 'ilike', self)]"/>
        <filter name="mine" string="Мои" domain="[('user_id', '=', uid)]"/>
      </search>
    </field>
  </record>

  <record id="action_opora_calc" model="ir.actions.act_window">
    <field name="name">Опоры трубопроводов</field>
    <field name="res_model">pmk.opora.calc</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Посчитайте опоры трубопроводов по ОСТ 36-146-88</p>
      <p>Строкой: «кх а12 219 09г2с 20шт», «кх неподв а22 219» — состав по деталям, себестоимость по прайсам, цена по ценовой политике.</p>
    </field>
  </record>
</odoo>
