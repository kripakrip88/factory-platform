<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ВКЛАДКА «СВЯЗИ» — как «Раскладка» и «Цены» у расчёта (решение владельца
        25.09.2026: дополнительные сведения о документе живут вкладками).

        ⚠️ ВИДЖЕТ, А НЕ КЛИЕНТСКОЕ ДЕЙСТВИЕ. Кнопки на штатных формах открывают
        схему действием (ir.actions.client), но действие во вкладку формы не
        вставить. <widget name="pmk_flow_map"/> компилируется в любом месте
        разметки, в том числе внутри page, и получает запись формы.
        Вкладку Odoo рисует только открытую — схема строится по клику на неё,
        а не при каждом открытии документа.

        ⚠️ priority 99 — ЧТОБЫ ВКЛАДКА ШЛА ПОСЛЕДНЕЙ. Наследования одного вида
        применяются по (priority, id). Вкладку «Цены» добавляет pmk_bridge, от
        которого этот модуль не зависит: на чистой базе он может встать позже
        нас, и «Связи» оказались бы перед «Ценами».
    -->

    <record id="view_metal_spec_form_pmk_flow" model="ir.ui.view">
        <field name="name">pmk.metal.spec.form.pmk.flow</field>
        <field name="model">pmk.metal.spec</field>
        <field name="inherit_id" ref="pmk_calc.view_metal_spec_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- Путь от корня, а не //notebook: в форме изделия внутри состава
                 есть свой notebook (Прокат/Метизы/Покрытие/Лист). Сейчас он
                 идёт вторым и //notebook берёт верхний, но это держится только
                 на порядке разметки. -->
            <xpath expr="/form/sheet/notebook" position="inside">
                <page string="Связи" name="pmk_flow">
                    <!-- «Связи · N» (шапка «вариант А», 25.10.2026, flow_tab_count.js). -->
                    <field name="pmk_flow_count" invisible="1"/>
                    <widget name="pmk_flow_map"/>
                </page>
            </xpath>
        </field>
    </record>

    <!--
        Задание лазеру — разбор UX, шаг 36 (02.10.2026): у задания вкладки
        «Связи» не было, хотя на схеме расчёта и сделки задание есть (узел
        «Лазер»). Так же, как у расчёта: путь от корня, priority 99 —
        последней вкладкой, после «Замеров». pmk_flow зависит от pmk_laser,
        поэтому узел notebook на месте к загрузке этого вида.
    -->
    <record id="view_laser_job_form_pmk_flow" model="ir.ui.view">
        <field name="name">pmk.laser.job.form.pmk.flow</field>
        <field name="model">pmk.laser.job</field>
        <field name="inherit_id" ref="pmk_laser.view_laser_job_form"/>
        <field name="priority">99</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="inside">
                <page string="Связи" name="pmk_flow">
                    <widget name="pmk_flow_map"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Задание на резку по заказу (переделка лазера, 15.10.2026) — «Связи» так же. -->
    <record id="view_laser_task_form_pmk_flow" model="ir.ui.view">
        <field name="name">pmk.laser.task.form.pmk.flow</field>
        <field name="model">pmk.laser.task</field>
        <field name="inherit_id" ref="pmk_laser.view_laser_task_form"/>
        <field name="priority">99</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="inside">
                <page string="Связи" name="pmk_flow">
                    <widget name="pmk_flow_map"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_laser_nest_form_pmk_flow" model="ir.ui.view">
        <field name="name">pmk.laser.nest.form.pmk.flow</field>
        <field name="model">pmk.laser.nest</field>
        <field name="inherit_id" ref="pmk_laser.view_laser_nest_form"/>
        <field name="priority">99</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="inside">
                <page string="Связи" name="pmk_flow">
                    <widget name="pmk_flow_map"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Раскрой сортамента (Антон 15.10.2026: «смотрю раскрой — нет вкладки
         Связи»). Узел pmk.cut.plan схема знает давно (FLOW_STAGES). -->
    <record id="view_cut_plan_form_pmk_flow" model="ir.ui.view">
        <field name="name">pmk.cut.plan.form.pmk.flow</field>
        <field name="model">pmk.cut.plan</field>
        <field name="inherit_id" ref="pmk_cut.view_cut_plan_form"/>
        <field name="priority">99</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="inside">
                <page string="Связи" name="pmk_flow">
                    <widget name="pmk_flow_map"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_crm_lead_form_pmk_flow" model="ir.ui.view">
        <field name="name">crm.lead.form.pmk.flow</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Связи" name="pmk_flow">
                    <!-- «Связи · N» (шапка «вариант А», 25.10.2026, flow_tab_count.js). -->
                    <field name="pmk_flow_count" invisible="1"/>
                    <widget name="pmk_flow_map"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
