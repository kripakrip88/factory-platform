<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Схема связей на пяти штатных формах — ВКЛАДКОЙ «Связи», как у расчёта
        и сделки (flow_tabs.xml).

        До 28.09.2026 здесь была кнопка «Связи», и схема открывалась
        отдельной страницей — так было у автора модуля. У такой страницы нет
        строки возврата: назад только кнопкой браузера, а после обновления
        схема пропадала. Решение Антона (разбор UX, 28.09.2026): «давай
        сделаем вкладку в документе, как делали в других страницах».
        Файл называется flow_buttons.xml по старой памяти: xml id видов
        оставлены прежними, чтобы обновление модуля заменило кнопку на
        вкладку, а не добавило вкладку рядом с кнопкой.

        ⚠️ ПУТЬ /form/sheet/notebook, А НЕ //notebook. В форме заказа
        поставщику есть второй, вложенный notebook — в форме строки заказа
        (выгрузка видов 27.09.2026: /form/sheet/notebook/page[1]/field/form/…).
        //notebook взял бы первый по порядку разметки и держался бы только на
        нём. У всех пяти форм ровно один /form/sheet/notebook — проверено.

        ⚠️ priority 99 — чтобы вкладка шла последней, после штатных и после
        наших из других модулей.

        Действие pmk_flow_map (отдельная страница) оставлено: из форм на него
        больше ничто не ведёт, но страница открывается по прямой ссылке и
        понадобится, если вернём кнопку. Сама страница — в flow_map.js.
    -->
    <record id="action_pmk_flow_map" model="ir.actions.client">
        <field name="name">Связи документа</field>
        <field name="tag">pmk_flow_map</field>
    </record>

    <record id="view_sale_order_form_pmk_flow" model="ir.ui.view">
        <field name="name">sale.order.form.pmk.flow</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="inside">
                <page string="Связи" name="pmk_flow">
                    <widget name="pmk_flow_map"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_form_pmk_flow" model="ir.ui.view">
        <field name="name">purchase.order.form.pmk.flow</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="inside">
                <page string="Связи" name="pmk_flow">
                    <widget name="pmk_flow_map"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_form_pmk_flow" model="ir.ui.view">
        <field name="name">mrp.production.form.pmk.flow</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="inside">
                <page string="Связи" name="pmk_flow">
                    <widget name="pmk_flow_map"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_form_pmk_flow" model="ir.ui.view">
        <field name="name">account.move.form.pmk.flow</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="inside">
                <page string="Связи" name="pmk_flow">
                    <widget name="pmk_flow_map"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_form_pmk_flow" model="ir.ui.view">
        <field name="name">stock.picking.form.pmk.flow</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook" position="inside">
                <page string="Связи" name="pmk_flow">
                    <widget name="pmk_flow_map"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
