<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_transaction_flow_map" model="ir.actions.client">
        <field name="name">Flow Map</field>
        <field name="tag">ma_transaction_flow_map</field>
    </record>

    <record id="sale_order_form_flow_button" model="ir.ui.view">
        <field name="name">sale.order.form.flow.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_transaction_flow_map)d" type="action"
                        class="oe_stat_button" icon="fa-sitemap" invisible="not id"
                        context="{'flow_model': 'sale.order', 'flow_res_id': id}">
                    <span class="o_stat_text">Flow Map</span>
                </button>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_flow_button" model="ir.ui.view">
        <field name="name">purchase.order.form.flow.button</field>
        <field name="model">purchase.order</field>
