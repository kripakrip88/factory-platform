<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Кнопка «Связи» на пяти штатных формах — так схема открывалась у автора
        модуля, отдельной страницей. У расчёта и сделки схема — вкладкой
        (flow_tabs.xml): эти документы открывают чаще, и лишний переход там
        мешал бы.

        ⚠️ ТЕГ ДЕЙСТВИЯ pmk_flow_map, А НЕ АВТОРСКИЙ ma_transaction_flow_map.
        Пока исходный модуль не удалён со стенда, оба стоят рядом; одинаковый
        тег — и реестр действий откажет на повторной регистрации, веб-клиент
        не загрузится. По той же причине у записей свои xml id и имена видов.
    -->
    <record id="action_pmk_flow_map" model="ir.actions.client">
        <field name="name">Связи документа</field>
        <field name="tag">pmk_flow_map</field>
    </record>

    <record id="view_sale_order_form_pmk_flow" model="ir.ui.view">
        <field name="name">sale.order.form.pmk.flow</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_pmk_flow_map)d" type="action"
                        class="oe_stat_button" icon="fa-sitemap" invisible="not id"
                        context="{'flow_model': 'sale.order', 'flow_res_id': id}">
                    <span class="o_stat_text">Связи</span>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_form_pmk_flow" model="ir.ui.view">
        <field name="name">purchase.order.form.pmk.flow</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_pmk_flow_map)d" type="action"
                        class="oe_stat_button" icon="fa-sitemap" invisible="not id"
                        context="{'flow_model': 'purchase.order', 'flow_res_id': id}">
                    <span class="o_stat_text">Связи</span>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_form_pmk_flow" model="ir.ui.view">
        <field name="name">mrp.production.form.pmk.flow</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_pmk_flow_map)d" type="action"
                        class="oe_stat_button" icon="fa-sitemap" invisible="not id"
                        context="{'flow_model': 'mrp.production', 'flow_res_id': id}">
                    <span class="o_stat_text">Связи</span>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_form_pmk_flow" model="ir.ui.view">
        <field name="name">account.move.form.pmk.flow</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_pmk_flow_map)d" type="action"
                        class="oe_stat_button" icon="fa-sitemap" invisible="not id"
                        context="{'flow_model': 'account.move', 'flow_res_id': id}">
                    <span class="o_stat_text">Связи</span>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_form_pmk_flow" model="ir.ui.view">
        <field name="name">stock.picking.form.pmk.flow</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_pmk_flow_map)d" type="action"
                        class="oe_stat_button" icon="fa-sitemap" invisible="not id"
                        context="{'flow_model': 'stock.picking', 'flow_res_id': id}">
                    <span class="o_stat_text">Связи</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
