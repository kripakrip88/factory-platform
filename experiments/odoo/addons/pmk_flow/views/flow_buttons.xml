                        context="{'flow_model': 'account.move', 'flow_res_id': id}">
                    <span class="o_stat_text">Flow Map</span>
                </button>
            </xpath>
        </field>
    </record>

    <record id="stock_picking_form_flow_button" model="ir.ui.view">
        <field name="name">stock.picking.form.flow.button</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
