<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    Лист в м² (№309, 19.10.2026): карточка листа считается в м², габарит —
    единица-«упаковка» «Лист WxL» (pmk_bridge/data/uom_sheet.xml).

    • «Вес м²» вместо «Вес единицы» — без единицы 23,55 кг читалось как вес
      листа.
    • «Габариты» — какие листы есть в прайсах (uom_ids карточки), только чтение:
      их дописывают загрузчик цен и заявка на металл.
    • «Ед.» в ценах поставщиков карточки — у листа цены разных габаритов стоят
      одной колонкой («15 454» за 1500×6000 и «7 834» за 1000×4000), без
      единицы их не сравнить. У проката (метр) колонки нет.
    Вернуть — убрать файл из __manifest__.py.
  -->
  <record id="view_product_template_form_sheet_m2" model="ir.ui.view">
    <field name="name">product.template.form.pmk.sheet.m2</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="pmk_purchase.view_product_template_form_step37"/>
    <field name="priority">101</field>
    <field name="active" eval="True"/>
    <field name="arch" type="xml">
      <!-- Лист в м² — масса из справочника (pmk_mass_ref), подпись «Вес м²».
           [2] — подпись «Вес единицы» (первая — «Вес метра», step37_product.xml;
           по string Odoo выбирать не даёт).
           Строка видна и у карточки с несколькими марками: кг/м² у марок один,
           а ядро у такой карточки вес прячет (у шаблона он ноль). -->
      <xpath expr="(//group[@name='group_standard_price']//label[@for='pmk_mass_unit'])[2]" position="attributes">
        <attribute name="invisible" add="pmk_is_sqm" separator="or"/>
      </xpath>
      <xpath expr="(//group[@name='group_standard_price']//label[@for='pmk_mass_unit'])[2]" position="after">
        <label for="pmk_mass_unit" string="Вес м²" invisible="not pmk_is_sqm or type != 'consu'"/>
      </xpath>
      <!-- Артикул у листа с несколькими марками: ядро его прячет (у шаблона
           с вариантами он «ничей»), у нас — артикул базового варианта
           (sheet_uom.py), только чтение: у марок свои, «LST-GL-10-09G2S». -->
      <xpath expr="//group[@name='group_standard_price']/field[@name='default_code']" position="attributes">
        <attribute name="invisible">product_variant_count &gt; 1 and not pmk_is_sqm</attribute>
        <attribute name="readonly">product_variant_count &gt; 1</attribute>
      </xpath>
      <xpath expr="//group[@name='group_standard_price']//div[@name='weight']" position="attributes">
        <attribute name="invisible">type != 'consu' or (product_variant_count &gt; 1 and not is_product_variant and not pmk_is_sqm)</attribute>
      </xpath>
      <xpath expr="//group[@name='group_standard_price']//div[@name='weight']" position="after">
        <field name="uom_ids" string="Габариты" widget="many2many_tags" readonly="1"
               invisible="not pmk_is_sqm"
               help="Листы, которые есть в прайсах поставщиков. Дописываются сами — загрузкой прайса и заявкой на металл."/>
      </xpath>
    </field>
  </record>

  <!-- Признак — скрытым полем там же, где pmk_is_linear (supplier_price_views.xml):
       список цен берёт его как parent.pmk_is_sqm, а этот вид — общий у шаблона и
       варианта (форма варианта строится из него), так что признак есть в обеих. -->
  <record id="view_product_template_is_sqm" model="ir.ui.view">
    <field name="name">product.template.form.pmk.is.sqm</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="purchase.view_product_supplier_inherit"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='seller_ids']" position="before">
        <field name="pmk_is_sqm" invisible="1"/>
      </xpath>
    </field>
  </record>

  <!-- Порог объёма — не наш случай (Антон 19.10.2026): заводу отпускают по
       самой низкой цене, в прайсе одна строка на позицию с порогом 0. -->
  <record id="product_supplierinfo_tree_view2_no_qty" model="ir.ui.view">
    <field name="name">product.supplierinfo.list.view2.pmk.no.qty</field>
    <field name="model">product.supplierinfo</field>
    <field name="inherit_id" ref="pmk_purchase.product_supplierinfo_tree_view2_pmk"/>
    <field name="arch" type="xml">
      <!-- Сверху — свежие прайсы (Антон 19.10.2026): одна цена на позицию в
           прайсе, и по датам сразу видно, что действует и как менялась цена.
           Ядро сортирует по уровню и цене — у нас уровень всегда 1. -->
      <xpath expr="/list" position="attributes">
        <attribute name="default_order">date_start desc, partner_id, product_uom_id</attribute>
      </xpath>
      <xpath expr="//field[@name='min_qty']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
    </field>
  </record>

  <record id="product_supplierinfo_tree_view2_sheet_m2" model="ir.ui.view">
    <field name="name">product.supplierinfo.list.view2.pmk.sheet.m2</field>
    <field name="model">product.supplierinfo</field>
    <field name="inherit_id" ref="pmk_purchase.product_supplierinfo_tree_view2_pmk"/>
    <field name="arch" type="xml">
      <!-- Перед длиной хлыста: та стоит вплотную к цене (шаг 25), у листа её нет. -->
      <xpath expr="//field[@name='pmk_bar_length_mm']" position="before">
        <field name="pmk_grade_label" string="Марка" optional="show"
               column_invisible="not parent.pmk_is_sqm"/>
        <field name="product_uom_id" string="Ед." readonly="1" optional="show"
               column_invisible="not parent.pmk_is_sqm"/>
      </xpath>
    </field>
  </record>
</odoo>
