<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    Раздел «Закупки» темы (pmk_theme.menu_pmk_purchase). Порядок — шаг 38
    разбора UX (05.10.2026): Поставщики (10) · Цены поставщиков (20) ·
    Номенклатура (25, pmk_theme) · Рассылка прайсов (30) · Заказы
    поставщикам (40, pmk_theme) · Группы поставки (90). Раздел открывается
    первым пунктом — «Поставщиками». Спрятанные пункты раздела («Все
    поставщики», «Почта», «Подтверждённые заказы») — pmk_theme/data/menus.xml
    и pmk_mail_ui/data/menus.xml; реестр — docs/disabled-features.md, шаг 38.
  -->
  <!-- «Поставщики» — список реестра прайсов (было «Поставщики прайсов») с
       его поиском («Пора запросить прайс», «Прайса ещё не было», «Адрес не
       проверен»…). В нём все поставщики: реестр и поставщики по штатному
       признаку — заведённые из заказа поставщику или строки цены (домен
       action_price_supplier, views/res_partner_views.xml). Штатный список
       поставщиков после шагов 25/26 показывал тот же вид и те же строки
       (20 из 20 на 05.10.2026) — он спрятан в «Убранное» под именем «Все
       поставщики» (pmk_theme). -->
  <record id="menu_price_supplier" model="ir.ui.menu">
    <field name="name">Поставщики</field>
    <field name="parent_id" ref="pmk_theme.menu_pmk_purchase"/>
    <field name="action" ref="action_price_supplier"/>
    <field name="sequence">10</field>
  </record>

  <!-- Все строки прайсов одним списком (разбор UX, шаг 25): сразу за
       поставщиками — то, что они присылают. -->
  <record id="menu_supplier_prices" model="ir.ui.menu">
    <field name="name">Цены поставщиков</field>
    <field name="parent_id" ref="pmk_theme.menu_pmk_purchase"/>
    <field name="action" ref="action_supplier_prices"/>
    <field name="sequence">20</field>
  </record>

  <record id="menu_price_mailing" model="ir.ui.menu">
    <field name="name">Рассылка прайсов</field>
    <field name="parent_id" ref="pmk_theme.menu_pmk_purchase"/>
    <field name="action" ref="action_price_mailing"/>
    <field name="sequence">30</field>
  </record>

  <record id="menu_supply_category" model="ir.ui.menu">
    <field name="name">Группы поставки</field>
    <field name="parent_id" ref="pmk_theme.menu_pmk_purchase"/>
    <field name="action" ref="action_supply_category"/>
    <field name="sequence">90</field>
  </record>
</odoo>
