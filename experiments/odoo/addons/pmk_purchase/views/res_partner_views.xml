<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- Блок запроса прайсов — на вкладке «Продажи и закупки», а не отдельной
       вкладкой: снабженец смотрит всё это разом.

       Разбор UX, шаг 8 (28.09.2026): раньше десять полей прайса
       дописывались в колонку «Закупка», и она становилась в разы длиннее
       колонки «Продажи» (Антон: «правый столбец сильно растянут»). Теперь
       в колонке «Закупка» только флажок «Поставщик прайсов», а сам блок —
       отдельной группой «Прайсы» во всю ширину, в две колонки: слева кто и
       куда писать, справа расписание запросов. Без флажка блока нет. -->
  <record id="view_partner_form_price" model="ir.ui.view">
    <field name="name">res.partner.form.pmk.price</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='purchase']" position="inside">
        <field name="pmk_price_supplier"/>
      </xpath>
      <xpath expr="//page[@name='sales_purchases']/group[@name='container_row_2']" position="after">
        <group name="pmk_price" string="Прайсы" invisible="not pmk_price_supplier">
          <group name="pmk_price_who">
            <field name="pmk_supply_ids" widget="many2many_tags"
                   options="{'no_create_edit': True}"/>
            <field name="pmk_has_stock"/>
            <field name="pmk_price_email" placeholder="zakaz@postavshchik.ru"/>
            <field name="pmk_price_email_state" widget="badge"
                   decoration-warning="pmk_price_email_state == 'draft'"
                   decoration-success="pmk_price_email_state == 'confirmed'"
                   decoration-danger="pmk_price_email_state == 'invalid'"/>
            <field name="pmk_price_email_source" widget="url"/>
          </group>
          <group name="pmk_price_when">
            <field name="pmk_price_mailing" widget="boolean_toggle"/>
            <field name="pmk_price_period_days"/>
            <field name="pmk_price_request_date"/>
            <field name="pmk_price_last_date"/>
            <field name="pmk_price_next_date"/>
          </group>
        </group>
      </xpath>
    </field>
  </record>

  <!-- Отдельный список: карточка контрагента для этого слишком длинная,
       а снабженцу нужен именно перечень — кто, что возит, когда был прайс. -->
  <record id="view_price_supplier_list" model="ir.ui.view">
    <field name="name">res.partner.list.pmk.price</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <list string="Поставщики прайсов">
        <!--
          Кнопки появляются, когда отмечены строки. Так управление рассылкой
          живёт там же, где список: отметил галочками кого надо — нажал.
          Через меню «Действия» было бы то же самое, но оно цепляется ко ВСЕМ
          спискам контрагентов, включая клиентов, где эти кнопки лишние.
        -->
        <header>
          <button name="action_pmk_mailing_on" type="object" class="btn-primary"
                  string="Включить в рассылку"/>
          <button name="action_pmk_mailing_off" type="object"
                  string="Исключить из рассылки"/>
          <button name="action_pmk_period_weekly" type="object"
                  string="Спрашивать раз в неделю"/>
          <button name="action_pmk_period_biweekly" type="object"
                  string="Раз в две недели"/>
        </header>
        <field name="pmk_price_mailing" string="В рассылке" widget="boolean_toggle"/>
        <field name="name"/>
        <field name="pmk_supply_ids" widget="many2many_tags" string="Что возит"/>
        <field name="pmk_has_stock" string="Склад ДВ"/>
        <field name="pmk_price_email" string="Адрес для прайса"/>
        <field name="pmk_price_email_state" widget="badge"
               decoration-warning="pmk_price_email_state == 'draft'"
               decoration-success="pmk_price_email_state == 'confirmed'"
               decoration-danger="pmk_price_email_state == 'invalid'"/>
        <field name="phone" optional="show"/>
        <field name="city" optional="show"/>
        <field name="website" optional="hide"/>
        <field name="pmk_price_period_days" string="Период, дней" optional="show"/>
        <field name="pmk_price_request_date" string="Запрос отправлен" optional="show"/>
        <!-- «Прайс от», а не «Прайс получен»: дата — это дата самого прайса
             поставщика («Действует с» у его цен), а не день загрузки. -->
        <field name="pmk_price_last_date" string="Прайс от" optional="show"/>
        <!-- Срок словами («через 6 дней», «просрочено на 2 дня»). Красным и
             жёлтым — только у тех, кто в рассылке: остальным письмо само не
             уйдёт, и подсвечивать их срок значит кричать о том, что никто не
             обещал сделать. (Разбор UX, шаг 13, 29.09.2026.) -->
        <field name="pmk_price_next_date" string="Следующий запрос" optional="show"
               widget="remaining_days"
               options="{'classes': {'danger': 'days &lt; 0 and record.pmk_price_mailing', 'warning': 'days == 0 and record.pmk_price_mailing', 'bf': 'days &lt;= 0 and record.pmk_price_mailing'}}"/>
      </list>
    </field>
  </record>

  <!--
    ⚠️ priority 32 ОБЯЗАТЕЛЕН. Без него этот вид (приоритет по умолчанию 16,
    как у штатного) Odoo выбирал поиском контрагентов ПО УМОЛЧАНИЮ ВЕЗДЕ:
    при равном приоритете решает имя, а «res.partner.search.pmk.price» по
    алфавиту раньше штатного. В «Клиентах» строка поиска была подписана
    «Поставщик», а штатный фильтр «Клиенты» молча не применялся — список
    показывал всех подряд (разбор UX, CP-01). Меню «Поставщики прайсов»
    берёт этот вид явно (search_view_id) и от приоритета не зависит.
  -->
  <record id="view_price_supplier_search" model="ir.ui.view">
    <field name="name">res.partner.search.pmk.price</field>
    <field name="model">res.partner</field>
    <field name="priority">32</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" string="Поставщик"/>
        <field name="pmk_supply_ids" string="Что возит"/>
        <field name="city"/>

        <filter name="in_mailing" string="В рассылке"
                domain="[('pmk_price_mailing', '=', True)]"/>
        <filter name="not_in_mailing" string="Не в рассылке"
                domain="[('pmk_price_mailing', '=', False)]"/>
        <separator/>
        <filter name="confirmed" string="Адрес подтверждён"
                domain="[('pmk_price_email_state', '=', 'confirmed')]"/>
        <filter name="draft" string="Адрес не подтверждён"
                domain="[('pmk_price_email_state', '=', 'draft')]"/>
        <separator/>
        <filter name="has_stock" string="Со складом на ДВ"
                domain="[('pmk_has_stock', '=', True)]"/>
        <separator/>
        <!-- Ради этого фильтра всё и затевается: кого пора дёрнуть за прайсом. -->
        <filter name="due" string="Пора запросить прайс"
                domain="[('pmk_price_next_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
        <filter name="never" string="Прайса ещё не было"
                domain="[('pmk_price_last_date', '=', False)]"/>

        <group>
          <filter name="by_supply" string="Что возит"
                  context="{'group_by': 'pmk_supply_ids'}"/>
          <filter name="by_state" string="Состояние адреса"
                  context="{'group_by': 'pmk_price_email_state'}"/>
          <filter name="by_mailing" string="В рассылке"
                  context="{'group_by': 'pmk_price_mailing'}"/>
          <filter name="by_city" string="Город" context="{'group_by': 'city'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_price_supplier" model="ir.actions.act_window">
    <field name="name">Поставщики прайсов</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('pmk_price_supplier', '=', True)]</field>
    <!-- Открывается сразу сгруппированным по тому, что поставщик возит:
         снабженцу нужен не общий список, а «кто у нас по метизам». Поставщик
         с несколькими группами попадёт в каждую — так и надо. -->
    <field name="context">{'default_pmk_price_supplier': True, 'default_is_company': True, 'res_partner_search_mode': 'supplier', 'search_default_by_supply': 1}</field>
    <field name="search_view_id" ref="view_price_supplier_search"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Поставщиков ещё нет</p>
      <p>Здесь живут те, у кого мы регулярно спрашиваем цены: что возит,
         на какой адрес писать и когда прайс приходил в последний раз.</p>
    </field>
  </record>

  <record id="action_price_supplier_list_binding" model="ir.actions.act_window.view">
    <field name="sequence">1</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_price_supplier_list"/>
    <field name="act_window_id" ref="action_price_supplier"/>
  </record>
  <record id="action_price_supplier_form_binding" model="ir.actions.act_window.view">
    <field name="sequence">2</field>
    <field name="view_mode">form</field>
    <field name="act_window_id" ref="action_price_supplier"/>
  </record>
  <!--
    Поиск «Клиентов» и «Поставщиков» — разбор UX, шаг 9 (Антон, 28.09.2026:
    «вернуть „Клиентам“ штатный поиск с фильтрами „Клиенты“ и „Компании“ —
    согласен, а у поставщиков в закупках соответственно поставщики и
    компании»).

    «КЛИЕНТЫ» — СВОЙ ФИЛЬТР. Штатный «Клиенты» (customer_rank > 0) растёт от
    заказов и счетов в Odoo, а продажи у завода в МоёмСкладе: таких
    контрагентов 0, список был бы пустым. Клиент завода — тот, кто НЕ
    поставщик (ни по штатному признаку, ни в реестре прайсов), НЕ
    пользователь системы и НЕ наша собственная компания (ИП Чулков — это
    res.company). Штатный фильтр прячем, чтобы в меню не было двух
    «Клиентов»; по имени он остаётся доступен контекстам ядра.

    «ПОСТАВЩИКИ» — штатный фильтр плюс реестр прайсов: поставщик, заведённый
    из «Поставщиков прайсов», штатного признака ещё не имеет.
  -->
  <record id="view_partner_search_pmk_customers" model="ir.ui.view">
    <field name="name">res.partner.search.pmk.customers</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_res_partner_filter"/>
    <field name="arch" type="xml">
      <xpath expr="//filter[@name='customer']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//filter[@name='customer']" position="before">
        <filter string="Клиенты" name="pmk_customers"
                domain="[('supplier_rank', '=', 0), ('pmk_price_supplier', '=', False), ('user_ids', '=', False), ('ref_company_ids', '=', False)]"/>
      </xpath>
      <!-- Подпись «Поставщики»: перевод ядра подписывал фильтр «Счета
           поставщиков», хотя он отбирает контрагентов, а не счета. -->
      <xpath expr="//filter[@name='supplier']" position="attributes">
        <attribute name="string">Поставщики</attribute>
        <attribute name="domain">['|', ('supplier_rank', '&gt;', 0), ('pmk_price_supplier', '=', True)]</attribute>
      </xpath>
    </field>
  </record>

  <!-- Меню «Продажи → Клиенты» и «Закупки → Поставщики» открывают эти
       штатные действия. По умолчанию: «Клиенты» + «Компании» и
       «Поставщики» + «Компании» — контактные лица видны в карточке своей
       компании. Остальное контекста — как в ядре. -->
  <record id="account.res_partner_action_customer" model="ir.actions.act_window">
    <field name="context">{'search_default_pmk_customers': 1, 'search_default_type_company': 1, 'res_partner_search_mode': 'customer', 'default_is_company': True, 'default_customer_rank': 1}</field>
  </record>
  <record id="account.res_partner_action_supplier" model="ir.actions.act_window">
    <field name="context">{'search_default_supplier': 1, 'search_default_type_company': 1, 'res_partner_search_mode': 'supplier', 'default_is_company': True, 'default_supplier_rank': 1}</field>
  </record>

</odoo>
