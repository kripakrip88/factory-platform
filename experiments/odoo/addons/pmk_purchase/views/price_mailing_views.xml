<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="view_price_mailing_form" model="ir.ui.view">
    <field name="name">pmk.price.mailing.form</field>
    <field name="model">pmk.price.mailing</field>
    <field name="arch" type="xml">
      <!--
        Разбор UX, шаг 28 (01.10.2026):
        • create/delete/duplicate="0" — запись у рассылки одна (action_open
          создаёт её при первом заходе), «Новое» вело к второй, ни на что не
          влияющей копии окна;
        • класс o_pmk_labels_line у групп — подписи в одну строку (шесть
          длинных подписей ломались надвое; forms_nexus.scss, раздел 8);
        • «Час» и «Минута» → одно «Время» 09:10 (send_time, float_time);
        • «Открыть очередь» — в одной строке с числом, а не отдельной
          ячейкой под ним, где ссылка переносилась на две строки;
        • залитая кнопка одна — «Запустить рассылку сейчас»: «Выбрать
          получателей» контурная (правило «одна залитая кнопка на экран»).
      -->
      <form string="Рассылка прайсов" class="pmk-form" create="0" delete="0" duplicate="0">
        <sheet>
          <div class="oe_title">
            <h1>Рассылка запросов прайсов</h1>
          </div>

          <!-- Предупреждения вперёд всего: человек должен видеть, почему
               рассылка не работает, до того как нажмёт «Запустить». -->
          <div class="alert alert-warning" role="alert" invisible="server_ready">
            Почтовый сервер не настроен — отправлять нечем.
          </div>
          <div class="alert alert-info" role="alert" invisible="enabled">
            Рассылка выключена. Задание просыпается по расписанию и ничего не отправляет.
          </div>
          <div class="alert alert-warning" role="alert"
               invisible="not enabled or recipient_count > 0">
            Рассылка включена, но получателей ноль — письма никуда не уйдут.
            Отметьте поставщиков в списке.
          </div>

          <group class="o_pmk_labels_line">
            <group string="Когда">
              <field name="weekday"/>
              <!-- Одно поле вместо «Час» и «Минута»; сами час и минута
                   остались в модели — из них собирается расписание
                   задания (models/price_mailing.py). -->
              <field name="send_time" widget="float_time"/>
              <field name="next_run" readonly="1"/>
              <field name="last_run" readonly="1"/>
            </group>
            <group string="Кому">
              <field name="recipient_count" readonly="1"/>
              <field name="supplier_count" readonly="1"/>
              <div colspan="2" class="text-muted small mb-2">
                В списке поставщиков отметьте нужных галочкой слева и нажмите
                сверху «Включить в рассылку». Или щёлкните переключатель
                в колонке «В рассылке» у одной строки.
              </div>
              <div colspan="2">
                <!-- Две разные кнопки намеренно. Раньше была одна, и она
                     открывала список, отфильтрованный по тем, кто УЖЕ в
                     рассылке — то есть пустой. Добавлять было негде. -->
                <button name="action_choose_recipients" type="object"
                        string="Выбрать получателей" class="btn-secondary"/>
                <button name="action_open_recipients" type="object"
                        string="Кто уже в рассылке" class="btn-secondary ms-2"/>
              </div>
            </group>
          </group>

          <group class="o_pmk_labels_line">
            <group string="Рубильник">
              <field name="enabled" widget="boolean_toggle"/>
              <field name="max_per_run"/>
              <field name="server_ready" readonly="1"/>
            </group>
            <group string="Очередь">
              <!-- Число и переход — одной строкой: подпись отдельным узлом,
                   значение и кнопка в o_row (как «ИНН» и «Заполнить по
                   ИНН» в карточке контрагента). Отдельной ячейкой группы
                   кнопка уходила на строку ниже, в узкую колонку подписей,
                   и «Открыть очередь» переносилась на две строки. -->
              <label for="queue_count"/>
              <div class="o_row">
                <field name="queue_count" readonly="1" class="oe_inline pmk-row-value"/>
                <button name="action_open_queue" type="object"
                        string="Открыть очередь" class="btn-link text-nowrap"
                        icon="fa-arrow-right"/>
              </div>
            </group>
          </group>

          <group string="Проверка и запуск" class="o_pmk_labels_line">
            <field name="test_email" placeholder="ваш@адрес.ру"/>
            <div colspan="2">
              <button name="action_send_test" type="object"
                      string="Отправить пробное письмо" class="btn-secondary"/>
              <button name="action_run_now" type="object"
                      string="Запустить рассылку сейчас" class="btn-primary ms-2"
                      confirm="Письма уйдут всем, кто отмечен в рассылке и кому давно не писали. Продолжить?"/>
            </div>
          </group>

          <notebook>
            <page string="Текст письма" name="letter">
              <group>
                <field name="subject"/>
              </group>
              <div class="text-muted small mb-2">
                Выделите текст мышью — появится панель форматирования: жирный,
                курсив, размер, списки, ссылки.
              </div>
              <!-- widget="html_mail" — тот же, которым Odoo правит собственные
                   шаблоны писем (mail.email_template_form). Обычный "html"
                   давал редактор без панели форматирования. -->
              <field name="body_html" widget="html_mail" nolabel="1"
                     class="oe-bordered-editor"
                     options="{'codeview': true}"
                     placeholder="Текст письма поставщику…"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Записи у модели одна, поэтому меню ведёт не на список, а сразу в форму:
       открывать список из одной строки — лишний клик каждый раз.

       path — разбор UX, шаг 23 (01.10.2026). Серверное действие возвращает
       окно без номера (action_open), и без path в адресе не было действия
       вовсе: /odoo/pmk.price.mailing/1. Отсюда три беды: пункт «Рассылка
       прайсов» не подсвечивался в строке разделов, обновление страницы
       открывало голую запись модели, а строка пути после перехода дальше
       не восстанавливалась («A server action must have a path to be
       restored», web/controllers/action.py). С path ядро само передаёт его
       окну (action_service.js, _executeServerAction), адрес становится
       /odoo/price-mailing/1, пункт меню получает actionPath. Старые
       закладки /odoo/pmk.price.mailing/1 по-прежнему открывают форму.
       Путь уникален среди всех действий (ограничение _check_path ядра). -->
  <record id="action_price_mailing" model="ir.actions.server">
    <field name="name">Рассылка прайсов</field>
    <field name="model_id" ref="model_pmk_price_mailing"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open()</field>
    <field name="path">price-mailing</field>
  </record>

</odoo>
