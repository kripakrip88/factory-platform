<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_supply_category_list" model="ir.ui.view">
    <field name="name">pmk.supply.category.list</field>
    <field name="model">pmk.supply.category</field>
    <field name="arch" type="xml">
      <list string="Группы поставки" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="note"/>
      </list>
    </field>
  </record>

  <record id="action_supply_category" model="ir.actions.act_window">
    <field name="name">Группы поставки</field>
    <field name="res_model">pmk.supply.category</field>
    <field name="view_mode">list</field>
  </record>
</odoo>
