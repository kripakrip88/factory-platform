<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--
    Заголовок над номером закупки: «Запрос КП» вместо «Запрос на
    коммерческое предложение», кнопка «Отправить запрос КП» вместо
    «Отправить запрос котировок» (Антон, 28.09.2026). Статусы, меню и название
    списка переименованы миграцией migrations/19.0.1.0.1.

    С шага З-6 (09.10.2026, слова заказа поставщику): над номером —
    «Заявка поставщику», кнопки — «Отправить заявку поставщику» (как у
    «Заявки на металл» pmk_tech), стадии — «Заявка» / «Заявка отправлена»
    (файл слов pmk_theme, i18n_words/purchase.po).
    ⚠️ Атрибуты span не менять: по invisible его находит xpath pmk_tech
    («Заявка на металл» у заявок из технического расчёта).

    ⚠️ XPATH ПО АТРИБУТУ, А НЕ ПО ТЕКСТУ: разметка вида хранится переведённой,
    в русской версии «Request for Quotation» уже не найти.
  -->
  <record id="purchase_order_form_rfq_label" model="ir.ui.view">
    <field name="name">purchase.order.form.rfq.label</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//span[hasclass('o_form_label')][@invisible=&quot;state not in ('draft', 'sent')&quot;]" position="replace">
        <span class="o_form_label" invisible="state not in ('draft', 'sent')">Заявка поставщику </span>
      </xpath>
      <!-- «Отправить заявку поставщику» (до шага З-6 — «Отправить запрос
           КП») вместо «Отправить запрос котировок»: две кнопки ядра — у
           черновика и у уже отправленной заявки. -->
      <xpath expr="//button[@name='action_rfq_send'][@invisible=&quot;state != 'draft'&quot;]" position="attributes">
        <attribute name="string">Отправить заявку поставщику</attribute>
      </xpath>
      <xpath expr="//button[@name='action_rfq_send'][@invisible=&quot;state != 'sent'&quot;]" position="attributes">
        <attribute name="string">Отправить заявку поставщику</attribute>
      </xpath>
    </field>
  </record>

  <!--
    Список «Запросы КП» — «оживить таблицы» (29.09.2026).
    • Строка черновика и отправленного запроса целиком была голубой (ядро:
      decoration-info на list) — вся таблица синела. Статус видно плашкой.
    • Цвет плашки — как тон кнопки стадий закупки: «Заявка» серый (начало
      пути), «Заявка отправлена» голубой, «К согласованию» жёлтый (вне
      пути, ждёт решения), «Заказ поставщику» зелёный, отменён — розовый
      (слова стадий — с шага З-6).
      Условия взаимоисключающие: плашка берёт первое сработавшее по порядку
      атрибутов, а переопределённые атрибуты ядра стоят раньше новых.
  -->
  <record id="purchase_order_kpis_tree_tones" model="ir.ui.view">
    <field name="name">purchase.order.kpis.list.pmk.tones</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//list" position="attributes">
        <attribute name="decoration-info"/>
      </xpath>
      <!-- «Справка» — перевод Reference: это номер запроса (29.09.2026). -->
      <xpath expr="//field[@name='name']" position="attributes">
        <attribute name="string">Номер</attribute>
      </xpath>
      <xpath expr="//field[@name='state']" position="attributes">
        <attribute name="decoration-success">state == 'purchase'</attribute>
        <attribute name="decoration-warning">state == 'to approve'</attribute>
        <attribute name="decoration-info">state == 'sent'</attribute>
        <attribute name="decoration-muted">state == 'draft'</attribute>
        <attribute name="decoration-danger">state == 'cancel'</attribute>
      </xpath>
      <!-- Разбор UX, шаг 25: звезда «Приоритет» и «Активность» — в меню
           колонок (⚙). Звёзд никто не ставит (приоритет запроса КП в «Убрать
           совсем» разбора), задач по закупкам нет; колонка задач вернётся
           вместе с задачами. Обратимо: снять optional или включить в ⚙. -->
      <xpath expr="//field[@name='priority']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      <xpath expr="//field[@name='activity_ids']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
    </field>
  </record>

  <!--
    Список «Заказы поставщикам» — разбор UX, шаг 25 (01.10.2026). Тот же
    порядок, что у «Запросов КП» выше:
    • строка «к выставлению счёта» больше не голубая (decoration-info на
      list), колонка «Выставление счетов» и кнопка «Создать счета» над
      выбранными скрыты: счета поставщиков ведутся в МоёмСкладе, в Odoo их
      нет. Колонка — в меню колонок (⚙), кнопка — invisible (узел на месте);
    • звезда «Приоритет» и «Активность» — в меню колонок, как у запросов;
    • «Номер» вместо «Справка» (перевод Reference).
    Когда счета переедут в Odoo («Деньги»), вернуть: снять invisible у
    кнопки, optional у колонки и вернуть decoration-info
    (docs/disabled-features.md).
    Вид purchase_stock ставит «Приёмку» перед колонкой счетов — правки здесь
    только в атрибутах, его xpath не страдает.
    С шага З-6 (09.10.2026) колонки «Статус выставления счетов» и «Статус
    получения» убраны и из ⚙ — до групп «Убранное» / «Деньги (показать)» /
    «Склад (показать)» (pmk_theme, models/hidden_nodes.py, STEP_Z6_NODES).
  -->
  <record id="purchase_order_view_tree_pmk" model="ir.ui.view">
    <field name="name">purchase.order.list.pmk.columns</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//list" position="attributes">
        <attribute name="decoration-info"/>
      </xpath>
      <xpath expr="//header/button[@name='action_create_invoice']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='name']" position="attributes">
        <attribute name="string">Номер</attribute>
      </xpath>
      <xpath expr="//field[@name='priority']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      <xpath expr="//field[@name='activity_ids']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
      <xpath expr="//field[@name='invoice_status']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
    </field>
  </record>
</odoo>
