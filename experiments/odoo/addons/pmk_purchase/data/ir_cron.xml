<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data noupdate="1">

    <!--
      Расписание: раз в неделю. Конкретное время (понедельник 09:10 по
      Владивостоку) выставляется в post_init_hook — nextcall хранится в UTC,
      и записывать сюда готовую дату значит зашить разницу часовых поясов
      в исходник, где её никто не увидит.

      noupdate="1" намеренно: при обновлении модуля расписание и состояние
      «активно» не должны сбрасываться на заводские.
    -->
    <record id="cron_price_request" model="ir.cron">
      <field name="name">ПМК: запрос прайсов у поставщиков</field>
      <field name="model_id" ref="base.model_res_partner"/>
      <field name="state">code</field>
      <field name="code">model._cron_send_price_requests()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">weeks</field>
      <field name="active" eval="True"/>
    </record>

    <!--
      Рубильник. Задание активно и по расписанию просыпается, но пока здесь
      не '1' — не отправляет ничего и пишет об этом в лог. Сделано так, чтобы
      включение рассылки было отдельным осознанным действием, а не побочным
      эффектом установки модуля.
    -->
    <record id="param_price_request_enabled" model="ir.config_parameter">
      <field name="key">pmk.price_request.enabled</field>
      <field name="value">0</field>
    </record>

    <!-- Потолок писем за один прогон. Остальные подождут следующего. -->
    <record id="param_price_request_max" model="ir.config_parameter">
      <field name="key">pmk.price_request.max_per_run</field>
      <field name="value">30</field>
    </record>

  </data>
</odoo>
