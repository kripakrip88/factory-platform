<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Служебный товар строк счёта из МоегоСклада: номенклатуру МоегоСклада не переносим
       (решение Антона 12.10.2026), название строки — текст. Не продаётся из Odoo. -->
  <record id="product_ms_line" model="product.product">
    <field name="name">Позиция из МоегоСклада</field>
    <field name="type">service</field>
    <field name="sale_ok" eval="False"/>
    <field name="purchase_ok" eval="False"/>
    <field name="list_price">0</field>
    <field name="default_code">МС-ПОЗИЦИЯ</field>
  </record>

  <record id="partner_tag_ms" model="res.partner.category">
    <field name="name">Из МоегоСклада</field>
  </record>

  <!-- Раз в 10 минут: что изменилось в МоёмСкладе с прошлого раза. Первый перенос
       «за всё время» — из shell (sync_all(full=True)), до него крон молчит. -->
  <record id="cron_sync" model="ir.cron">
    <field name="name">МойСклад → Odoo: синхронизация</field>
    <field name="model_id" ref="model_pmk_moysklad"/>
    <field name="state">code</field>
    <field name="code">model._cron_sync()</field>
    <field name="interval_number">10</field>
    <field name="interval_type">minutes</field>
    <field name="active" eval="True"/>
  </record>
</odoo>
