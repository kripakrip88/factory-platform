<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Служебный товар строк счёта из МоегоСклада: номенклатуру МоегоСклада не переносим
       (решение Антона 12.10.2026), название строки — текст. Не продаётся из Odoo. -->
  <record id="product_ms_line" model="product.product">
    <field name="name">Позиция из МоегоСклада</field>
    <field name="type">service</field>
    <field name="sale_ok" eval="False"/>
    <field name="purchase_ok" eval="False"/>
    <field name="list_price">0</field>
    <field name="default_code">МС-ПОЗИЦИЯ</field>
  </record>

  <record id="partner_tag_ms" model="res.partner.category">
    <field name="name">Из МоегоСклада</field>
  </record>

  <!-- Раз в 10 минут: что изменилось в МоёмСкладе с прошлого раза. Первый перенос
       «за всё время» — из shell (sync_all(full=True)), до него крон молчит. -->
  <record id="cron_sync" model="ir.cron">
    <field name="name">МойСклад → Odoo: синхронизация</field>
    <field name="model_id" ref="model_pmk_moysklad"/>
    <field name="state">code</field>
    <field name="code">model._cron_sync()</field>
    <field name="interval_number">10</field>
    <field name="interval_type">minutes</field>
    <field name="active" eval="True"/>
  </record>
  <!-- Раз в день в 9:00 по Хабаровску (23:00 UTC): «оплачено, а отгрузки нет» —
       Телеграм Владиславу Чулкову (21.10.2026, models/ship_watch.py). -->
  <record id="cron_ship_watch" model="ir.cron">
    <field name="name">МойСклад: оплачено, а отгрузки нет — Телеграм</field>
    <field name="model_id" ref="model_pmk_moysklad"/>
    <field name="state">code</field>
    <field name="code">model._cron_ship_watch()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 23:00:00') if DateTime.now().hour &gt;= 23 else DateTime.now().strftime('%Y-%m-%d 23:00:00')"/>
    <field name="active" eval="True"/>
  </record>
  <!-- Счёт Odoo → МойСклад (этап 6, 22.10.2026, models/export.py): очередь раз в 2 минуты.
       Режим — системный параметр pmk_moysklad.export_mode (off / dry / live), без него — ничего. -->
  <record id="cron_ms_export" model="ir.cron">
    <field name="name">Odoo → МойСклад: выгрузка счетов</field>
    <field name="model_id" ref="sale.model_sale_order"/>
    <field name="state">code</field>
    <field name="code">model._cron_ms_export()</field>
    <field name="interval_number">2</field>
    <field name="interval_type">minutes</field>
    <field name="active" eval="True"/>
  </record>
</odoo>
