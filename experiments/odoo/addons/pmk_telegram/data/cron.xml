<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Досылка очереди сообщений в Телеграм раз в 2 минуты (models/outbox.py).
         Выключить — active = False. -->
    <record id="cron_pmk_telegram_outbox" model="ir.cron">
        <field name="name">Телеграм: дослать очередь</field>
        <field name="model_id" ref="model_pmk_telegram_outbox"/>
        <field name="state">code</field>
        <field name="code">model._cron_flush()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
